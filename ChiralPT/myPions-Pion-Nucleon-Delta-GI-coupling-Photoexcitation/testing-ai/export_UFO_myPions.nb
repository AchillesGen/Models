Cell[BoxData[
 RowBox[{
  RowBox[{"verticesTableStyle", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Proton", "->", "\"\<p\>\""}], ",", 
     RowBox[{
     "Protonbar", "->", "\"\<\!\(\*OverscriptBox[\(p\), \(_\)]\)\>\""}], ",", 
     RowBox[{"Neutron", "->", "\"\<n\>\""}], ",", 
     RowBox[{
     "Neutronbar", "->", "\"\<\!\(\*OverscriptBox[\(n\), \(_\)]\)\>\""}], ",", 
     RowBox[{
     "Pi0", "->", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(0\)]\)\>\""}], ",", 
     RowBox[{
     "PiP", "->", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(+\)]\)\>\""}], ",", 
     RowBox[{
     "PiPbar", "->", "\"\<\!\(\*SuperscriptBox[\(\[Pi]\), \(-\)]\)\>\""}], ",", 
     RowBox[{
     "DeltaM", 
      "->", "\"\<\!\(\*SuperscriptBox[\(\[CapitalDelta]\), \(-\)]\)\>\""}], ",", 
     RowBox[{
     "Delta0", 
      "->", "\"\<\!\(\*SuperscriptBox[\(\[CapitalDelta]\), \(0\)]\)\>\""}], ",", 
     RowBox[{
     "DeltaP", 
      "->", "\"\<\!\(\*SuperscriptBox[\(\[CapitalDelta]\), \(+\)]\)\>\""}], ",", 
     RowBox[{
     "DeltaPP", 
      "->", "\"\<\!\(\*SuperscriptBox[\(\[CapitalDelta]\), \(++\)]\)\>\""}], ",", 
     RowBox[{
     "DeltaMbar", 
      "->", "\"\<\!\(\*OverscriptBox[SuperscriptBox[\(\[CapitalDelta]\), \
\(-\)], \(_\)]\)\>\""}], ",", 
     RowBox[{
     "Delta0bar", 
      "->", "\"\<\!\(\*OverscriptBox[SuperscriptBox[\(\[CapitalDelta]\), \
\(0\)], \(_\)]\)\>\""}], ",", 
     RowBox[{
     "DeltaPbar", 
      "->", "\"\<\!\(\*OverscriptBox[SuperscriptBox[\(\[CapitalDelta]\), \
\(+\)], \(_\)]\)\>\""}], ",", 
     RowBox[{
     "DeltaPPbar", 
      "->", "\"\<\!\(\*OverscriptBox[SuperscriptBox[\(\[CapitalDelta]\), \(++\
\)], \(_\)]\)\>\""}], ",", 
     RowBox[{"fPi", "->", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(f\), \(\[Pi]\)]\)\>\"", ",", 
        RowBox[{"Darker", "@", "Red"}]}], "]"}]}], ",", 
     RowBox[{"MPi", "->", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(m\), \(\[Pi]\)]\)\>\"", ",", 
        RowBox[{"Darker", "@", "Green"}]}], "]"}]}], ",", 
     RowBox[{"W", "->", "\"\<\!\(\*SuperscriptBox[\(W\), \(+\)]\)\>\""}], ",", 
     RowBox[{"Wbar", "->", "\"\<\!\(\*SuperscriptBox[\(W\), \(-\)]\)\>\""}]}],
     "}"}]}], ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"41a75dd1-96f1-ca4b-b317-4ab7e6d82778"],

