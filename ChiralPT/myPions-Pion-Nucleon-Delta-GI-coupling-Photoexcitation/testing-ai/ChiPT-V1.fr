  },
  g1D == {
    ParameterType    -> External,
    BlockName        -> CHIPTDELTA,
    OrderBlock       -> 3,
    Value            -> 1,
    InteractionOrder -> {QED, 0},
    Description      -> "pi-Delta-Delta coupling."
  },
  (* ------------- THE DELTA COUPLINGS ARE DEFINED BY THE MEASURED WIDTHS ------ *)
  (*  V10.  hD, G1 and G2 are no longer inputs -- the two DECAY WIDTHS are, and   *)
  (*  the couplings are derived from them.  The point is that the calibration     *)
  (*  then follows M_Delta automatically: change MDelta in the param card and the *)
  (*  couplings re-derive themselves instead of silently going stale.  In V9 they *)
  (*  were hand-set numbers calibrated at M_Delta = 1.209, and moving to the PDG  *)
  (*  1.232 quietly left Gamma(N pi) at 128 MeV against the measured 117.         *)
  (*                                                                              *)
  (*  BOTH INVERSIONS ARE EXACT, not fits.  Verified against the generated vertex *)
  (*  to 6-8 digits over M_Delta = 1.05 ... 1.50 (see the derivation in the        *)
  (*  session notes; the checks are tools/adler_ndelta.py's companion width code): *)
  (*                                                                              *)
  (*      Gamma(Delta -> N pi)  = hD^2 k^3 (E_N + M_N) / (12 pi fPi^2 M_Delta)     *)
  (*                                                                              *)
  (*      Gamma(Delta -> N gam) = ee^2 kg^3 / (8 pi M_N^2)                         *)
  (*                              x (G1^2 + x G1 G2 + x^2 G2^2),                   *)
  (*                              x = kg / (E_N + M_N)                             *)
  (*                                                                              *)
  (*  One width cannot fix two photon couplings, so the E2/M1 ratio G2/G1 is the   *)
  (*  third input.  Its default is V9's value, which is not arbitrary: it gives    *)
  (*  E2/M1 = -2.45% against the measured EMR of about -2.5%, and reproduces the   *)
  (*  helicity ratio |A_3/2|/|A_1/2| = 1.9152.                                     *)
  (*                                                                              *)
  (*  WHAT THIS COSTS.  The Fig. 33 photoproduction fit constrains the PRODUCT     *)
  (*  g*h, and the two widths constrain g and h separately.  They do not agree at  *)
  (*  M_Delta = 1.209 -- g*h moves by 1.198, i.e. photoproduction by ~43% -- but   *)
  (*  they very nearly do at the PDG mass, where g*h moves by only 0.931.  That is *)
  (*  a real result of this reparameterisation, not a defect of it: the model's    *)
  (*  low Delta mass was what made the widths and the photoproduction fit          *)
  (*  incompatible.                                                                *)
  (*                                                                              *)
  (* ---------------- POLE PARAMETRISATION THROUGHOUT (2026-08-27) -------------- *)
  (*  These two widths used to be the BREIT-WIGNER numbers, Gamma(N pi) = 117 MeV  *)
  (*  and Gamma(N gamma) = 0.66 MeV, both quoted at the BREIT-WIGNER mass 1.232,   *)
  (*  while MDelta and the propagator width WDelta* were the POLE values 1.209 and *)
  (*  0.102 (PDG pole position 1210 - 50i MeV).  One resonance was therefore being *)
  (*  described by two parametrisations at once, and since V10 makes Gamma(N pi)   *)
  (*  DEFINE hD, the headline "C5A predicted from the measured width" inherited    *)
  (*  the mismatch: it read 1.365 only because a 1.232-GeV width was being used at *)
  (*  a 1.209-GeV mass.                                                            *)
  (*                                                                              *)
  (*  Both are now POLE values, obtained by scaling the Breit-Wigner partial       *)
  (*  widths to the pole total width at FIXED BRANCHING RATIO:                     *)
  (*                                                                              *)
  (*      f = 0.102 / (0.117 + 0.00066) = 0.86690464                               *)
  (*      Gamma(N pi)   = 0.117   * f = 0.1014278                                  *)
  (*      Gamma(N gam)  = 0.00066 * f = 0.0005722                                  *)
  (*      sum           = 0.102          = WDelta*, exactly                        *)
  (*                                                                              *)
  (*  The branching ratio BR(N gamma) = 0.560938% is preserved to all digits; it   *)
  (*  is the better-measured quantity of the two, so it is what is held fixed.     *)
  (*                                                                              *)
  (*  TWO THINGS THIS FIXES BEYOND THE CONVENTION.  First, the sum of the partial  *)
  (*  widths now EQUALS the propagator width, so the resonance's elasticity is 1   *)
  (*  by construction rather than by accident -- before, the vertex delivered      *)
  (*  117.66 MeV through a propagator built for 102, a 15% mismatch.  Second, the  *)
  (*  UFO's WDelta* external and the DECAY block that make_param_cards.py writes   *)
  (*  now carry the SAME number, so wprod_from_ufo.py (which reads WDeltaP) and    *)
  (*  Sherpa (which reads the DECAY block) no longer disagree by 17%.              *)
  (*                                                                              *)
  (*  hD and G1,G2 all scale as sqrt(f) = 0.931077, so                             *)
  (*      hD     1.672161 -> 1.556911                                              *)
  (*      C5A(0) 1.365    -> 1.271   (= sqrt(2/3) hD)                              *)
  (*  and the photoproduction product g*h is UNCHANGED to the extent that both     *)
  (*  scale together -- g*h moves by sqrt(f)^2 = f, which is the honest price of   *)
  (*  the convention and is quantified in the Fig. 33 rerun.                       *)
  GamNPi == {
    ParameterType    -> External,
    BlockName        -> CHIPTDELTA,
    OrderBlock       -> 4,
    Value            -> 0.1014278,
    InteractionOrder -> {QED, 0},
    Description      -> "Gamma(Delta -> N pi) in GeV at the POLE (PDG pole width 102 MeV, branching ratio preserved).  DEFINES hD -- see the note above.  The channel is Delta++ -> p pi+."
  },
  GamNGam == {
    ParameterType    -> External,
    BlockName        -> CHIPTDELTA,
    OrderBlock       -> 5,
    Value            -> 0.0005722,
    InteractionOrder -> {QED, 0},
