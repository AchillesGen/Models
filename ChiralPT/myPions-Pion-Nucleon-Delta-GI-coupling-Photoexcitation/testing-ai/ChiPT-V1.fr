  (* Internal Parameters *)

  MPi == {
    ParameterType    -> Internal,
    Value            -> MPi0,
    Description      -> "Isospin-symmetric pion mass used in the chiral mass matrix ChiMat.  The physical pi0 / pi+ propagator masses are MPi0 / MPiP.  Set this to MPiP for the more common chiral convention."
  },
  g2D == {
