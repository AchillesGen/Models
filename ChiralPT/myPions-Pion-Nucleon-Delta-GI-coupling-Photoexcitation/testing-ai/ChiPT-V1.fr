  },
  g3D == {
    ParameterType    -> Internal,
    Value            -> -((1 + 2*AD + 3*AD^2)/2)*g1D,
    InteractionOrder -> {QED, 0},
    Description      -> "pi-Delta-Delta off-shell coupling, -(1+2AD+3AD^2)/2 g1D.  Strong: no QED order."
  },
  (* --------- Delta couplings derived from the widths, V10.  See the note ----- *)
  (* --------- at GamNPi.  InteractionOrder is left at {QED, 0} for all three:   *)
  (* --------- the photon order of the gamma-N-Delta vertex is carried by        *)
  (* --------- Kappa, exactly as it was when G1 and G2 were external, so the     *)
  (* --------- coupling-order bookkeeping is unchanged.  G1 does contain a 1/ee  *)
  (* --------- which cancels against Kappa's ee in the exported coupling value.  *)
  kPiDelta == {
    ParameterType    -> Internal,
    Value            -> Sqrt[(MDelta^2 - MNucleon^2 - MPiP^2)^2
                             - 4*MPiP^2*MNucleon^2]/(2*MDelta),
    InteractionOrder -> {QED, 0},
    Description      -> "pi-N centre-of-mass momentum at the Delta pole."
  },
  kGamDelta == {
    ParameterType    -> Internal,
    Value            -> (MDelta^2 - MNucleon^2)/(2*MDelta),
    InteractionOrder -> {QED, 0},
    Description      -> "real-photon momentum in the Delta rest frame."
  },
  xEMDelta == {
    ParameterType    -> Internal,
    Value            -> kGamDelta/((MDelta^2 + MNucleon^2)/(2*MDelta) + MNucleon),
    InteractionOrder -> {QED, 0},
    Description      -> "kg/(E_N + M_N), the ratio that weights G2 against G1 in the radiative width."
  },
  hD == {
    ParameterType    -> Internal,
    Value            -> Sqrt[12*Pi*fPi^2*MDelta*GamNPi
                             /(kPiDelta^3*(Sqrt[kPiDelta^2 + MNucleon^2] + MNucleon))],
    InteractionOrder -> {QED, 0},
    Description      -> "Gauge-invariant pi-N-Delta coupling, DERIVED from GamNPi.  Was an external 1.52 in V9."
  },
  G1 == {
    ParameterType    -> Internal,
    Value            -> Sqrt[8*Pi*MNucleon^2*GamNGam
                             /(ee^2*kGamDelta^3
                               *(1 + xEMDelta*G2overG1 + xEMDelta^2*G2overG1^2))],
    InteractionOrder -> {QED, 0},
    Description      -> "Proton photo-excitation vertex, magnetic (dual field strength) term.  DERIVED from GamNGam and G2overG1.  Was an external 3.0305 in V9."
  },
  G2 == {
    ParameterType    -> Internal,
    Value            -> G2overG1*G1,
    InteractionOrder -> {QED, 0},
    Description      -> "Proton photo-excitation vertex, electric (field strength) term.  DERIVED as G2overG1 x G1.  Was an external 1.207 in V9."
  },
  (* ------------------- the two Adler normalisations, TIED TO hD ------------- *)
  (*  Both of these were External numbers through V9, and both were WRONG the    *)
  (*  moment hD moved.  C5A and C3V come from the gauged Pascalutsa coupling and *)
  (*  so carry hD; the C4A and C6A operators have their own constants and do     *)
  (*  not.  So the RATIOS the Adler basis is supposed to satisfy drift with hD,  *)
  (*  and in V10 hD is derived from Gamma(Delta -> N pi), i.e. it moves whenever  *)
  (*  the width or the Delta mass is touched.  Tying them to hD is what makes    *)
  (*  the card's Gamma_NPi a genuinely free input instead of one that silently   *)
  (*  breaks the axial current.                                                  *)
  (*                                                                             *)
  (*  Both constants of proportionality are pure numbers, measured to be         *)
  (*  independent of MDelta over 1.15-1.30 (tools/adler_ndelta.py reports        *)
  (*  C5A(0)/hD = -0.81649658 = -Sqrt[2/3] and C4A(0)/C4AN = +0.71880631 at every *)
  (*  mass tested, to eight digits).                                             *)
  C4AN == {
    ParameterType    -> Internal,
    Value            -> C4AHat*hD,
    InteractionOrder -> {QED, 0},
    Description      -> "Overall normalisation of the Adler C4A = -C5A/4 term, LC4ANDelta.  Unlike the rest of CHIPTFF it IS used inside a vertex.  V7-V9 shipped a bare External 0.215822 which delivered C4A/C5A = -1/8; the ratio is fixed by C4AHat = C4AN/hD instead, so it stays at -1/4 when the width moves hD.  tools/adler_ndelta.py measures it."
  },
  C6AN == {
    ParameterType    -> Internal,
    Value            -> hD,
    InteractionOrder -> {QED, 0},
    Description      -> "Overall normalisation of the Adler C6A term, fixed by demanding that q_mu <Delta|A^mu|N> come out suppressed like mpi^2/(Q^2+mpi^2).  It is EQUAL to hD, and not by accident: C5A carries hD through the gauged coupling while the C6A operator does not.  V7-V9 froze it at the External 1.52 that hD then happened to have.  tools/pcac_delta.py reports the implied value; it agrees with hD to 5e-16."
  },
  Kappa == {
    ParameterType    -> Internal,
    Value            -> 3*ee/(2*MNucleon*(MNucleon+MDelta)),
    InteractionOrder -> {QED, 1},
    Description      -> "Prefactor 3e/(2 M (M + M*)) of the gauge-invariant gamma-N-Delta coupling."
  },
    ztilde == {
    ParameterType    -> Internal,
    Value            -> (3*AD + 1)/2,
    InteractionOrder -> {QED, 0},
    Description      -> "Off-shell parameter of the conventional gD coupling (LPiNDelta, unused)."
  },
  aEW == {
    ParameterType    -> Internal,
    Value            -> 1/aEWM1,
    InteractionOrder -> {QED,2},
    TeX              -> Subscript[\[Alpha], EW],
    Description      -> "Electroweak coupling contant"
  },
  MW == {
    ParameterType -> Internal,
    Value         -> Sqrt[MZ^2/2+Sqrt[MZ^4/4-Pi/Sqrt[2]*aEW/Gf*MZ^2]],
    TeX           -> Subscript[M,W],
    Description   -> "W mass"
  },
  sw2 == {
    ParameterType -> Internal,
    Value         -> 1-(MW/MZ)^2,
    Description   -> "Squared Sin of the Weinberg angle"
  },
  ee == {
    ParameterType    -> Internal,
    Value            -> Sqrt[4 Pi aEW],
    InteractionOrder -> {QED,1},
    TeX              -> e,
    Description      -> "Electric coupling constant"
  },
  cw == {
    ParameterType -> Internal,
    Value         -> Sqrt[1-sw2],
    TeX           -> Subscript[c,w],
    Description   -> "Cosine of the Weinberg angle"
  },
  sw == {
    ParameterType -> Internal,
    Value         -> Sqrt[sw2],
    TeX           -> Subscript[s,w],
    Description   -> "Sine of the Weinberg angle"
  },
  g2 == {
    ParameterType    -> Internal,
    Definitions      -> {g2->ee/sw},
    InteractionOrder -> {QED,1},
    TeX              -> Subscript[g,w],
    Description      -> "Weak coupling constant at the Z pole"
  },
  g1 == {
    ParameterType    -> Internal,
    Definitions      -> {g1->ee/cw},
    InteractionOrder -> {QED,1},
    TeX              -> Subscript[g,1],
    Description      -> "U(1)Y coupling constant at the Z pole"
  },
  vev == {
    ParameterType    -> Internal,
    Value            -> 2*MW*sw/ee,
    InteractionOrder -> {QED,-1},
    Description      -> "Higgs vacuum expectation value"
  },
  lam == {
    ParameterType    -> Internal,
    Value            -> MH^2/(2*vev^2),
    InteractionOrder -> {QED, 2},
    Description      -> "Higgs quartic coupling"
  },
  muH == {
    ParameterType -> Internal,
    Value         -> Sqrt[vev^2 lam],
    TeX           -> \[Mu],
    Description   -> "Coefficient of the quadratic piece of the Higgs potential"
  },
  yl == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    Definitions      -> {yl[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value            -> {yl[1,1] -> Sqrt[2] yme / vev, yl[2,2] -> Sqrt[2] ymm / vev, yl[3,3] -> Sqrt[2] ymtau / vev},
    InteractionOrder -> {QED, 1},
    ParameterName    -> {yl[1,1] -> ye, yl[2,2] -> ym, yl[3,3] -> ytau},
    TeX              -> Superscript[y, l],
    Description      -> "Lepton Yukawa couplings"
  },
  Vud == {
    ParameterType -> Internal,
    Value         -> Cos[cabi],
    TeX           -> Subscript[V, ud],
    Description   -> "CKM element V_ud = CKM[1,1], pulled out as its own symbol so
                      that LMat can put it on the CHARGED external source only.
                      Every Delta-S = 0 charged hadronic current carries it: the
                      W-N-N vertices, the W-N-N-pi contact terms, the W-N-Delta
                      transition, the W-Delta-Delta couplings and the W-pi-pi
                      vertex all descend from LMat, so one factor here reaches
                      all of them.  It costs |V_ud|^2 = 0.949 on every
                      charged-current RATE, i.e. -5.1%."
  },
(* N. B. : only Cabibbo mixing! *)
  CKM == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Unitary       -> True,
    Value         -> {CKM[1,1] -> Cos[cabi],  CKM[1,2] -> Sin[cabi], CKM[1,3] -> 0,
                      CKM[2,1] -> -Sin[cabi], CKM[2,2] -> Cos[cabi], CKM[2,3] -> 0,
                      CKM[3,1] -> 0,          CKM[3,2] -> 0,         CKM[3,3] -> 1},
    TeX         -> Superscript[V,CKM],
    Description -> "CKM-Matrix"
  }
};


(* ****************************************************************************** *)
(* *****    Chiral building blocks  (Gasser-Leutwyler convention, V2.1)     ***** *)
(* ****************************************************************************** *)
(*  ONE convention for pions, nucleons and Delta:                                 *)
(*        U -> R U L^+ ,      u = U^(1/2) -> R u h^+ = h u L^+                    *)
(*        D_mu U   = d_mu U - i r_mu U + i U l_mu                                 *)
(*        Gamma_mu = 1/2 [ u^+(d_mu - i r_mu) u + u (d_mu - i l_mu) u^+ ]         *)
(*        u_mu     = i   [ u^+(d_mu - i r_mu) u - u (d_mu - i l_mu) u^+ ]         *)
(*  l_mu = LMat[mu], r_mu = RMat[mu]; covariant sources u l u^+ (LMatTilda) and   *)
(*  u^+ r u (RMatTilda).  See header note 2.                                      *)
(* ****************************************************************************** *)

(* fPiOrder counts inverse powers of fPi kept in the LAGRANGIAN (2 = up to
   4-pion and boson-3-pion vertices), not the chiral order. *)
fPiOrder = 2;

getRidOfhigherOrderTerm[expression_] := Normal[Series[expression, {fPi, Infinity, fPiOrder}]];

UU := MatrixExp[ExpandIndices[Sum[I (PauliSigma[ii] Pion[ii])/fPi, {ii, 1, 3}]]];
uu := MatrixPower[UU, 1/2];

(*  U itself must be expanded TWO orders beyond the Lagrangian truncation.
    The 1/fPi^2 terms of (fPi^2/4) Tr[D U (D U)^+ + chi U^+ + U chi^+] need U
    through Phi^4/fPi^4: the cross term dPhi . dPhi^3 for the kinetic part and
    the Phi^4 term for the mass part.  Truncating U at Phi^2 (as before) gave a
    spurious 4-pi0 vertex -2i Sum p_i.p_j/fPi^2 in place of i MPi^2/fPi^2, and
    spurious Z-pi0-pi0-pi0 / W-pi0-pi0-pi+- vertices.

    Written as the explicit Taylor series of exp(i Phi/fPi): identical to the
    old Series[MatrixExp[...]] at equal order, but needs no MatrixExp/Simplify.
    UMat is used by LPionKin, DelU, MassU, DelUSrc and ChiPTPFCross, so the
    Weak build's pion-in-flight counterterm (LPFFF) stays consistent with
    LPionKin automatically.  umat (= u) is untouched.  *)
UMat := Expand[IdentityMatrix[2] +
   Sum[(I/fPi)^n/n! * MatrixPower[PionMat, n], {n, 1, fPiOrder + 2}]];
umat := Simplify[Normal[Series[uu, {fPi, Infinity, fPiOrder}]]];

(* External left/right sources.  l_mu = r_mu = e Q A_mu with Q = (1 + tau3)/2:
   the isovector part gives the pion charges through the commutator, the full Q
   gives the proton/neutron charges through Gamma_mu.  Defined ONCE (header
   note 4). *)
(*  CKM MIXING ON THE CHARGED SOURCE ONLY.  Wi[mu,1] and Wi[mu,2] are the two
    components that carry the physical W: their combination is
        tau^1 Wi_1 + tau^2 Wi_2 = Sqrt[2] ( W tau^+ + Wbar tau^- ),
    the charge-raising and -lowering current, which for Delta-S = 0 comes with
    V_ud.  Wi[mu,3] = cw Z + sw A is the NEUTRAL member of the triplet and must
    NOT be touched -- putting V_ud on the whole sum would rescale every Z and
    photon coupling in the model and break the photoproduction results.  So the
    sum is split at ii = 2.  RMat has no W in it at all and is left alone.  *)
LMat[mu_] := Module[{ii}, g2/2 ExpandIndices[Vud*Sum[PauliMatrix[ii] Wi[mu, ii], {ii, 1, 2}] + PauliMatrix[3] Wi[mu, 3]] + g1/2 ExpandIndices[B[mu] * IdentityMatrix[2]]];
RMat[mu_] := Module[{ii}, g1/2 ExpandIndices[PauliMatrix[3]*B[mu]] + g1/2 ExpandIndices[IdentityMatrix[2] * B[mu]]];

(* D_mu U = d_mu U - i r_mu U + i U l_mu.  This is the form consistent with
   ChiConnect / ChiVielbein below; myPions.fr had the l <-> r swapped version
   active and this one commented out. *)
DelU[mu_] := ExpandIndices[del[UMat, mu] - I RMat[mu].UMat + I UMat.LMat[mu]];

ChiMat := {{MPi^2, 0}, {0, MPi^2}};
MassU := ExpandIndices[ChiMat.HC[UMat] + UMat.HC[ChiMat]];

ChiCommutator[mat_, mu_, nu_] := Module[{}, ExpandIndices[mat[mu].mat[nu] - mat[nu].mat[mu]]];
FSMat[mat_, mu_, nu_]      := Module[{}, ExpandIndices[del[mat[nu], mu] - del[mat[mu], nu] - I ChiCommutator[mat, mu, nu]]];

(*  Chiral connection Gamma_mu and vielbein u_mu, GL form.  They equal the
    nucleon's own combinations exactly, to all orders in Phi:
        I ChiConnect[mu]    == vVec[mu] + (LMatTilda[mu] + RMatTilda[mu])/2
        ChiVielbein[mu] / 2 == aVec[mu] + (RMatTilda[mu] - LMatTilda[mu])/2
    At leading order ChiVielbein -> (r - l) - d_mu Phi/fPi.  With the GL sign on
    every baryon coupling (+ga/2, +hD/MDelta, +g1D/2) the W axial couplings
    come out with the SM sign.
    getRidOfhigherOrderTerm must NOT be applied to these matrices -- see the
    note at LNNVector; it is applied after the isospin trace below. *)
ChiConnect[mu_]  := ChiConnect[mu] = ExpandIndices[(1/2)*(HC[umat] . (del[umat, mu] - I*RMat[mu] . umat) + umat . (del[HC[umat], mu] - I*LMat[mu] . HC[umat]))];
ChiVielbein[mu_] := ChiVielbein[mu] = ExpandIndices[I*(HC[umat] . (del[umat, mu] - I*RMat[mu] . umat) - umat . (del[HC[umat], mu] - I*LMat[mu] . HC[umat]))];

(* Building blocks for the nucleon currents, kept SEPARATE from ChiConnect /
   ChiVielbein on purpose -- see the note above LNNVector.  GL pairing:
   L~ = u l u^+, R~ = u^+ r u.  Through V2.0 these were u^+ l u and u r u^+,
   the L U R^+ pairing. *)
aVec[mu_]      := aVec[mu] = (I/2)*(HC[umat] . del[umat, mu] - umat . del[HC[umat], mu]);
vVec[mu_]      := vVec[mu] = (I/2)*(HC[umat] . del[umat, mu] + umat . del[HC[umat], mu]);
LMatTilda[mu_] := LMatTilda[mu] = Expand[umat . LMat[mu] . HC[umat]];
RMatTilda[mu_] := RMatTilda[mu] = Expand[HC[umat] . RMat[mu] . umat];

(* -------- the rotated sources split into VECTOR and AXIAL, and their --------- *)
(* -------- one-pion pieces, which are what the background CVC terms use ------- *)
(*  CVC does not stop at the nucleon poles.  Gonzalez-Jimenez et al.,            *)
(*  arXiv:1612.05511 Eq. (18): once the isovector nucleon form factors are put   *)
(*  on the NP and CNP diagrams, conservation of the VECTOR CURRENT requires the  *)
(*  same F1V on the pion-in-flight and on the contact term's contribution to     *)
(*  that current,                                                                *)
(*      F_PF(Q^2) = F_CT(Q^2) = F1V(Q^2) = F1p(Q^2) - F1n(Q^2) ,                 *)
(*  while the contact term's contribution to the AXIAL current pairs with the    *)
(*  pion pole and takes rho dominance.  Leaving them point-like breaks the Ward  *)
(*  identity in the background, i.e. exactly the property this model exists to   *)
(*  preserve.                                                                    *)
(*                                                                               *)
(*  WHICH DIRAC STRUCTURE BELONGS TO WHICH CURRENT.  This is the one thing that  *)
(*  is easy to get backwards, and V8 did.  Expanding u = exp(i Phi), Phi =       *)
(*  pi.tau/(2 fPi),                                                              *)
(*      (L~ + R~)/2 = v - i [Phi, a] + O(1/fPi^2)                                *)
(*      (R~ - L~)/2 = a - i [Phi, v] + O(1/fPi^2)                                *)
(*  with v = (r + l)/2 and a = (r - l)/2 the GL vector and axial sources.        *)
(*                                                                               *)
(*    LNNVector -> Nbar gamma^mu N pi   (no gamma5, Weinberg-Tomozawa)           *)
(*        multiplies the AXIAL source a, so it is part of <pi N| A^mu |N>;       *)
(*        it pairs with the pion pole and takes F_rho.                           *)
(*                                                                               *)
(*    LNNAxial  -> Nbar gamma^mu gamma5 N pi  (Kroll-Ruderman)                   *)
(*        multiplies the VECTOR source v, so it is part of <pi N| V^mu |N>;      *)
(*        CVC applies to it and it takes F1V.                                    *)
(*                                                                               *)
(*  The photon settles it independently and with no reference to any paper: for  *)
(*  the photon l = r, hence a = 0, hence there is NO Nbar gamma^mu N pi contact  *)
(*  at all -- and indeed the UFO has none.  The photon's only contact term is    *)
(*  the Kroll-Ruderman gamma^mu gamma5 one, which is exactly the term the        *)
(*  low-energy theorem for charged-pion photoproduction needs in order to close  *)
(*  the electromagnetic Ward identity.  It cannot be anything but vector-current *)
(*  and cannot carry F_rho.                                                      *)
(*                                                                               *)
(*  ALL THREE BOSONS, NOT JUST THE W.  V8 built these from the charged source    *)
(*  alone, so the gamma-pi-pi, Z-pi-pi and the photon and Z contact terms were   *)
(*  left point-like.  For the photon that is exact at Q^2 = 0 and wrong for      *)
(*  electroproduction; for the Z it is wrong everywhere, because the Z-N-N poles *)
(*  already carry FZ1p/FZ1n.  Using the full LMat/RMat here dresses gamma, Z and *)
(*  W in one operator, and the isospin weights come out of the model rather than *)
(*  being written by hand.                                                       *)
(*                                                                               *)
(*  WHY Coefficient AND NOT Series.  Mathematica's Series[expr, {fPi, Infinity,  *)
(*  n}] keeps n+1 terms COUNTING FROM THE LEADING POWER, not powers down to      *)
(*  fPi^-n:                                                                      *)
(*      Series[a/fPi + b/fPi^2, {fPi, Infinity, 0}]  ->  a/fPi   (not 0)         *)
(*  These matrices are split element by element, and the entries that hold the   *)
(*  charged-pion contact term have NO fPi^0 term at all -- their leading power   *)
(*  is 1/fPi.  An order-0 truncation therefore returned the contact term itself, *)
(*  and subtracting it left zero: in V8 the whole tau^3 (charged-pion) half of   *)
(*  the contact counterterm was silently deleted, so W pi+- / Z pi+- / gamma pi- *)
(*  contacts were exported bare while the pi0 ones were dressed.  Extracting the *)
(*  1/fPi coefficient explicitly cannot fail that way.                           *)
LMatTildaV[mu_] := LMatTildaV[mu] = Expand[(1/2)*(LMatTilda[mu] + RMatTilda[mu])];
LMatTildaA[mu_] := LMatTildaA[mu] = Expand[(1/2)*(RMatTilda[mu] - LMatTilda[mu])];
ChiPTOnePion[m_]  := Map[Coefficient[Expand[#], fPi, -1]/fPi &, m, {2}];

(*  ...and split off the Z, which needs a form factor of its own on the pion    *)
(*  side of the background.  WHY.  FZ1p and FZ1n do two jobs at once: they      *)
(*  supply the Q^2 dependence AND they move the nucleon's neutral-current       *)
(*  vector charge from the model's tree-level sin^2(theta_W) (= 1 - MW^2/MZ^2)  *)
(*  to the low-Q value Sw2FF, because 1/2 - 2 sw^2 sits near a zero and is      *)
(*  hypersensitive to it.  The Ward identity for Z N -> pi N' needs the         *)
(*  ISOVECTOR piece of the nucleon current to match the pion side exactly,      *)
(*      g_p FZ1p - g_n FZ1n = F1V (1 - 2 Sw2FF)                                 *)
(*  whereas the model's own Z-pi-pi coupling carries (1 - 2 sw^2_model).  Left  *)
(*  alone the two differ by a CONSTANT 0.908 and the NC background stops        *)
(*  cancelling -- 2-3% of the current, which tools/ward_background.py sees at   *)
(*  once.  FZ1pi = F1V (1 - 2 Sw2FF)/(1 - 2 sw^2_model) is the same kind of     *)
(*  object as FZ1p: the physical combination over the model's own point-like    *)
(*  coupling.  The photon needs no such factor (its charges are 1 and 0 with no *)
(*  mixing angle in them) and neither does the W, which is why only the Z is    *)
(*  split out here.                                                             *)
(*                                                                              *)
(*  Only the VECTOR-current halves take it: the Z-pi-pi vertex, which is pure   *)
(*  vector current, and the Kroll-Ruderman half of the Z contact term.  The     *)
(*  Weinberg-Tomozawa half belongs to the axial current, and the NC axial       *)
(*  current is pure isovector with no sin^2(theta_W) in it at all (FZA = FWA).  *)
ChiPTZOnly[m_, mu_] := Map[Coefficient[Expand[#], Z[Index[Lorentz, mu]]]*
                             Z[Index[Lorentz, mu]] &, m, {2}];
ChiPTNoZ[m_, mu_]   := Map[Expand[#] - Coefficient[Expand[#], Z[Index[Lorentz, mu]]]*
                             Z[Index[Lorentz, mu]] &, m, {2}];
SrcTildaV1[mu_]   := SrcTildaV1[mu] = ChiPTOnePion[LMatTildaV[mu]];
SrcTildaA1[mu_]   := SrcTildaA1[mu] = ChiPTOnePion[LMatTildaA[mu]];

(*  The SOURCE part of the pion covariant derivative, for the pion-in-flight     *)
(*  vertex.  DelU = del U - i r U + i U l, so the source piece is the last two   *)
(*  terms, and Tr[DelU DelU^+] contains the boson-pi-pi vertex through the cross *)
(*  term with del U.  DelUSrc is that piece alone -- for gamma, Z and W, which   *)
(*  is what makes V_5 (gamma pi pi) and V_91 (Z pi pi) pick up FW1 as well.      *)
(*  The source-SQUARED terms (the two-boson seagulls V V pi pi) are deliberately *)
(*  not included: they do not enter single-pion production with one current.     *)
DelUSrc[mu_] := ExpandIndices[-I*RMat[mu] . UMat + I*UMat . LMat[mu]];

ChiConnectV[mu_, l_]        := ChiConnectV[mu, l] = getRidOfhigherOrderTerm[(1/2)*Tr[ChiConnect[mu] . PauliMatrix[l]]];
ChiVielbein2[mu_, r1_, r2_] := ChiVielbein2[mu, r1, r2] = getRidOfhigherOrderTerm[ChiVielbein[mu][[r1, r2]]];
ChiVielbeinV[mu_, l_]       := ChiVielbeinV[mu, l] = getRidOfhigherOrderTerm[(1/2)*Tr[PauliSigma[l] . ChiVielbein[mu]]];

(*  The vielbein split into its pion part and its EXTERNAL-SOURCE part, needed so
    that the weak N -> Delta transition can be given its own C5A(Q^2) while the
    strong pi-N-Delta vertex is left alone.

    ChiVielbeinVWeak is the pion-INDEPENDENT piece, obtained by truncating the
    1/fPi series at order 0 instead of fPiOrder -- the same Series that
    getRidOfhigherOrderTerm applies, and applied at the same place (after the
    isospin trace), so the warning above about differentiating unevaluated HC
    and del heads is respected.

    At u = 1 the vielbein is r_mu - l_mu, and that combination is PURELY WEAK:
    r - l = -(g2/2) Vud (tau^1 Wi_1 + tau^2 Wi_2) - tau^3 [ (g2 cw + g1 sw)/2 Z + (g2 sw - g1 cw)/2 A ]
    and g2 sw - g1 cw = ee - ee = 0, so the PHOTON CANCELS IDENTICALLY and only
    W (with its V_ud) and Z survive.  That is what makes this the right object to
    hang C5A on: the form factor reaches both weak transition currents and cannot
    touch gamma N -> Delta, so the Fig. 33 photoproduction results are untouched
    by construction rather than by inspection.  *)
ChiVielbeinVWeak[mu_, l_]   := ChiVielbeinVWeak[mu, l] = Normal[Series[(1/2)*Tr[PauliSigma[l] . ChiVielbein[mu]], {fPi, Infinity, 0}]];
ChiVielbeinVPion[mu_, l_]   := ChiVielbeinVPion[mu, l] = ChiVielbeinV[mu, l] - ChiVielbeinVWeak[mu, l];

(* ****************************************************************************** *)
(*  CACHE CONTROL -- ChiPTClearCache[] MUST be called right after LoadModel.      *)
(*                                                                                *)
(*  The helper functions above are memoised (f[x_] := f[x] = body) because they    *)
(*  are re-evaluated hundreds of times while the Lagrangian is built, and without  *)
(*  caching a WriteUFO run takes tens of minutes.                                  *)
(*                                                                                 *)
(*  BUT: FeynRules' LoadModel evaluates some of them WHILE the model is still      *)
(*  being set up, at a point where HC[umat] and del[umat,mu] cannot yet resolve.   *)
(*  getRidOfhigherOrderTerm (= Series in 1/fPi) then differentiates the surviving  *)
(*  HC and del heads as ordinary functions of fPi and produces Derivative[1][HC][0]*)
(*  and Derivative[1,0][del][0,...] junk -- which the memoisation then freezes     *)
(*  FOREVER.  Measured straight after LoadModel: ChiVielbein2 already held 12      *)
(*  cached entries containing 834 such junk terms, and every pi-N-Delta vertex in  *)
(*  the resulting UFO was contaminated.                                           *)
(*                                                                                 *)
(*  ChiPTClearCache[] drops the specific memo entries and keeps the generic        *)
(*  pattern rules, so everything is recomputed correctly on first use after the    *)
(*  model is fully loaded -- and cached correctly from then on.                    *)
(*                                                                                 *)
(*      LoadModel["ChiPT.fr"];                                                     *)
(*      ChiPTClearCache[];              (* <-- do not skip *)                      *)
(*      WriteUFO[LTotal, AddDecays -> False, FlavorExpand -> True];                *)
(* ****************************************************************************** *)

SetAttributes[ChiPTPurge, HoldAll];
ChiPTPurge[s_Symbol] := DownValues[s] =
   Select[DownValues[s], !FreeQ[First[#], Pattern] &];

ChiPTClearCache[] := (
  ChiPTPurge[ChiConnect];   ChiPTPurge[ChiVielbein];  ChiPTPurge[ChiVielbein2];
  ChiPTPurge[ChiConnectV];  ChiPTPurge[ChiVielbeinV];
  ChiPTPurge[ChiVielbeinVWeak]; ChiPTPurge[ChiVielbeinVPion];
  ChiPTPurge[aVec];         ChiPTPurge[vVec];
  ChiPTPurge[LMatTilda];    ChiPTPurge[RMatTilda];
  ChiPTPurge[LMatTildaV];   ChiPTPurge[LMatTildaA];
  ChiPTPurge[SrcTildaV1];   ChiPTPurge[SrcTildaA1];
  ChiPTPurge[PiPoleSrc];    ChiPTPurge[PiPole];
  "ChiPT: load-time caches purged");

(* Electromagnetic field strength.  F_{mu nu} = d_mu A_nu - d_nu A_mu.  In
   FeynRules del[A[mu],nu] means d_nu A_mu, hence the index order below; this
   agrees with FeynRules' own FS[A,mu,nu].

   myPions.fr had the two terms the other way round, i.e. -F_{mu nu}.  That was
   argued to compensate for this model's photon having the opposite sign to the
   standard one (LNNVector gives Vertex(p~ p A) = +I ee Ga[mu], against the
   standard -I ee Ga[mu]).  Comparing the exported UFO against ELA_UFO shows the
   compensation does NOT happen: relative to ELA the gamma-p-p, gamma-pi-pi and
   Kroll-Ruderman vertices all flip sign, while gamma-N-Delta does not.  The
   Delta therefore interfered with the Born terms the wrong way round -- the
   Born/Delta ratio-of-ratios came out -1.02, a genuine relative sign rather
   than an overall phase.  With the standard F below it is +1.02, matching the
   validated ELA model. *)
EMStrengthTensor[mu_, nu_]     := del[A[nu], mu] - del[A[mu], nu];
DualEMStrengthTensor[mu_, nu_] := Block[{ro, si}, (1/2)*Eps[mu, nu, ro, si]*EMStrengthTensor[ro, si]];

(* ---------------- the ISOVECTOR external vector source and its field strength -
   The N -> Delta transition is pure isovector (I = 1/2 -> 3/2 forces Delta I = 1),
   so CVC ties the WEAK vector transition to the electromagnetic one the model
   already fits to photoproduction.  LGammaNDelta as originally written could not
   express that: it used the PHOTON field strength and pinned the Delta isospin
   index to 3, so gauging never handed the W or the Z any vector transition at all
   and their N -> Delta vertices came out purely axial.

   IsoVecSource is the isovector part of v_mu = (l_mu + r_mu)/2, normalised so
   that its third component contains the photon with coefficient exactly 1 --
   which is what makes the substitution below leave gamma N -> Delta, and hence
   Fig. 33, untouched.  With l = LMat and r = RMat,
       v^1 = g2/4 Vud Wi^1 ,  v^2 = g2/4 Vud Wi^2 ,  v^3 = g2/4 Wi^3 + g1/4 B
   and (2/ee) v^3 = (1/(2 sw)) Wi^3 + (1/(2 cw)) B, whose photon part is
       (1/(2 sw)) sw A + (1/(2 cw)) cw A = A .                                  *)
(*  SIGN (settled 2026-08-27; the charged components carried an explicit minus
    from 2026-08-15 to 2026-08-27 and no longer do).  This IS the SM's own
    isovector v_mu = (l + r)/2, rescaled by 2/ee so component 3 carries the
    photon with coefficient 1, and nothing may be put on it by hand:

        v^1 = g2/4 Vud Wi^1   ->   (2/ee) v^1 = +(Vud/(2 sw)) Wi^1

    and LNNVector, which uses (LMatTilda + RMatTilda)/2 = (l + r)/2 at u = 1,
    gives the nucleon the SAME +(g2/4) Vud.  A minus here made the one isovector
    source appear with opposite W^1 coefficients in the two sectors.

    The minus was added because tools/cvc_ndelta.py measured
    (p~ Delta++ W-)/(p~ Delta+ A) = -1.29517792 where it expected
    +Vud sqrt3/(2 sw sqrt2).  The measurement was right and the EXPECTATION was
    wrong: that Clebsch sign comes from a Delta phase convention this file does
    not use.  The Delta embedding in the R[5] Definitions gives charged/neutral
    = -sqrt(3/2), and the model's own strong vertex says so outright,

        (p~ Delta++ Pi-)/(p~ Delta+ Pi0) = -1.224745 = -sqrt(3/2)

    so -1.29517792 was the value CVC actually demands here.  The real error the
    minus was papering over is the axial one -- see header note 2.  Both
    show up in the CC Delta together and cancel there (the Delta-only ppip cross
    section is bit-identical with both signs), which is why the reference run
    that motivated the minus could not tell them apart; what they do break is
    the CC Delta/Born interference and, for the axial alone, the NC.

    Component 3 is untouched either way, so the photon and Z vector transitions,
    and Fig. 33 with them, never depended on this. *)
IsoVecSource[mu_, 1] := (Vud/(2*sw))*Wi[mu, 1];
IsoVecSource[mu_, 2] := (Vud/(2*sw))*Wi[mu, 2];
IsoVecSource[mu_, 3] := (1/(2*sw))*Wi[mu, 3] + (1/(2*cw))*B[mu];

IsoStrengthTensor[mu_, nu_, i_]     := del[IsoVecSource[nu, i], mu] - del[IsoVecSource[mu, i], nu];
DualIsoStrengthTensor[mu_, nu_, i_] := Block[{ro, si}, (1/2)*Eps[mu, nu, ro, si]*IsoStrengthTensor[ro, si, i]];

(* Nucleon isodoublet as a plain list, and the covariant derivative acting on the
   isospinor-isovector Delta field. *)
Nucleons[s_]    := {Proton[s], Neutron[s]};
Nucleonsbar[s_] := {Protonbar[s], Neutronbar[s]};

Sigma[mu_, nu_, s1_, s2_] := Block[{s3}, (I/2)*(Ga[mu, s1, s3] . Ga[nu, s3, s2] - Ga[nu, s1, s3] . Ga[mu, s3, s2])];

DeltaConnection[ro_, r1_, r2_, i1_, i2_] :=
  Block[{k}, Sum[-2*I*Eps[i1, i2, k]*ChiConnectV[ro, k]*IndexDelta[r1, r2], {k, 1, 3}]
             + IndexDelta[i1, i2]*ChiConnect[ro][[r1, r2]]];

DeltaCovariantDerivative[ro_, r1_, r2_, i1_, i2_, psi_] :=
  IndexDelta[i1, i2]*IndexDelta[r1, r2]*del[psi, ro] + DeltaConnection[ro, r1, r2, i1, i2]*psi;

$Assumptions = {cw^2 + sw^2 == 1, gD > 0, g1D > 0};


(* ****************************************************************************** *)
(* *****                          Lagrangian                                ***** *)
(* ****************************************************************************** *)

(* ---------------------------------------------------------------- SM sector -- *)

LGauge := Block[{mu,nu},
  -1/(2 g2^2) Tr[FSMat[WMat, mu, nu].FSMat[WMat, mu, nu]]
  -1/(2 g1^2) Tr[FSMat[BMat, mu, nu].FSMat[BMat, mu, nu]]];

LFermions := Block[{mu},
  ExpandIndices[I*(
    LLbar.Ga[mu].DC[LL, mu] + lRbar.Ga[mu].DC[lR, mu]),
  FlavorExpand->{SU2W,SU2D}]];

LHiggs := Block[{ii,mu, feynmangaugerules},
  feynmangaugerules = If[Not[FeynmanGauge], {G0|GP|GPbar ->0}, {}];

  ExpandIndices[DC[Phibar[ii],mu] DC[Phi[ii],mu] + muH^2 Phibar[ii] Phi[ii] - lam Phibar[ii] Phi[ii] Phibar[jj] Phi[jj], FlavorExpand->{SU2D,SU2W}]/.feynmangaugerules
 ];

LYukawa := Block[{sp,ii,jj,cc,ff1,ff2,ff3,yuk,feynmangaugerules},
  feynmangaugerules = If[Not[FeynmanGauge], {G0|GP|GPbar ->0}, {}];

  yuk = ExpandIndices[
    -yl[ff1, ff3] LLbar[sp, ii, ff1].lR [sp, ff3] Phi[ii], FlavorExpand -> SU2D];
  yuk+HC[yuk]/.feynmangaugerules
 ];

LGhost := Block[{LGh1,LGhw,LGhs,LGhphi,mu, generators,gh,ghbar,Vectorize,phi1,phi2,togoldstones,doublet,doublet0},
  (* Pure gauge piece *)
  LGh1 = -ghBbar.del[DC[ghB,mu],mu];
  LGhw = -ghWibar[ii].del[DC[ghWi[ii],mu],mu];

  (* Scalar pieces: see Peskin pages 739-742 *)
  gh    = {ghB, ghWi[1], ghWi[2], ghWi[3]};
  ghbar = {ghBbar, ghWibar[1], ghWibar[2], ghWibar[3]};
  generators = {-I/2 g1 IdentityMatrix[2], -I/2 g2 PauliSigma[1], -I/2 g2 PauliSigma[2], -I/2 g2 PauliSigma[3]};
  doublet = Expand[{(-I phi1 - phi2)/Sqrt[2], Phi[2]} /. MR$Definitions /. vev -> 0];
  doublet0 = {0, vev/Sqrt[2]};
  Vectorize[{a_, b_}]:= Simplify[{Sqrt[2] Re[Expand[a]], Sqrt[2] Im[Expand[a]], Sqrt[2] Re[Expand[b]], Sqrt[2] Im[Expand[b]]}/.{Im[_]->0, Re[num_]->num}];
  togoldstones := {phi1 -> (GP + GPbar)/Sqrt[2], phi2 -> (-GP + GPbar)/(I Sqrt[2])};
  LGhphi=Plus@@Flatten[Table[-ghbar[[kkk]].gh[[lll]] Vectorize[generators[[kkk]].doublet0].Vectorize[generators[[lll]].(doublet+doublet0)],{kkk,4},{lll,4}]] /.togoldstones;

ExpandIndices[ If[FeynmanGauge, LGh1 + LGhw + LGhphi,0], FlavorExpand->SU2W]];

LSM := LGauge + LFermions + LHiggs + LYukawa + LGhost;


(* ------------------------------------------------------------- pion sector -- *)
(*  L = (fPi^2/4) Tr[ D_mu U (D^mu U)^+ + chi U^+ + U chi^+ ]                     *)

LPionKin := Normal[Series[
   Block[{mu}, ExpandIndices[(1/4)*fPi^2*Tr[DelU[mu] . HC[DelU[mu]] + MassU]]],
   {fPi, Infinity, fPiOrder}]];

(* ----------------------------------------------------------- nucleon sector -- *)
(*  L = Nbar ( i gamma^mu d_mu - M ) N                           LNucleonKin     *)
(*    + Nbar gamma^mu ( vVec + (L~ + R~)/2 ) N                   LNNVector       *)
(*    + ga Nbar gamma^mu ( aVec + (R~ - L~)/2 ) gamma5 N         LNNAxial        *)
(*  i.e. Nbar (i Dslash - M + (ga/2) uslash gamma5) N in GL form, with           *)
(*  L~ = u l u^+ and R~ = u^+ r u.  At u = 1 the axial source is (r - l)/2, the  *)
(*  W sits in l only, and the W vertex comes out (1 - ga gamma5).  The pi-N-N    *)
(*  coupling is the standard -(ga/(2 fPi)) Nbar gamma^mu gamma5 tau.d_mu pi N.   *)
(*                                                                               *)
(*  DO NOT rewrite these in terms of ChiConnect / ChiVielbein.  Algebraically    *)
(*      I ChiConnect[mu]  == vVec[mu] + (L~ + R~)/2                              *)
(*      ChiVielbein[mu]/2 == aVec[mu] + (R~ - L~)/2                              *)
(*  but those two are fed through getRidOfhigherOrderTerm downstream, and        *)
(*  Series differentiates still-unevaluated HC and del heads as functions of    *)
(*  fPi.  Substituting them here was checked and gives pion-nucleon couplings a  *)
(*  factor 2 too small plus spurious parity-violating pi-N-N vertices.           *)

LNucleonKin := I*Block[{mu, s1, s2},
     Inner[Dot, Nucleonsbar[s1],
       Inner[Dot, Ga[mu, s1, s2]*IdentityMatrix[2], del[Nucleons[s2], mu]]]]
   - MNucleon*Block[{s1}, Inner[Dot, Nucleonsbar[s1], Nucleons[s1]]];

LNNVector := Block[{mu, s1, s2}, Normal[Series[
   Inner[Dot, Nucleonsbar[s1],
     Inner[Dot, Ga[mu, s1, s2]*IdentityMatrix[2],
       Inner[Dot, vVec[mu] + (1/2)*(LMatTilda[mu] + RMatTilda[mu]), Nucleons[s2]]]],
   {fPi, Infinity, fPiOrder}]]];

LNNAxial := Block[{mu, s1, s2, s3}, Normal[Series[
   ga*Inner[Dot, Nucleonsbar[s1],
     Inner[Dot, Ga[mu, s1, s2]*IdentityMatrix[2],
       Inner[Dot, aVec[mu] + (1/2)*(RMatTilda[mu] - LMatTilda[mu]),
         Inner[Dot, Ga[5, s2, s3]*IdentityMatrix[2], Nucleons[s3]]]]],
   {fPi, Infinity, fPiOrder}]]];


(* ------------------------------ nucleon electromagnetic form factors --------- *)
(*  Only included when ChiPT$FormFactors is "Nucleon" or "All".                   *)
(*                                                                                *)
(*  Dirac part: LNNVector already gives the point-like proton coupling            *)
(*      + ee A^mu pbar gamma_mu p     ->   Vertex(p~ p A) = +I ee Ga[mu]          *)
(*  so the proton term below carries (FF1PA - 1): the -1 cancels that point-like  *)
(*  piece in the coupling, leaving the single structure F1p*Gamma in the UFO.     *)
(*  The neutron has no point-like coupling, so FF1NA enters directly.             *)
(*                                                                                *)
(*  Pauli part.  Eq. (14) of nucl-th/0509020v2, -(I e/4M) F2 Nbar gamma_{mu nu} N *)
(*  F^{mu nu}, gives the vertex  +I (e/4M) F2 (gamma^mu qslash - qslash gamma^mu) *)
(*  -- which is what Fig33v2.m uses (c2p), and Fig33v2.m is validated against     *)
(*  Appendix A to 1e-16.                                                          *)
(*                                                                                *)
(*  SIGN, corrected 2026-08-27.  This block used to argue that because the model's *)
(*  Dirac coupling is +I ee Ga[mu], i.e. minus the paper's, the Pauli term had to  *)
(*  be minus the paper's too, and it claimed the exported coupling came out        *)
(*  -(ee FF2PA)/(2 MNucleon).  Both halves of that were stale: the term below      *)
(*  carries a PLUS, and the exported coupling is                                   *)
(*      +ee/(2 MNucleon)  on  P(-1,3)*Sigma(3,-1,2,1)                              *)
(*  with the F2p form factor, on p~ p A and n~ n A alike (V12, FFV19/FFV18).       *)
(*  The plus is the physically correct one: by the Gordon decomposition the        *)
(*  anomalous moment must ADD to the Dirac moment, so with a +I ee Ga[mu] Dirac    *)
(*  coupling the Pauli term takes the same relative sign, not the opposite one.    *)
(*  The two signs do not have to be tied together the way the old note assumed --  *)
(*  what is fixed is their RATIO, and mu_p = 1 + kappa_p requires it to be +.      *)
(*                                                                                *)
(*  NB ELA_UFO's own Pauli coupling has the OPPOSITE sign to Fig33v2.m (-0.14433i *)
(*  vs +0.14433i on the same structure) even though ELA.fr transcribes Eq. (14)   *)
(*  faithfully.  That discrepancy is unresolved and is NOT reproduced here: this   *)
(*  file follows the paper.                                                        *)
LNNEMFF := Block[{mu, nu, s1, s2},
    ee*((FF1PA - 1)*A[mu]*Protonbar[s1] . Ga[mu, s1, s2] . Proton[s2]
      + FF1NA*A[mu]*Neutronbar[s1] . Ga[mu, s1, s2] . Neutron[s2])
  + (ee/(4*MNucleon))*FS[A, mu, nu]*
      (FF2PA*Protonbar[s1] . Sig[mu, nu, s1, s2] . Proton[s2]
     + FF2NA*Neutronbar[s1] . Sig[mu, nu, s1, s2] . Neutron[s2])];


(* ------------------------------- weak-sector nucleon form factors ------------ *)
(*  Only included when ChiPT$FormFactors is "Weak" or "All".  ADDITIVE           *)
(*  corrections in the LNNEMFF style, never replacements: each Dirac and axial   *)
(*  term carries (FF - 1), so the -1 goes to the coupling and cancels the        *)
(*  point-like piece the gauging already produced, leaving one Lorentz structure *)
(*  multiplied by the full form factor.  The Pauli terms carry no -1 because     *)
(*  there is nothing to cancel: neither the W nor the Z has any point-like weak  *)
(*  magnetism in this model, so those two operators are genuinely new.           *)
(*                                                                               *)
(*  THE COUPLINGS ARE NOT INVENTED, they are the model's own, read back out of   *)
(*  the exported UFO so that (FF - 1) cancels EXACTLY:                           *)
(*     W:  Vertex(n~ p W-) = i ee Vud/(2 sw Sqrt[2]) Ga[mu]                      *)
(*                         - i ee ga Vud/(2 sw Sqrt[2]) Ga[mu].Ga[5]             *)
(*     Z:  Vertex(p~ p Z)  = i ee (cw/(4 sw) - 3 sw/(4 cw)) Ga[mu] + axial       *)
(*         Vertex(n~ n Z)  = -i ee (cw/(4 sw) + sw/(4 cw)) Ga[mu] + axial        *)
(*  which are (g/2c_w)(T3 - 2 Q sw^2) and the pure isovector +-ga/2 as they      *)
(*  should be.  The Pauli normalisation follows the Dirac one: the photon's is   *)
(*  ee for Dirac and ee/(4 M) for Pauli, so the W's is g_cc/(4 M) with           *)
(*  g_cc = ee Vud/(2 sw Sqrt[2]), and the Z's is (ee/(2 sw cw))/(4 M).           *)
(*                                                                               *)
(*  V_ud rides along on the CC terms because it is already in the coupling that  *)
(*  the (FF - 1) has to cancel; the NC terms carry none, correctly.              *)
LNNWeakCCFF := Block[{mu, nu, s1, s2, s3},
    (ee*Vud/(2*sw*Sqrt[2]))*(
        (FFW1A - 1)*W[mu]*Protonbar[s1] . Ga[mu, s1, s2] . Neutron[s2]
      - ga*(FFWAA - 1)*W[mu]*Protonbar[s1] . Ga[mu, s1, s2] . Ga[5, s2, s3] . Neutron[s3]
      + (FFW2A/(4*MNucleon))*(del[W[nu], mu] - del[W[mu], nu])*
          Protonbar[s1] . Sig[mu, nu, s1, s2] . Neutron[s2])
  + (ee*Vud/(2*sw*Sqrt[2]))*(
        (FFW1B - 1)*HC[W[mu]*Protonbar[s1] . Ga[mu, s1, s2] . Neutron[s2]]
      - ga*(FFWAB - 1)*HC[W[mu]*Protonbar[s1] . Ga[mu, s1, s2] . Ga[5, s2, s3] . Neutron[s3]]
      + (FFW2B/(4*MNucleon))*HC[(del[W[nu], mu] - del[W[mu], nu])*
          Protonbar[s1] . Sig[mu, nu, s1, s2] . Neutron[s2]])];

(*  The Z is self-conjugate, so each term below is hermitian on its own and there
    is no h.c. half -- one symbol per nucleon per structure, not two.  *)
LNNWeakNCFF := Block[{mu, nu, s1, s2, s3},
    Z[mu]*(
        ee*(cw/(4*sw) - 3*sw/(4*cw))*(FFZ1P - 1)*
            Protonbar[s1] . Ga[mu, s1, s2] . Proton[s2]
      - ee*(cw/(4*sw) + sw/(4*cw))*(FFZ1N - 1)*
            Neutronbar[s1] . Ga[mu, s1, s2] . Neutron[s2]
      - ee*ga*(cw/(4*sw) + sw/(4*cw))*(FFZAP - 1)*
            Protonbar[s1] . Ga[mu, s1, s2] . Ga[5, s2, s3] . Proton[s3]
      + ee*ga*(cw/(4*sw) + sw/(4*cw))*(FFZAN - 1)*
            Neutronbar[s1] . Ga[mu, s1, s2] . Ga[5, s2, s3] . Neutron[s3])
  + (ee/(2*sw*cw))*(1/(4*MNucleon))*(del[Z[nu], mu] - del[Z[mu], nu])*
      (FFZ2P*Protonbar[s1] . Sig[mu, nu, s1, s2] . Proton[s2]
     + FFZ2N*Neutronbar[s1] . Sig[mu, nu, s1, s2] . Neutron[s2])];

(* ------------------------ Adler's C4A = -C5A/4 ------------------------------ *)
(*  The standard decomposition of the axial N -> Delta current is               *)
(*      ubar_a [ (C3A/M)(g^{am} qslash - q^a gamma^m)                           *)
(*             + (C4A/M^2)(g^{am} q.p_D - q^a p_D^m)                            *)
(*             + C5A g^{am} + (C6A/M^2) q^m q^a ] u                             *)
(*  and this model supplies C5A ALONE: delta_couplings.py shows its weak        *)
(*  N -> Delta vertex is exactly proportional to g^{am} x Identity, component   *)
(*  by component.  So C3A = 0 already agrees with Adler [13,14]; C4A = -C5A/4   *)
(*  does not, and is the term below.                                            *)
(*                                                                              *)
(*  It is built from ChiVielbeinVWeak, the SAME object the C5A piece uses, so   *)
(*  the charged/neutral coupling, V_ud and every isospin Clebsch come along      *)
(*  automatically -- nothing is normalised by hand except the single overall     *)
(*  constant C4AN, which lives in the param card precisely so it can be          *)
(*  calibrated against the measured C5A without regenerating the UFO.           *)
(*  FFCA5 rides along too, so C4A keeps exactly C5A's Q^2 dependence, which is   *)
(*  what C4A = -C5A/4 requires.                                                  *)
(*                                                                              *)
(*  Index bookkeeping: al is the Delta's Lorentz index, lam the source's.        *)
(*      T1 = g^{al lam} (p_Delta . q)   from contracting the two derivatives     *)
(*      T2 = q^al p_Delta^lam           from crossing them                       *)
(*  The Dirac structure is the plain Identity (Deltabar and N share s1), which   *)
(*  is the structure the standard parameterisation is written in.                *)

(*  Leading minus: C4A must keep its sign relative to C5A.  C5A comes from the  *)
(*  +(hD/MDelta) u_mu term, whose source part is ChiVielbeinVWeak = (r - l);    *)
(*  through V2.0 this operator multiplied (l - r).  Net vertex unchanged.       *)
LC4ANDelta := -C4AN*Block[{al, lam, nu, s1},
   FFCA5A*Sum[(ME[al, lam]*del[Deltabar[s1, al, r1, i1], nu]*del[ChiVielbeinVWeak[lam, i1], nu]
             - del[Deltabar[s1, al, r1, i1], lam]*del[ChiVielbeinVWeak[lam, i1], al])*
      Nucleons[s1][[r1]], {r1, 1, 2}, {i1, 1, 3}]
 + FFCA5B*HC[Sum[(ME[al, lam]*del[Deltabar[s1, al, r1, i1], nu]*del[ChiVielbeinVWeak[lam, i1], nu]
             - del[Deltabar[s1, al, r1, i1], lam]*del[ChiVielbeinVWeak[lam, i1], al])*
      Nucleons[s1][[r1]], {r1, 1, 2}, {i1, 1, 3}]]];


(* ---------------------------- induced pseudoscalar --------------------------- *)
(*  The pion pole in the nucleon axial current: the fourth Lorentz structure of  *)
(*  the N-N-W vertex, q^mu gamma5, which the model had no point-like piece of.   *)
(*                                                                               *)
(*  q^mu is the W's own momentum, so in position space the operator is the       *)
(*  DIVERGENCE of the W field, del[W[mu], mu], contracted with the nucleon       *)
(*  pseudoscalar density.  Written with the same prefactor and the same (-ga)    *)
(*  as the axial term in LNNWeakCCFF, so every coupling, V_ud and isospin factor *)
(*  comes along automatically and FPP carries ONLY the ratio to the axial one:   *)
(*                                                                               *)
(*      F_P(Q^2) / F_A(Q^2)  =  2 MN / (Q^2 + mpi^2)                             *)
(*  with the 2 MN carried by the coupling below and 1/(Q^2+mpi^2) by FPP.        *)
(*                                                                               *)
(*  which is Goldberger-Treiman / PCAC with no free parameter.  The charged pion *)
(*  mass is the right one here -- this is the charged current.                   *)
(*                                                                               *)
(*  NOTE this is an EFFECTIVE operator: the pion pole is put in by hand through  *)
(*  the form factor rather than emerging from the two-point W-pi mixing, which   *)
(*  FeynRules cannot export (the UFO has no two-point vertices at all).  So PCAC *)
(*  is imposed here, not derived, which is a weaker statement than the CVC       *)
(*  story where gauging produced the relation on its own.                        *)
(*                                                                               *)
(*  It contributes to the rate only through the lepton mass -- q^mu contracted   *)
(*  with the lepton tensor is proportional to m_lepton^2 -- so it is identically *)
(*  invisible for a massless muon.                                               *)
(*  The explicit I is required by hermiticity, and it is what puts this term at *)
(*  the same phase as the axial one it partners:  (psibar gamma^mu gamma5 psi)   *)
(*  is hermitian but (psibar gamma5 psi) is ANTI-hermitian, so only I times the  *)
(*  pseudoscalar density can appear with a real coefficient.  It is the same I   *)
(*  that shows up in del_mu (psibar gamma^mu gamma5 psi) = 2 I m psibar gamma5   *)
(*  psi.  The generated F_P/F_A ratio is checked numerically after export.       *)
(*  The 2*MNucleon lives HERE, in the coupling, and not inside FPP.  That is    *)
(*  not cosmetic.  FeynRules groups terms sharing a coupling constant into ONE   *)
(*  Lorentz structure, so with the identical prefactor the pseudoscalar was      *)
(*  merged into the axial structure and the pair came out as                     *)
(*      (FPP(...))*P(3,3)*Gamma5(2,1) - (FWA(...))*Gamma5(-1,1)*Gamma(3,2,-1)    *)
(*  -- one structure carrying TWO form factors, which is precisely the sympy Mul *)
(*  that Sherpa-generate-model rejects.  Its own 2*MNucleon factor makes *)
(*  the coupling distinct and splits the structures, one form factor each.  It   *)
(*  is the same trick FFW2A/B get for free from their 1/(4*MNucleon).            *)
(*  OVERALL SIGN.  Fixed by measurement, not by choice.  PCAC requires          *)
(*      q_mu <N'|A^mu|N> = 2 MN F_A mpi^2/(Q^2+mpi^2) ubar gamma5 u             *)
(*  i.e. the contracted axial current must be SUPPRESSED, vanishing in the      *)
(*  chiral limit.  With the opposite sign the same contraction comes out        *)
(*  ENHANCED by 1 + Q^2/(Q^2+mpi^2), measured as 1.720, 1.911, 1.963, 1.981 at  *)
(*  Q^2 = 0.05, 0.2, 0.5, 1.0 against the required 0.280, 0.089, 0.038, 0.019.  *)
(*                                                                              *)
(*  V7-V9 CARRIED A LEADING MINUS HERE AND IT WAS WRONG.  q is the OUTGOING W   *)
(*  momentum, so with the UFO's all-outgoing legs ('p~' at -p1, 'n' at p2)      *)
(*  momentum conservation forces q = p1 - p2.  tools/pcac_nucleon.py handed     *)
(*  the W leg p2 - p1 instead, which does not conserve momentum and reverses    *)
(*  the q^mu gamma5 term relative to gamma^mu gamma5; the test then reported    *)
(*  the suppressed sequence for the enhanced model.  With the assignment fixed  *)
(*  the minus sign gives 1.720/1.911/1.963/1.981 -- the wrong-sign signature    *)
(*  its own docstring names -- and removing it gives 0.280/0.089/0.038/0.019.   *)
(*  Two independent checks agree: tools/nucleon_ff.py solves for F_P directly   *)
(*  without contracting anything (exact, residual 1e-16), and tools/ccqe_ls.py  *)
(*  moves from 4.2% off Llewellyn Smith at threshold to a flat 0.07%, which is  *)
(*  the W width and nothing else.  The sign is now plain, as written.           *)
(* ----------------------------- C6A on the Delta ------------------------------ *)
(*  The Delta's induced pseudoscalar, the q^alpha q^mu structure of the         *)
(*  N -> Delta axial current, tied to C5A by PCAC:                              *)
(*                                                                              *)
(*      C6A(Q^2) = C5A(Q^2) MN^2 / (Q^2 + mpi^2)                                *)
(*                                                                              *)
(*  so (C6A/MN^2) q^a q^mu = C5A/(Q^2+mpi^2) q^a q^mu, which is why FC6A is      *)
(*  FCA5/(Q^2+mpi^2) and carries dimension 1/mass^2.                            *)
(*                                                                              *)
(*  Built from ChiVielbeinVWeak like LC4ANDelta, so V_ud, the isospin Clebsches  *)
(*  and the Z come along on their own.  Two derivatives of the source give the   *)
(*  two powers of q; the Dirac structure is the plain Identity, matching the C4A *)
(*  term (in this model's Rarita-Schwinger convention the C5A structure is the   *)
(*  one that carries the explicit Gamma5, not these).                           *)
(*                                                                              *)
(*  C6AN is calibrated, NOT assumed: the model's C5A comes from the gauged       *)
(*  Pascalutsa coupling rather than a plain g^{a mu} structure, so the relative  *)
(*  normalisation is not 1 by inspection.  It is fixed by demanding that         *)
(*  q_mu <Delta|A^mu|N> come out suppressed like mpi^2/(Q^2+mpi^2), the same     *)
(*  test that fixed the sign of LNNPPFF.  Keeping it an external parameter means *)
(*  the calibration needs no regeneration -- see the note at C4AN.              *)
(*                                                                              *)
(*  Its own coupling constant also keeps FeynRules from merging this into the    *)
(*  C4A structure, which shares the Identity Dirac structure.                    *)
(*  Leading minus for the same reason as LC4ANDelta. *)
LC6ANDelta := -C6AN*Block[{al, lam, s1},
   FFC6AA*Sum[del[del[ChiVielbeinVWeak[lam, i1], lam], al]*
       Deltabar[s1, al, r1, i1]*Nucleons[s1][[r1]], {r1, 1, 2}, {i1, 1, 3}]
 + FFC6AB*HC[Sum[del[del[ChiVielbeinVWeak[lam, i1], lam], al]*
       Deltabar[s1, al, r1, i1]*Nucleons[s1][[r1]], {r1, 1, 2}, {i1, 1, 3}]]];


LNNPPFF := Block[{mu, s1, s2},
    I*(ee*Vud/(2*sw*Sqrt[2]))*(-ga)*(2*MNucleon)*FFPPA*
        del[W[mu], mu]*Protonbar[s1] . Ga[5, s1, s2] . Neutron[s2]
  + HC[I*(ee*Vud/(2*sw*Sqrt[2]))*(-ga)*(2*MNucleon)*FFPPB*
        del[W[mu], mu]*Protonbar[s1] . Ga[5, s1, s2] . Neutron[s2]]
  (* --- neutral current.  The NC axial is pure isovector, so it carries the  *)
  (* --- SAME pole; the mass is the neutral pion's, hence FPPZ not FPP.       *)
  + I*(-ee*ga*(cw/(4*sw) + sw/(4*cw)))*(2*MNucleon)*FFPPZP*
        del[Z[mu], mu]*Protonbar[s1] . Ga[5, s1, s2] . Proton[s2]
  + I*(ee*ga*(cw/(4*sw) + sw/(4*cw)))*(2*MNucleon)*FFPPZN*
        del[Z[mu], mu]*Neutronbar[s1] . Ga[5, s1, s2] . Neutron[s2]];


(* ------------------- CVC / PCAC on the background diagrams ------------------- *)
(*  The contact term, built by restricting LNNVector / LNNAxial to the           *)
(*  one-pion piece of their own source combination.  Written exactly as those    *)
(*  two terms are -- LNNVector uses vVec + (L~+R~)/2 = vVec + LMatTildaV, so its *)
(*  one-pion piece is SrcTildaV1 with no extra factor, and likewise for the      *)
(*  axial -- so the two halves inherit the model's own relative factor of +ga    *)
(*  and nothing is normalised by hand.                                          *)
(*                                                                              *)
(*  THE FORM FACTORS ARE NOT ASSIGNED BY DIRAC STRUCTURE.  See the long note at  *)
(*  SrcTildaV1 above.  The gamma^mu (Weinberg-Tomozawa) half comes from          *)
(*  LNNVector but multiplies the AXIAL source, so it belongs to <pi N|A^mu|N>    *)
(*  and takes F_rho; the gamma^mu gamma5 (Kroll-Ruderman) half comes from        *)
(*  LNNAxial but multiplies the VECTOR source, so CVC applies to it and it takes *)
(*  F1V.  V8 had these two the other way round.                                 *)
(*                                                                              *)
(*  The (FF - 1) sends the -1 to the coupling, where it cancels the point-like  *)
(*  contact exactly and leaves one structure carrying the full form factor.     *)
(*  Same assign-then-sum precaution as LPFFF below; see the note there. *)
LNNCTFF := Module[{wt, krA, krZ},
  wt = Block[{mu, s1, s2}, Inner[Dot, Nucleonsbar[s1],
     Inner[Dot, Ga[mu, s1, s2]*IdentityMatrix[2],
       Inner[Dot, SrcTildaV1[mu], Nucleons[s2]]]]];
  krA = Block[{mu, s1, s2, s3}, Inner[Dot, Nucleonsbar[s1],
     Inner[Dot, Ga[mu, s1, s2]*IdentityMatrix[2],
       Inner[Dot, ChiPTNoZ[SrcTildaA1[mu], mu],
         Inner[Dot, Ga[5, s2, s3]*IdentityMatrix[2], Nucleons[s3]]]]]];
  krZ = Block[{mu, s1, s2, s3}, Inner[Dot, Nucleonsbar[s1],
     Inner[Dot, Ga[mu, s1, s2]*IdentityMatrix[2],
       Inner[Dot, ChiPTZOnly[SrcTildaA1[mu], mu],
         Inner[Dot, Ga[5, s2, s3]*IdentityMatrix[2], Nucleons[s3]]]]]];
  (FFRHOCT - 1)*wt + ga*(FFW1CT - 1)*krA + ga*(FFZ1CT - 1)*krZ];

(*  The pion-in-flight term, from the same cross term of the pion kinetic       *)
(*  Lagrangian that produces the point-like boson-pi-pi vertex.  DelUSrc is the *)
(*  FULL source piece of D_mu U, so this reaches gamma-pi-pi and Z-pi-pi as     *)
(*  well as W-pi-pi -- V8 used the charged source alone and left the first two  *)
(*  point-like.  Both orderings of the cross term are kept, which is what makes *)
(*  the result hermitian.                                                       *)
(*                                                                              *)
(*  ONE form factor for all three bosons is not an approximation here.  The     *)
(*  boson-pi-pi vertex is pure isovector whatever the boson (the pion has no    *)
(*  isoscalar coupling), so the same F1V that CVC puts on the W pion-in-flight  *)
(*  is what the electromagnetic and neutral-current Ward identities want too;   *)
(*  the different weights (e, (1-2 sw^2)/(2 sw cw), V_ud/(2 sw sqrt2)) are      *)
(*  already in the model's own couplings and are not touched.                   *)
ChiPTPFCross[src_] := Normal[Series[
   Block[{mu}, ExpandIndices[(1/4)*fPi^2*
      Tr[src[mu] . HC[del[UMat, mu]] + del[UMat, mu] . HC[src[mu]]]]],
   {fPi, Infinity, fPiOrder}]];

DelUSrcNoZ[mu_] := ChiPTNoZ[DelUSrc[mu], mu];
DelUSrcZ[mu_]   := ChiPTZOnly[DelUSrc[mu], mu];

(*  ASSIGN THE TWO CROSS TERMS TO VARIABLES BEFORE SUMMING THEM.  This is the  *)
(*  same FeynRules pathology documented at LChiPT below, and it bites here for  *)
(*  a two-term sum: written inline as                                           *)
(*      (FFW1PF-1)*ChiPTPFCross[DelUSrcNoZ] + (FFZ1PF-1)*ChiPTPFCross[DelUSrcZ] *)
(*  FeynmanRules returns 7 vertices -- the photon and W ones only, with the      *)
(*  entire Z half silently gone.  Evaluated into a and b first and then summed,  *)
(*  the identical expression gives all 10.  Do not "simplify" this back.         *)
LPFFF := Module[{a, b},
  a = ChiPTPFCross[DelUSrcNoZ];
  b = ChiPTPFCross[DelUSrcZ];
  (FFW1PF - 1)*a + (FFZ1PF - 1)*b];


(* ------------------------------- the pion pole ------------------------------ *)
(*  The PP topology, the one Born diagram this model has never had:              *)
(*                                                                               *)
(*      W(q)  --[ f_pi q^mu two-point mixing ]--  pi*(q)  --[ propagator ]--     *)
(*            --[ Weinberg-Tomozawa pi-pi-N-N ]--  pi(k) N'                      *)
(*                                                                               *)
(*  It is missing because the UFO format has no two-point vertices, so FeynRules *)
(*  simply drops the W-pi mixing that (fPi^2/4) Tr[D_mu U (D^mu U)^+] contains at *)
(*  O(pi).  tools/pcac_1pi.py measures the consequence: on the Delta peak the     *)
(*  model supplies 0.32 of the axial divergence PCAC requires at Q^2 -> 0, and    *)
(*  the shortfall IS this diagram.                                               *)
(*                                                                               *)
(*  HOW IT IS PUT BACK.  The same device the kinetic-mixing model uses for the    *)
(*  photon-Zd mixing: do not export the two-point vertex, absorb it into the      *)
(*  fields it mixes.  There the mixing is a constant rotation and can go in a     *)
(*  Definitions -> rule; here it is momentum dependent AND carries a propagator,  *)
(*  so it cannot.  What makes it work anyway is that the virtual pion carries     *)
(*  EXACTLY the boson's momentum, so mixing and propagator are together a         *)
(*  function of q^2 alone -- i.e. a form factor -- and the whole topology         *)
(*  collapses onto one effective four-point operator.  That is the same trick     *)
(*  LNNPPFF uses for the nucleon's own induced pseudoscalar, and the same one     *)
(*  FrhoCT uses on the contact term.                                             *)
(*                                                                               *)
(*  THE INDUCED PION.  From the O(pi) cross term of the pion kinetic Lagrangian,  *)
(*      L_mix = (fPi/2) Tr[sigma^a (l - r)^mu] d_mu pi^a                          *)
(*  and the free pion equation of motion, the field the source induces is         *)
(*      Dpi^a = (fPi/2) d_mu Tr[sigma^a (l-r)^mu] / (q^2 - mpi^2)                 *)
(*            = -(fPi/2) FFPPPI d_mu Tr[sigma^a (l-r)^mu],   FFPPPI = 1/(Q^2+mpi^2)*)
(*                                                                               *)
(*  ISOSPIN SEPARATES THE CHANNELS BY ITSELF, which is why there is no field      *)
(*  selection here of the kind ChiPTNoZ / ChiPTZOnly do elsewhere:                *)
(*      Tr[sigma^1 (l-r)] = g2 Vud W^1,   Tr[sigma^2 (l-r)] = g2 Vud W^2          *)
(*      Tr[sigma^3 (l-r)] = ee (cw/sw + sw/cw) Z                                  *)
(*  -- the photon cancels EXACTLY in the third one (l = r for electromagnetism),  *)
(*  as it must: there is no pion pole in a vector current.  So a = 1,2 is the     *)
(*  charged current and a = 3 is the neutral one, and they can carry the charged  *)
(*  and neutral pion masses separately without touching the fields.               *)
(*                                                                               *)
(*  WHAT ABSORBS IT is the Weinberg-Tomozawa pi-pi-N-N vertex, i.e. the O(pi^2)   *)
(*  piece of vVec, which is  vVec[mu] = I [Phi, d_mu Phi]/(8 fPi^2)  with         *)
(*  Phi = sigma^a pi^a.  Shifting pi -> pi + Dpi and keeping the linear part      *)
(*  gives the operator below; the coefficient is vVec's own and is not chosen     *)
(*  here.  (Cross-check: that vVec gives Vertex(p~ p Pi- Pi+) = I/(4 fPi^2),      *)
(*  which is what the UFO carries.)                                              *)
(*                                                                               *)
(*  DO NOT also shift the pion in LNNAxial or in the Delta sector.  Those shifts  *)
(*  are real, but they are the nucleon induced pseudoscalar and C6A, which are    *)
(*  ALREADY in the model as LNNPPFF and LC6ANDelta; adding them here would        *)
(*  double count.  Restricting the shift to vVec is what makes this the one       *)
(*  genuinely new topology.                                                      *)
(*                                                                               *)
(*  OVERALL SIGN.  As derived above, with no hand choice: in V2.1 the pion and   *)
(*  baryon sectors share one convention, and the mixing from DelU,               *)
(*  m = +e fPi Vud/(2 sw), times the GL pi-N-N coupling -ga/(Sqrt[2] fPi),       *)
(*  reproduces LNNPPFF's Goldberger-Treiman relation.  Through V2.0 this sign    *)
(*  was reported as "fixed by measurement" (tools/pcac_1pi.py), but that         *)
(*  measurement was made in the mixed convention, where it should have chosen    *)
(*  the OPPOSITE sign to this derivation.  It did not -- so either pcac_1pi.py   *)
(*  has a momentum-assignment error of the kind pcac_nucleon.py had in V7-V9,    *)
(*  or the consistency argument is wrong somewhere.  RE-MEASURE before trusting. *)

PiPoleSrc[a_] := PiPoleSrc[a] = Block[{nu},
   ExpandIndices[Tr[PauliMatrix[a] . del[LMat[nu] - RMat[nu], nu]]]];

PiPole[a_] := PiPole[a] =
   -(fPi/2)*If[a === 3, FFPPPIZ, FFPPPIW]*PiPoleSrc[a];

(*  NOT memoised with the := X = X idiom the rest of the file uses.  That makes  *)
(*  an OwnValue, and ChiPTClearCache only purges DownValues -- so a memoised     *)
(*  PionMat would survive the purge that exists precisely to throw away          *)
(*  load-time junk.  Both are two-by-two sums and cost nothing to rebuild.       *)
PionMat    := ExpandIndices[Sum[PauliMatrix[a]*Pion[a], {a, 1, 3}]];
PiPoleMat  := ExpandIndices[Sum[PauliMatrix[a]*PiPole[a], {a, 1, 3}]];

(*  Assign the two commutators before summing them -- the same FeynRules         *)
(*  pathology documented at LPFFF and LChiPT.                                    *)
LPPoleFF := Module[{c1, c2},
  c1 = Block[{mu}, ExpandIndices[
        PiPoleMat . del[PionMat, mu] - del[PionMat, mu] . PiPoleMat]];
  c2 = Block[{mu}, ExpandIndices[
        PionMat . del[PiPoleMat, mu] - del[PiPoleMat, mu] . PionMat]];
  Block[{mu, s1, s2}, Inner[Dot, Nucleonsbar[s1],
     Inner[Dot, Ga[mu, s1, s2]*PPNorm*(I/(8*fPi^2))*(c1 + c2),
       Nucleons[s2]]]]];


(* ------------------------- weak N -> Delta transition with C5A(Q^2) ---------- *)
(*  This one REPLACES LPiNDeltaGI / LPiNDeltaGIFF rather than adding to it.      *)
(*                                                                               *)
(*  The note at LPiNDeltaGIFF is the reason: the weak transition current is not  *)
(*  a separate term, it comes from the gauge part of ChiVielbeinV, so it cannot  *)
(*  be given its own form factor by adding something -- "it needs its own        *)
(*  Lagrangian term".  Splitting the vielbein is that term.  ChiVielbeinVPion    *)
(*  and ChiVielbeinVWeak sum back to ChiVielbeinV exactly, so with FCA5 = 1 this *)
(*  is identical to what it replaces, term by term; all it does is let the       *)
(*  external-source half carry a form factor the pion half does not.             *)
(*                                                                               *)
(*  That deliberately breaks the gauge-invariance link between the strong vertex *)
(*  and the transition current, which is what ANY Q^2-dependent transition form  *)
(*  factor does -- it is why C5A is put in by hand in every model that has one.  *)
(*                                                                               *)
(*  FFPNDA/FFPNDB multiply the PION half only; the external-source half carries  *)
(*  FFCA5 alone.  Right for two independent reasons.                             *)
(*                                                                               *)
(*  PHYSICS.  Fig. 33 puts ONE sqrt(X_pi) on each Delta DIAGRAM.  A Delta        *)
(*  diagram has two vertices, so if both carried FpiNDelta the amplitude would   *)
(*  pick up X_pi rather than sqrt(X_pi) -- one factor too many.  Photoproduction *)
(*  never hit this because the gamma-N-Delta vertex carries FgNDelta*, not       *)
(*  FpiNDelta; the WEAK transition comes from the same gauged term as the strong *)
(*  vertex and so inherited FFPNDA and double-counted.                           *)
(*                                                                               *)
(*  FRAMEWORK.  Sherpa's UFO reader supports at most ONE form factor per Lorentz *)
(*  structure: ufo_interface/lorentz_algebra.py accumulates them multiplicatively*)
(*  (self.form_factor *= sympy.Function(...)) while lorentz_printer.py's         *)
(*  set_form_factor reads .name off what it assumes is a single sympy Function.  *)
(*  A product gives a sympy Mul and Sherpa-generate-model fails with              *)
(*      AttributeError: 'Mul' object has no attribute 'name'                     *)
(*  so FpiNDelta * FCA5 on one structure is not expressible at all.  That is a   *)
(*  real limit of the automated chain, not a modelling choice.  Symbols stay     *)
(*  outside HC[].                                                                *)
LPiNDeltaGIWeakFF := (hD/MDelta)*Block[{mu, nu, lam, si, s1, s2, s3, fa, fb},
  fa = If[ChiPT$DeltaFF, FFPNDA, 1];  fb = If[ChiPT$DeltaFF, FFPNDB, 1];
  fa*Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinVPion[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]
  + FFCA5A*Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinVWeak[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]
  + fb*HC[Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinVPion[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]]
  + FFCA5B*HC[Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinVWeak[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]]];


(* ------------------------------------------------- Delta(1232) self sector -- *)
(*  Rarita-Schwinger kinetic and mass terms with the off-shell parameter AD,     *)
(*  chirally covariantised (DeltaCovariantDerivative), plus the three            *)
(*  pi-Delta-Delta couplings g1D, g2D, g3D.                                      *)

LDeltaKin1 := -Block[{mu1, mu2, s1, s2, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*ME[mu1, mu2]*
        (I*Ga[ro, s1, s2]*DeltaCovariantDerivative[ro, r1, r2, i1, i2, #1]
         - IndexDelta[s1, s2]*IndexDelta[r1, r2]*IndexDelta[i1, i2]*MDelta*#1) &)[
      Delta[s2, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaKin2 := -Block[{mu1, mu2, s1, s2, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*I*AD*
        (Ga[mu1, s1, s2]*DeltaCovariantDerivative[mu2, r1, r2, i1, i2, #1]
         + Ga[mu2, s1, s2]*DeltaCovariantDerivative[mu1, r1, r2, i1, i2, #1]) &)[
      Delta[s2, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaKin3 := -Block[{mu1, mu2, s1, s2, s3, s4, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*(I/2)*(3*AD^2 + 2*AD + 1)*
        (Ga[mu1, s1, s2]*Ga[ro, s2, s3]*Ga[mu2, s3, s4]*
          DeltaCovariantDerivative[ro, r1, r2, i1, i2, #1]) &)[
      Delta[s4, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaKin4 := -Block[{mu1, mu2, s1, s2, s3, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*MDelta*(3*AD^2 + 3*AD + 1)*
        (Ga[mu1, s1, s2]*Ga[mu2, s2, s3]*#1) &)[
      Delta[s3, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaPi1 := (g1D/2)*Block[{mu1, mu2, s1, s2, s3, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*
        (Ga[ro, s1, s2]*IndexDelta[i1, i2]*ChiVielbein2[ro, r1, r2]*
          Ga[5, s2, s3]*ME[mu1, mu2]*#1) &)[
      Delta[s3, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaPi2 := (g2D/2)*Block[{mu1, mu2, s1, s2, s3, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*
        (Ga[mu1, s1, s2]*Ga[5, s2, s3]*IndexDelta[i1, i2]*ChiVielbein2[mu2, r1, r2]*#1
         + Ga[mu2, s1, s2]*Ga[5, s2, s3]*IndexDelta[i1, i2]*ChiVielbein2[mu1, r1, r2]*#1) &)[
      Delta[s3, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaPi3 := (g3D/2)*Block[{mu1, mu2, s1, s2, s3, s4, s5, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*
        (Ga[mu1, s1, s2]*Ga[ro, s2, s3]*Ga[5, s3, s4]*Ga[mu2, s4, s5]*
          IndexDelta[i1, i2]*ChiVielbein2[ro, r1, r2]*#1) &)[
      Delta[s5, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

(*  Assign each piece before summing -- the same FeynRules pathology documented
    at LChiPT.  As a bare sum of the seven delayed symbols, the g1D/g2D/g3D
    terms (LDeltaPi1-3) were silently lost from the full Lagrangian even though
    FeynmanRules[LDeltaPi1] alone returns them correctly. *)
LDeltaSector := Module[{k1, k2, k3, k4, p1, p2, p3},
  k1 = LDeltaKin1; k2 = LDeltaKin2; k3 = LDeltaKin3; k4 = LDeltaKin4;
  p1 = LDeltaPi1;  p2 = LDeltaPi2;  p3 = LDeltaPi3;
  k1 + k2 + k3 + k4 + p1 + p2 + p3];


(* ------------------------------------------- pi N Delta, conventional form -- *)

LPiNDelta := -gD*Block[{mu1, mu2, s1, s2, s3, i1, ro},
  Sum[Deltabar[s1, mu1, r1, i1]*
      (ME[mu1, mu2]*IndexDelta[s1, s3] + ztilde*Ga[mu1, s1, s2]*Ga[mu2, s2, s3])*
      ChiVielbeinV[mu2, i1]*Nucleons[s3][[r1]], {r1, 1, 2}, {i1, 1, 3}]
  + HC[Sum[Deltabar[s1, mu1, r1, i1]*
      (ME[mu1, mu2]*IndexDelta[s1, s3] + ztilde*Ga[mu1, s1, s2]*Ga[mu2, s2, s3])*
      ChiVielbeinV[mu2, i1]*Nucleons[s3][[r1]], {r1, 1, 2}, {i1, 1, 3}]]];

(* -------------------------------- pi N Delta, gauge-invariant (Pascalutsa) --- *)
(*  Strong term of Fernandez-Ramirez et al. Eq. (36),                            *)
(*     -(h / (fPi Mstar)) Nbar eps_{mu nu lam beta} gamma^beta gamma5            *)
(*                          (d^mu Delta^nu_j)(d^lam pi_j)                        *)
(*  With ChiVielbeinV[lam, j] = -(1/fPi) d^lam pi_j at leading order and the GL  *)
(*  prefactor +hD/MDelta, this has the sign as written in the paper.  Whether    *)
(*  the paper's eps and gamma5 conventions match FeynRules' is not checked; the  *)
(*  Born/Delta relative sign is what Fig. 33 tests, and it is unaffected.        *)

LPiNDeltaGI := (hD/MDelta)*Block[{mu, nu, lam, si, s1, s2, s3},
  Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinV[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]
  + HC[Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinV[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]]];


(* ---------------------------------- gamma N Delta, gauge-invariant coupling -- *)
(*  Kappa Nbar [ i G1 Ftilde_{mu nu} + G2 gamma5 F_{mu nu} ] d^mu Delta^nu_3     *)
(*  + HC,  Kappa = 3e / (2 M (M + Mstar)) -- Eq. (36) of nucl-th/0509020v2.      *)
(*  Delta[..., 3] carries the sqrt(2/3) isospin factor automatically through the *)
(*  R[5] definitions, so no explicit Clebsch-Gordan factor belongs here.  (The   *)
(*  hand-written notebook Delta-Analytic-Calculations/"gamma+p into pi0 p        *)
(*  photoproduction.nb" DROPS that sqrt(2/3) on this vertex while keeping it on  *)
(*  the strong one, which is why it overshoots by a factor 3/2 in the cross      *)
(*  section.)                                                                    *)

LGammaNDelta := Kappa*Block[{s1, s2, mu, nu},
  Sum[Nucleonsbar[s1][[r1]]*
      (I*G1*IndexDelta[s1, s2]*DualEMStrengthTensor[mu, nu]
       + G2*Ga[5, s1, s2]*EMStrengthTensor[mu, nu])*del[Delta[s2, nu, r1, 3], mu],
    {r1, 1, 2}]
  + HC[Sum[Nucleonsbar[s1][[r1]]*
      (I*HC[G1]*IndexDelta[s1, s2]*DualEMStrengthTensor[mu, nu]
       + HC[G2]*Ga[5, s1, s2]*EMStrengthTensor[mu, nu])*del[Delta[s2, nu, r1, 3], mu],
    {r1, 1, 2}]]];

(* ---------------------- the same term, made ISOVECTOR (CVC) ----------------- *)
(*  Identical to LGammaNDelta except that the photon field strength and the      *)
(*  hard-coded Delta isospin index 3 are replaced by the isovector source and a  *)
(*  sum over i -- see the note at IsoVecSource.  Because IsoVecSource[mu,3]      *)
(*  contains the photon with coefficient exactly 1, the i = 3 photon piece is    *)
(*  bit-for-bit the old term: gamma N -> Delta, and therefore the Fig. 33        *)
(*  photoproduction fit, is untouched.  What is NEW is everything else in the    *)
(*  triplet -- the W and Z vector N -> Delta transitions that gauging alone      *)
(*  never produced, with their strengths fixed by CVC from the SAME g1, g2 that  *)
(*  photoproduction already determined.  No new parameters.                      *)
LWeakNDeltaV := Kappa*Block[{s1, s2, mu, nu},
  FFVNDA*Sum[Nucleonsbar[s1][[r1]]*
      (I*G1*IndexDelta[s1, s2]*DualIsoStrengthTensor[mu, nu, i1]
       + G2*Ga[5, s1, s2]*IsoStrengthTensor[mu, nu, i1])*del[Delta[s2, nu, r1, i1], mu],
    {r1, 1, 2}, {i1, 1, 3}]
  + FFVNDB*HC[Sum[Nucleonsbar[s1][[r1]]*
      (I*HC[G1]*IndexDelta[s1, s2]*DualIsoStrengthTensor[mu, nu, i1]
       + HC[G2]*Ga[5, s1, s2]*IsoStrengthTensor[mu, nu, i1])*del[Delta[s2, nu, r1, i1], mu],
    {r1, 1, 2}, {i1, 1, 3}]]];


(* ------------------------------- Delta vertices with form factors ----------- *)
(*  Same Lagrangians as LPiNDeltaGI / LGammaNDelta, with one form factor symbol *)
(*  multiplying each of the two hermitian-conjugate halves.  They REPLACE the   *)
(*  point-like versions in LChiPT when ChiPT$DeltaFF is True -- they are not    *)
(*  additive corrections like LNNEMFF.                                          *)
(*                                                                              *)
(*  FFPNDA/FFPNDB land on every vertex the gauged strong term produces, i.e. on *)
(*  the three-point pi-N-Delta vertices AND on the contact vertices that share  *)
(*  its coupling: Delta~ N A pi (the Delta-sector Kroll-Ruderman term) and the  *)
(*  W/Z ones, including the three-point weak N -> Delta transition currents     *)
(*  that come from the gauge part of ChiVielbeinV.  That is deliberate: they    *)
(*  all carry the same strong vertex and the same Delta leg, whose momentum     *)
(*  squared is what FpiNDelta is a function of, and splitting the pion piece    *)
(*  off the gauge pieces of the vielbein would break gauge invariance.  If the  *)
(*  weak transition current is meant to carry its own (axial) form factor       *)
(*  instead, it needs its own Lagrangian term, not this one.                    *)
(*                                                                              *)
(*  FeynRules will warn "Form factor FFPNDA appears in more than one vertex"    *)
(*  and print the list.  That is expected and harmless HERE: the warning        *)
(*  guards a momentum-relabelling step that only acts on symbolic values, and   *)
(*  these values are strings, which the relabeller cannot touch.  What it does  *)
(*  mean is that the leg index in the string has to be right in EVERY vertex    *)
(*  the symbol reaches -- verified in the exported UFO, see the checks in       *)
(*  export_ChiPT_UFO.m.                                                         *)

LPiNDeltaGIFF := (hD/MDelta)*Block[{mu, nu, lam, si, s1, s2, s3},
  FFPNDA*Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinV[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]
  + FFPNDB*HC[Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinV[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]]];

(*  The r1 sum runs over {Proton, Neutron}, so {FFDPxxA, FFDNxxA}[[r1]] hands   *)
(*  each charge state its own symbol; G1 and G2 are separated the same way.     *)
(*  The B symbols stay OUTSIDE HC[] so that no Conjugate[] can ever be wrapped  *)
(*  round a form factor -- HC[G1]/HC[G2] inside are kept exactly as in          *)
(*  LGammaNDelta so the two Lagrangians differ by nothing but the symbols.      *)
LGammaNDeltaFF := Kappa*Block[{s1, s2, mu, nu},
  Sum[{FFDPG1A, FFDNG1A}[[r1]]*Nucleonsbar[s1][[r1]]*
      I*G1*IndexDelta[s1, s2]*DualEMStrengthTensor[mu, nu]*
      del[Delta[s2, nu, r1, 3], mu], {r1, 1, 2}]
  + Sum[{FFDPG2A, FFDNG2A}[[r1]]*Nucleonsbar[s1][[r1]]*
      G2*Ga[5, s1, s2]*EMStrengthTensor[mu, nu]*
      del[Delta[s2, nu, r1, 3], mu], {r1, 1, 2}]
  + Sum[{FFDPG1B, FFDNG1B}[[r1]]*HC[Nucleonsbar[s1][[r1]]*
      I*HC[G1]*IndexDelta[s1, s2]*DualEMStrengthTensor[mu, nu]*
      del[Delta[s2, nu, r1, 3], mu]], {r1, 1, 2}]
  + Sum[{FFDPG2B, FFDNG2B}[[r1]]*HC[Nucleonsbar[s1][[r1]]*
      HC[G2]*Ga[5, s1, s2]*EMStrengthTensor[mu, nu]*
      del[Delta[s2, nu, r1, 3], mu]], {r1, 1, 2}]];


(* ------------------------------------------------------------ totals -------- *)

(*  IMPORTANT -- each piece is forced to an explicit expression BEFORE summing.    *)
(*  Writing this as the bare sum of the eight delayed symbols,                     *)
(*      LChiPT := LPionKin + LNucleonKin + ... + LGammaNDelta;                     *)
(*  silently destroys the whole Delta sector: FeynmanRules then returns 17         *)
(*  vertices, NONE of them containing a Delta, where the sequential form below     *)
(*  gives 58 vertices of which 41 contain a Delta.  Every partial sum (any pair,   *)
(*  any subset tried) behaves correctly, so this only bites on the full sum.       *)
(*  export_UFO_myPions.nb never hit it because it assigned each Lagrangian to a    *)
(*  variable first and summed the variables -- which is what is reproduced here.   *)
LChiPT := Module[{lpk, lnk, lnv, lna, ldk1, ldk2, ldk3, ldk4, ldp1, ldp2, ldp3,
                  lpg, lgd, lff, lwf},
  lpk = LPionKin;     lnk = LNucleonKin;  lnv = LNNVector;   lna = LNNAxial;
  ldk1 = LDeltaKin1;  ldk2 = LDeltaKin2;  ldk3 = LDeltaKin3; ldk4 = LDeltaKin4;
  ldp1 = LDeltaPi1;   ldp2 = LDeltaPi2;   ldp3 = LDeltaPi3;
  lpg = If[ChiPT$WeakFF, LPiNDeltaGIWeakFF,
        If[ChiPT$DeltaFF, LPiNDeltaGIFF,  LPiNDeltaGI]];
  lgd = If[ChiPT$WeakFF, LWeakNDeltaV,
        If[ChiPT$DeltaFF, LGammaNDeltaFF, LGammaNDelta]];
  lff = If[ChiPT$NucleonFF, LNNEMFF, 0];
  lwf = If[ChiPT$WeakFF, LNNWeakCCFF + LNNWeakNCFF + LNNCTFF + LPFFF
                       + LC4ANDelta + LNNPPFF + LC6ANDelta + LPPoleFF, 0];
  (* LPiNDelta (the conventional gD coupling) is deliberately EXCLUDED: it is
     not gauge invariant, and the Pascalutsa coupling LPiNDeltaGI replaces it.
     Its definition is kept above for reference only. *)
  lpk + lnk + lnv + lna + ldk1 + ldk2 + ldk3 + ldk4 + ldp1 + ldp2 + ldp3
      + lpg + lgd + lff + lwf];

LTotal := Module[{lchi, lsm}, lchi = LChiPT; lsm = LSM; lchi + lsm];

(* Kept for backwards compatibility with export_UFO_myPions.nb *)
LSMnu := LSM + LPionKin;

Rarita\[CapitalDelta]\[Pi]     := LDeltaSector;
Rarita\[Pi]N\[CapitalDelta]    := LPiNDelta;
Rarita\[Pi]N\[CapitalDelta]GI  := LPiNDeltaGI;
Rarita\[Gamma]N\[CapitalDelta] := LGammaNDelta;

(* Export with:
     LoadModel["ChiPT.fr"];
     WriteUFO[LTotal, AddDecays -> False, FlavorExpand -> True];
*)
