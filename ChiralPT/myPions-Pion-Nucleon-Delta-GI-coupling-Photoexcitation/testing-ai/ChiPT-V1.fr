  S[6] == {
    ClassName        -> Pion,
    Unphysical       -> True,
    SelfConjugate    -> True,
    Indices          -> {Index[SU2W]},
    FlavorIndex      -> SU2W,
    Definitions      -> { Pion[1] -> (PiP+PiPbar)/Sqrt[2], Pion[2] -> (PiPbar-PiP)/(I*Sqrt[2]), Pion[3] -> Pi0}
  },
  S[7] == {
    ClassName        -> Eta,
    SelfConjugate    -> True,
    Mass             -> {MEta, 0.547862},
    Width            -> {WEta, 0.0},
    PropagatorLabel  -> "Eta",
    PropagatorType   -> D,
    PropagatorArrow  -> None,
    PDG              -> 221,
    ParticleName     -> "Eta",
    FullName         -> "Eta"
  },
  S[8] == {
    ClassName        -> K0,
    SelfConjugate    -> False,
    Mass             -> {MK0, 0.497611},
    Width            -> {WK0, 0.0},
    PropagatorLabel  -> "K0",
    PropagatorType   -> D,
    PropagatorArrow  -> None,
    PDG              -> 311,
    ParticleName     -> "K0",
    AntiParticleName -> "K0~",
    FullName         -> "K0"
  },
  S[9] == {
    ClassName        -> Kp,
    SelfConjugate    -> False,
    Mass             -> {MKp, 0.493677},
    Width            -> {WKp, 0.0},
    QuantumNumbers   -> {Q -> 1},
    PropagatorLabel  -> "Kp",
    PropagatorType   -> D,
    PropagatorArrow  -> None,
    PDG              -> 321,
    ParticleName     -> "K+",
    AntiParticleName -> "K-",
    FullName         -> "K+"
  },

  (* Delta Baryons.  The unphysical R[5] carries an isospinor index (IsoSpin)
     and an isovector index (IsoVector); the embedding below satisfies the
     spin-3/2 isospin constraint tau_i Delta_i = 0 and is canonically
     normalised (sum of |coefficient|^2 = 1 for every charge state). *)
  R[1] == {
    ClassName        -> DeltaPP,
    SelfConjugate    -> False,
    Mass             -> {MDelta, 1.209},
    Width            -> {WDeltaPP, 0.102},
    QuantumNumbers   -> {Q -> 2, BaryonNumber -> 1, Y -> 1},
    PropagatorLabel  -> "D++",
    PropagatorType   -> S,
    PropagatorArrow  -> Forward,
    PDG              -> 2224,
    ParticleName     -> "Delta++",
    AntiParticleName -> "Delta++~",
    FullName         -> "Delta++"
  },
  R[2] == {
    ClassName        -> DeltaP,
    SelfConjugate    -> False,
    Mass             -> {MDelta, 1.209},
    Width            -> {WDeltaP, 0.102},
    QuantumNumbers   -> {Q -> 1, BaryonNumber -> 1, Y -> 1},
    PropagatorLabel  -> "D+",
    PropagatorType   -> S,
    PropagatorArrow  -> Forward,
    PDG              -> 2214,
    ParticleName     -> "Delta+",
    AntiParticleName -> "Delta+~",
    FullName         -> "Delta+"
  },
  R[3] == {
    ClassName        -> Delta0,
    SelfConjugate    -> False,
    Mass             -> {MDelta, 1.209},
    Width            -> {WDelta0, 0.102},
    QuantumNumbers   -> {Q -> 0, BaryonNumber -> 1, Y -> 1},
    PropagatorLabel  -> "D0",
    PropagatorType   -> S,
    PropagatorArrow  -> Forward,
    PDG              -> 2114,
    ParticleName     -> "Delta0",
    AntiParticleName -> "Delta0~",
    FullName         -> "Delta0"
  },
  R[4] == {
    ClassName        -> DeltaM,
    SelfConjugate    -> False,
    Mass             -> {MDelta, 1.209},
    Width            -> {WDeltaM, 0.102},
    QuantumNumbers   -> {Q -> -1, BaryonNumber -> 1, Y -> 1},
    PropagatorLabel  -> "D-",
    PropagatorType   -> S,
    PropagatorArrow  -> Forward,
    PDG              -> 1114,
    ParticleName     -> "Delta-",
    AntiParticleName -> "Delta-~",
    FullName         -> "Delta-"
  },
  R[5] == {
    ClassName        -> Delta,
    Unphysical       -> True,
    SelfConjugate    -> False,
    Indices          -> {Index[IsoSpin], Index[IsoVector]},
    FlavorIndex      -> IsoVector,
    Definitions      -> { Delta[sp_, mu_, 1, 1] -> (1/Sqrt[2])*((1/Sqrt[3])*Delta0[sp, mu]-DeltaPP[sp, mu]),
                          Delta[sp_, mu_, 2, 1] -> (1/Sqrt[2])*(-(1/Sqrt[3])*DeltaP[sp, mu] + DeltaM[sp, mu]),
                          Delta[sp_, mu_, 1, 2] -> (-I/Sqrt[2])*((1/Sqrt[3])*Delta0[sp, mu] + DeltaPP[sp, mu]),
                          Delta[sp_, mu_, 2, 2] -> (-I/Sqrt[2])*((1/Sqrt[3])*DeltaP[sp, mu] + DeltaM[sp, mu]),
                          Delta[sp_, mu_, 1, 3] -> Sqrt[2/3]*DeltaP[sp, mu],
                          Delta[sp_, mu_, 2, 3] -> Sqrt[2/3]*Delta0[sp, mu]}
  }
};

(* *************************** *)
(* *****   FormFactors   ***** *)
(* *************************** *)

(* Kept commented out, as in myPions.fr.  The export notebook's
   PhotonFormFactorRules / WFormFactorRules / ZFormFactorRules substitute these
   in by hand after the Lagrangian is built. *)

M$FormFactors = Join[If[ChiPT$NucleonFF,
  {
    (* Nucleon electromagnetic form factors, as functions of Q^2 = -q^2 where q is
       the photon momentum (external leg 3 of the gamma-N-N vertex).

       All four are the FULL form factors.  LNNVector already generates the
       POINT-LIKE proton coupling + ee A^mu pbar gamma_mu p (verified:
       Vertex(p~ p A) = +I ee Ga[mu]), so LNNEMFF below carries the combination
       (FF1PA - 1).  The -1 is an ordinary number, so FeynRules routes it to the
       COUPLING, where it cancels the point-like contribution exactly, leaving a
       single Lorentz structure F1p*Gamma rather than the unsimplifiable
       Gamma + (F1p - 1)*Gamma.  (FeynRules cannot collapse the latter: the form
       factor value is a raw Python string, so 1 + (F1p - 1) can never be
       simplified symbolically -- it had to be hand-edited before.)
       The neutron has no point-like coupling, so FF1NA is the full F1n.
       The downstream generator must supply F1p, F1n, F2p, F2n. *)
    FF1PA == {
        Particles        -> {Protonbar, Proton, A},
        ComplexParameter -> False,
        Value            -> "F1p(-P(-1,3)**2)",
        ParameterName    -> FF1PA
    },
    FF1NA == {
        Particles        -> {Neutronbar, Neutron, A},
        ComplexParameter -> False,
        Value            -> "F1n(-P(-1,3)**2)",
        ParameterName    -> FF1NA
    },
    FF2PA == {
        Particles        -> {Protonbar, Proton, A},
        ComplexParameter -> False,
        Value            -> "F2p(-P(-1,3)**2)",
        ParameterName    -> FF2PA
    },
    FF2NA == {
        Particles        -> {Neutronbar, Neutron, A},
        ComplexParameter -> False,
        Value            -> "F2n(-P(-1,3)**2)",
        ParameterName    -> FF2NA
    }
  }, {}],

  (* ---------------------------- Delta(1232) form factors ------------------- *)
  (*  Only included when ChiPT$FormFactors is "Delta" or "All".                 *)
  (*                                                                            *)
  (*  WHAT FIG. 33 ACTUALLY PUTS ON THE DELTA (Fig33v2.m, Eqs. (44)-(47)):      *)
  (*    (a) ONE factor sqrt(X_pi(s,u)) per Delta diagram, X_pi(s,u) =           *)
  (*        X(s) + X(u) - X(s)X(u),  X(l) = 2 r^3/(1+r^5),  r = k(l)/k(M_D^2),  *)
  (*        k the pi-N cm momentum at invariant mass^2 = l, and X(l) = 0 below  *)
  (*        the pi-N threshold.  It sits on the STRONG vertex.                  *)
  (*    (b) an energy-dependent width Gamma(s,u) = Gamma_Delta X_pi(s,u) in     *)
  (*        BOTH Delta propagators.                                             *)
  (*    (c) NOTHING on the gamma-N-Delta vertex -- Fig. 33 is real-photon       *)
  (*        photoproduction, so any Q^2 dependence there is invisible to it.    *)
  (*                                                                            *)
  (*  WHAT SURVIVES THE TRANSLATION TO A UFO FORM FACTOR.  A UFO form factor is *)
  (*  a function of ONE vertex's own momenta, so X_pi(s,u) -- which mixes the   *)
  (*  Mandelstams of two different diagrams -- is not a vertex-level object.    *)
  (*  The vertex-level object is X_pi(p_Delta^2), the Delta leg's own invariant *)
  (*  mass squared.  The two agree exactly on the s-channel diagram, because    *)
  (*  X_pi(u) = 0 identically over the whole physical region of gamma N -> pi N *)
  (*  (u <= (M_N - m_pi)^2 < (M_N + m_pi)^2, checked numerically on the Fig. 33 *)
  (*  grid), so X_pi(s,u) = X_pi(s) there.  They differ on the u-channel Delta, *)
  (*  which Fig. 33 damps by sqrt(X_pi(s)) but a vertex form factor removes       *)
  (*  outright.  Measured on sigma_tot(Born+Delta), that costs                  *)
  (*      pi0 p : +2% at the peak, +11% at 0.6 GeV, +1% at 1.0 GeV             *)
  (*      pi+ n : +2%,  +17%,  +15%      pi- p : +1%,  +9%,  +12%              *)
  (*  against the ~3.2x error at 1 GeV that comes from having no Delta form     *)
  (*  factor at all.  Item (b), the running width, is NOT a form factor and     *)
  (*  cannot be routed through this mechanism at all; on its own it is a ~3%    *)
  (*  effect at the peak.  See the "scheme" scan in the session notes.          *)
  (*                                                                            *)
  (*  The generator supplies FpiNDelta(s) and the four FgNDelta*(Q^2).  To      *)
  (*  match Fig. 33 set FpiNDelta(s) = sqrt(X_pi(s)) and leave every            *)
  (*  FgNDelta* = 1: the gamma-N-Delta form factors are a genuinely new object  *)
  (*  (the N -> Delta electromagnetic transition form factors) that real-photon *)
  (*  photoproduction cannot see.  They are split G1/G2 and proton/neutron      *)
  (*  because those are four independent functions -- G1 multiplies the         *)
  (*  magnetic (dual field strength) term and G2 the electric one.              *)
  (*                                                                            *)
  (*  NB these MULTIPLY the fitted couplings G1 = 6.061 and G2 = 2.414, so a    *)
  (*  form factor normalised to 1 at Q^2 = 0 leaves the Fig. 33 comparison      *)
  (*  untouched.  Achilles (branch sherpa3-0, src/plugins/Sherpa/FormFactors.cc)*)
  (*  already registers FDeltaPG1 = Gep + Gmp, FDeltaPG2 = 2 Gep (M+MD)/(M-MD), *)
  (*  FDeltaNG1, FDeltaNG2 -- but those are REPLACEMENTS for the coupling, not  *)
  (*  multipliers: FDeltaPG1(0) = 1 + mu_p = 3.79, not 1.  Wiring the names     *)
  (*  here to those IDs would silently rescale the vertex by that factor, so    *)
  (*  new IDs are used instead; if you do want the Sachs parameterisation,      *)
  (*  rescale G1 and G2 in the param card to compensate.                        *)
  (*                                                                            *)
  (*  TWO SYMBOLS PER VERTEX TYPE, because the value is a raw Python string     *)
  (*  that FeynRules splices into the Lorentz structure verbatim -- the leg     *)
  (*  index in it is NEVER relabelled (RelabelFormFactorExt applies replacement *)
  (*  rules, which do nothing to a String).  So the index has to be written for *)
  (*  the ordering the UFO ends up with, and the UFO is all-OUTGOING, which     *)
  (*  reverses the naive reading of the Lagrangian:                             *)
  (*     Deltabar ... N  term  ->  vertices  N~ Delta X   : Delta at leg 2      *)
  (*     its h.c.              ->  vertices  Delta~ N X   : Delta at leg 1      *)
  (*  (structures FRS1/FRV1/FRVS1 and RFS1/RFV1/RFVS1 respectively).  Getting   *)
  (*  this backwards is silent -- it evaluates the form factor on the NUCLEON   *)
  (*  leg, whose p^2 is a fixed M_N^2 for an external nucleon.  The photon sits *)
  (*  at leg 3 in both orderings, so FFGNDA and FFGNDB share one string.        *)
  (*  Dummy index -9 keeps it clear of the -1..-4 already contracted inside the *)
  (*  Lorentz structures.                                                       *)
  If[ChiPT$DeltaFF,
  {
    FFPNDA == {
        Particles        -> {DeltaPbar, Proton, Pi0},
        ComplexParameter -> False,
        Value            -> "FpiNDelta(P(-9,2)**2)",
        ParameterName    -> FFPNDA
    },
    FFPNDB == {
        Particles        -> {Protonbar, DeltaP, Pi0},
        ComplexParameter -> False,
        Value            -> "FpiNDelta(P(-9,1)**2)",
        ParameterName    -> FFPNDB
    },
    FFDPG1A == {
        Particles        -> {Protonbar, DeltaP, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaPG1(-P(-9,3)**2)",
        ParameterName    -> FFDPG1A
    },
    FFDPG2A == {
        Particles        -> {Protonbar, DeltaP, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaPG2(-P(-9,3)**2)",
        ParameterName    -> FFDPG2A
    },
    FFDNG1A == {
        Particles        -> {Neutronbar, Delta0, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaNG1(-P(-9,3)**2)",
        ParameterName    -> FFDNG1A
    },
    FFDNG2A == {
        Particles        -> {Neutronbar, Delta0, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaNG2(-P(-9,3)**2)",
        ParameterName    -> FFDNG2A
    },
    FFDPG1B == {
        Particles        -> {DeltaPbar, Proton, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaPG1(-P(-9,3)**2)",
        ParameterName    -> FFDPG1B
    },
    FFDPG2B == {
        Particles        -> {DeltaPbar, Proton, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaPG2(-P(-9,3)**2)",
        ParameterName    -> FFDPG2B
    },
    FFDNG1B == {
        Particles        -> {Delta0bar, Neutron, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaNG1(-P(-9,3)**2)",
        ParameterName    -> FFDNG1B
    },
    FFDNG2B == {
        Particles        -> {Delta0bar, Neutron, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaNG2(-P(-9,3)**2)",
        ParameterName    -> FFDNG2B
    }
  }, {}],

  (* ----------------------------- weak-sector form factors ------------------ *)
  (*  Only included when ChiPT$FormFactors is "Weak" or "All".                  *)
  (*                                                                            *)
  (*  All of these are functions of Q^2 = -q^2 with q the GAUGE BOSON momentum,  *)
  (*  and in every vertex they reach the boson is leg 3 -- the two hermitian     *)
  (*  conjugate halves put the nucleon and the Delta at legs 1 and 2 in either   *)
  (*  order but never displace the boson -- so the A and B symbols share one     *)
  (*  string, exactly as FFDPG1A/FFDPG1B do.  Dummy index -9 again keeps clear   *)
  (*  of the -1..-4 contracted inside the Lorentz structures.                    *)
  (*                                                                            *)
  (*  WHICH ARE RATIOS AND WHICH ARE NOT.  FW1, FWA, FZ1n and FZA are 1 at       *)
  (*  Q^2 = 0 and multiply a coupling the model already has, so they change      *)
  (*  nothing at the photon point.  FZ1p is NOT 1 there: it also carries the     *)
  (*  shift of sin^2(theta_W) from the model's tree-level on-shell value to the  *)
  (*  Q -> 0 one, a factor 0.30, because the proton's weak vector charge         *)
  (*  1/2 - 2 sw^2 sits near a zero.  FW2, FZ2p and FZ2n are absolute: the model *)
  (*  has no point-like weak magnetism at all, so those operators are new and    *)
  (*  carry their own normalisation, which CVC fixes from the electromagnetic    *)
  (*  F2's.  See formfactors.py, which defines all of them.                      *)
  If[ChiPT$WeakFF,
  {
    FFW1A == {
        Particles        -> {Protonbar, Neutron, W},
        ComplexParameter -> False,
        Value            -> "FW1(-P(-9,3)**2)",
        ParameterName    -> FFW1A
    },
    FFW1B == {
        Particles        -> {Neutronbar, Proton, Wbar},
        ComplexParameter -> False,
        Value            -> "FW1(-P(-9,3)**2)",
        ParameterName    -> FFW1B
    },
    FFWAA == {
        Particles        -> {Protonbar, Neutron, W},
        ComplexParameter -> False,
        Value            -> "FWA(-P(-9,3)**2)",
        ParameterName    -> FFWAA
    },
    FFWAB == {
        Particles        -> {Neutronbar, Proton, Wbar},
        ComplexParameter -> False,
        Value            -> "FWA(-P(-9,3)**2)",
        ParameterName    -> FFWAB
    },
    FFW2A == {
        Particles        -> {Protonbar, Neutron, W},
        ComplexParameter -> False,
        Value            -> "FW2(-P(-9,3)**2)",
        ParameterName    -> FFW2A
    },
    FFW2B == {
        Particles        -> {Neutronbar, Proton, Wbar},
        ComplexParameter -> False,
        Value            -> "FW2(-P(-9,3)**2)",
        ParameterName    -> FFW2B
    },
    (* Induced pseudoscalar.  A NEW operator -- the model has no point-like
       q^mu gamma5 piece at all -- so this is a bare form factor, exactly like
       FFW2A/B, not an (FF - 1) correction to something already there. *)
    FFPPA == {
        Particles        -> {Protonbar, Neutron, W},
        ComplexParameter -> False,
        Value            -> "FPP(-P(-9,3)**2)",
        ParameterName    -> FFPPA
    },
    FFPPB == {
        Particles        -> {Neutronbar, Proton, Wbar},
        ComplexParameter -> False,
        Value            -> "FPP(-P(-9,3)**2)",
        ParameterName    -> FFPPB
    },
    (* C6A, the Delta's induced pseudoscalar.  Dimension 1/mass^2, since the
       operator carries two derivatives of the source -- that is the 1/MN^2 of
       the standard C6A parameterisation. *)
    FFC6AA == {
        Particles        -> {Neutronbar, DeltaP, W},
        ComplexParameter -> False,
        Value            -> "FC6A(-P(-9,3)**2)",
        ParameterName    -> FFC6AA
    },
    FFC6AB == {
        Particles        -> {DeltaPbar, Neutron, Wbar},
        ComplexParameter -> False,
        Value            -> "FC6A(-P(-9,3)**2)",
        ParameterName    -> FFC6AB
    },
    FFPPZP == {
        Particles        -> {Protonbar, Proton, Z},
        ComplexParameter -> False,
        Value            -> "FPPZ(-P(-9,3)**2)",
        ParameterName    -> FFPPZP
    },
    FFPPZN == {
        Particles        -> {Neutronbar, Neutron, Z},
        ComplexParameter -> False,
        Value            -> "FPPZ(-P(-9,3)**2)",
        ParameterName    -> FFPPZN
    },
    FFZ1P == {
        Particles        -> {Protonbar, Proton, Z},
        ComplexParameter -> False,
        Value            -> "FZ1p(-P(-9,3)**2)",
        ParameterName    -> FFZ1P
    },
    FFZ1N == {
        Particles        -> {Neutronbar, Neutron, Z},
        ComplexParameter -> False,
        Value            -> "FZ1n(-P(-9,3)**2)",
        ParameterName    -> FFZ1N
    },
    FFZAP == {
        Particles        -> {Protonbar, Proton, Z},
        ComplexParameter -> False,
        Value            -> "FZA(-P(-9,3)**2)",
        ParameterName    -> FFZAP
    },
    FFZAN == {
        Particles        -> {Neutronbar, Neutron, Z},
        ComplexParameter -> False,
        Value            -> "FZA(-P(-9,3)**2)",
        ParameterName    -> FFZAN
    },
    FFZ2P == {
        Particles        -> {Protonbar, Proton, Z},
        ComplexParameter -> False,
        Value            -> "FZ2p(-P(-9,3)**2)",
        ParameterName    -> FFZ2P
    },
    FFZ2N == {
        Particles        -> {Neutronbar, Neutron, Z},
        ComplexParameter -> False,
        Value            -> "FZ2n(-P(-9,3)**2)",
        ParameterName    -> FFZ2N
    },
    FFCA5A == {
        Particles        -> {Neutronbar, DeltaP, W},
        ComplexParameter -> False,
        Value            -> "FCA5(-P(-9,3)**2)",
        ParameterName    -> FFCA5A
    },
    FFCA5B == {
        Particles        -> {DeltaPbar, Neutron, Wbar},
        ComplexParameter -> False,
        Value            -> "FCA5(-P(-9,3)**2)",
        ParameterName    -> FFCA5B
    },
    (* The CVC vector N->Delta dipole.  LWeakNDeltaV covariantises the PHOTON
       vertex, whose FgNDelta* form factors are identically 1, so the vector
       transition had no Q^2 damping at all and the Delta term ran away above
       ~1 GeV.  These sit on the G1/G2 structures; FFCA5A/B stay on the axial
       C5A and C4A ones, one form factor per Lorentz structure as required. *)
    FFVNDA == {
        Particles        -> {Neutronbar, DeltaP, W},
        ComplexParameter -> False,
        Value            -> "FVND(-P(-9,3)**2)",
        ParameterName    -> FFVNDA
    },
    FFVNDB == {
        Particles        -> {DeltaPbar, Neutron, Wbar},
        ComplexParameter -> False,
        Value            -> "FVND(-P(-9,3)**2)",
        ParameterName    -> FFVNDB
    },
    (* CVC on the background.  Each of these reaches MANY vertices -- the
       contact term now covers gamma, Z and W in every charge state, and the
       pion-in-flight covers boson-pi-pi and boson-3pi -- so `Particles' names
       only one representative.  That is harmless: FeynRules uses the list to
       relabel leg indices inside `Value', and `Value' here is a raw Python
       STRING, which no relabelling can touch.  What matters instead is that
       the named leg is the gauge boson in EVERY vertex the symbol reaches:
       leg 3 for the four-point contact (f f V S) and leg 1 for the
       pion-in-flight (V S S, V S S S).  export_ChiPT_UFO.m checks that for
       every form factor in the build, not just the Delta ones -- a wrong leg
       is otherwise completely silent.

       FFW1CT sits on the Kroll-Ruderman (gamma^mu gamma5) half and FFRHOCT on
       the Weinberg-Tomozawa (gamma^mu) half, NOT the other way round; see the
       note at LNNCTFF. *)
    FFW1CT == {
        Particles        -> {Neutronbar, Proton, W, Pi0},
        ComplexParameter -> False,
        Value            -> "FW1(-P(-9,3)**2)",
        ParameterName    -> FFW1CT
    },
    FFRHOCT == {
        Particles        -> {Neutronbar, Proton, W, Pi0},
        ComplexParameter -> False,
        Value            -> "FrhoCT(-P(-9,3)**2)",
        ParameterName    -> FFRHOCT
    },
    FFW1PF == {
        Particles        -> {W, Pi0, PiP},
        ComplexParameter -> False,
        Value            -> "FW1(-P(-9,1)**2)",
        ParameterName    -> FFW1PF
    },
    (* The Z's own versions of the two above.  FZ1pi = F1V (1-2 Sw2FF) /
       (1-2 sw^2_model); see the note at ChiPTZOnly.  Same legs: 3 for the
       contact, 1 for the pion-in-flight. *)
    FFZ1CT == {
        Particles        -> {Protonbar, Neutron, Z, PiP},
        ComplexParameter -> False,
        Value            -> "FZ1pi(-P(-9,3)**2)",
        ParameterName    -> FFZ1CT
    },
    FFZ1PF == {
        Particles        -> {Z, PiP, PiPbar},
        ComplexParameter -> False,
        Value            -> "FZ1pi(-P(-9,1)**2)",
        ParameterName    -> FFZ1PF
    },
    (* The pion pole, LPPoleFF.  Boson on leg 3, pion on leg 4, the same order
       as the contact term above -- because these vertices ARE the contact
       term's: same four particles, so FeynRules merges the new structures into
       the existing V_13 etc. and the whole operator adds no new vertex at all.
       Do not read the leg number off the operator in isolation: run alone,
       LPPoleFF produces (Nbar, N, pi, V) and leg 4 is the boson; merged into
       the full Lagrangian the order is the contact term's and leg 4 is the
       PION.  Using it would evaluate the propagator at the pion's momentum --
       a perfectly finite wrong answer, which is why export_ChiPT_UFO.m checks
       the spin of every form factor's leg and why it caught this one.
       These two carry the pion PROPAGATOR rather than a ratio: dimension
       1/mass^2, with the compensating mass^2 in the operator's own
       derivatives.  Charged and neutral are separate entries because the pole
       masses differ. *)
    FFPPPIW == {
        Particles        -> {Protonbar, Neutron, W, Pi0},
        ComplexParameter -> False,
        Value            -> "FPPpi(-P(-9,3)**2)",
        ParameterName    -> FFPPPIW
    },
    FFPPPIZ == {
        Particles        -> {Protonbar, Neutron, Z, PiP},
        ComplexParameter -> False,
        Value            -> "FPPZpi(-P(-9,3)**2)",
        ParameterName    -> FFPPPIZ
    }
  }, {}]];


(* ************************** *)
(* *****     Gauge      ***** *)
(* *****   Parameters   ***** *)
(* *****   (FeynArts)   ***** *)
(* ************************** *)

GaugeXi[ V[1]  ] = GaugeXi[A];
GaugeXi[ V[2]  ] = GaugeXi[Z];
GaugeXi[ V[3]  ] = GaugeXi[W];
GaugeXi[ S[1]  ] = 1;
GaugeXi[ S[2]  ] = GaugeXi[Z];
GaugeXi[ S[3]  ] = GaugeXi[W];
GaugeXi[ U[1]  ] = GaugeXi[A];
GaugeXi[ U[2]  ] = GaugeXi[Z];
GaugeXi[ U[31] ] = GaugeXi[W];
GaugeXi[ U[32] ] = GaugeXi[W];


