(* ****************************************************************************** *)
(* ***                                                                        *** *)
(* ***   FeynRules implementation of the Effective Lagrangian Approach (ELA)   ** *)
(* ***   to pion photoproduction from the nucleon                             *** *)
(* ***                                                                        *** *)
(* ***   C. Fernandez-Ramirez, E. Moya de Guerra, J.M. Udias,                 *** *)
(* ***   "Effective Lagrangian Approach to pion photoproduction from the       ** *)
(* ***    nucleon", nucl-th/0509020v2 (Annals Phys. 321 (2006) 1408)          *** *)
(* ***                                                                        *** *)
(* ***   Equation numbers in the comments below refer to that paper.          *** *)
(* ***                                                                        *** *)
(* ****************************************************************************** *)

(* ------------------------------------------------------------------------------ *)
(*  Contents                                                                       *)
(*                                                                                 *)
(*    * Born terms                          Eq. (14)  -> LBorn                     *)
(*    * omega and rho exchange              Eq. (15), (16) -> LOmega, LRho         *)
(*    * N(1440)  P11  (spin 1/2, iso 1/2)   Eq. (22)  -> LP11                      *)
(*    * N(1535)  S11  (spin 1/2, iso 1/2)   Eq. (17)  -> LS11a                     *)
(*    * N(1650)  S11  (spin 1/2, iso 1/2)   Eq. (17)  -> LS11b                     *)
(*    * Delta(1620) S31 (spin 1/2, iso 3/2) Eq. (21)  -> LS31                      *)
(*    * Delta(1232) P33 (spin 3/2, iso 3/2) Eq. (36)  -> LP33                      *)
(*    * N(1520)  D13  (spin 3/2, iso 1/2)   Eq. (41)  -> LD13                      *)
(*    * Delta(1700) D33 (spin 3/2, iso 3/2) Eq. (40)  -> LD33                      *)
(*                                                                                 *)
(*  The full interaction Lagrangian is  LELA.                                      *)
(*  The Delta(1232)-only piece (Born-free) is  LDelta, used by the FeynCalc        *)
(*  cross-section script.                                                          *)
(* ------------------------------------------------------------------------------ *)

(* ------------------------------------------------------------------------------ *)
(*  Deliberate omissions (they are *not* vertices and cannot live in a UFO/        *)
(*  FeynArts model file):                                                          *)
(*                                                                                 *)
(*   - the energy-dependent resonance width Gamma(s,u) of Eqs. (44)-(47).  Only    *)
(*     the on-shell Gamma_0 enters here, as the constant Width of each resonance.  *)
(*   - the Davidson-Workman form factors Fhat_B(s,u,t), Fhat_V(t) of Eqs. (48)-    *)
(*     (51) and the sqrt(X_pi(s,u)) vertex form factor.                            *)
(*                                                                                 *)
(*  Both are Mandelstam-dependent and are implemented in the accompanying          *)
(*  FeynCalc script GammaN_to_PiN_Delta.m.                                         *)
(* ------------------------------------------------------------------------------ *)


(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)

M$ModelName = "ELA_PionPhotoproduction";

M$Information = {
  Authors      -> {"Generated for the AchillesModels/ChiralPT project"},
  Version      -> "1.0",
  Date         -> "2026-07-27",
  Institutions -> {""},
  Emails       -> {""},
  References   -> {"C. Fernandez-Ramirez, E. Moya de Guerra, J.M. Udias, nucl-th/0509020v2"}
};

FeynmanGauge = False;


(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)

(* IsoSpin   : nucleon / resonance iso-doublet index r = 1 (p-like), 2 (n-like) *)
(* IsoVector : Cartesian iso-vector index j = 1,2,3                              *)

IndexRange[Index[IsoSpin  ]] = Unfold[Range[2]];
IndexRange[Index[IsoVector]] = Unfold[Range[3]];

IndexStyle[IsoSpin,   r];
IndexStyle[IsoVector, j];


(* ************************** *)
(* *** Interaction orders *** *)
(* ************************** *)

M$InteractionOrderHierarchy = { {QED, 1}, {STR, 1} };
M$InteractionOrderLimit     = { {QED, 99}, {STR, 99} };


