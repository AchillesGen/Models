(* ****************************************************************************** *)
(* *****                          Parameters                              ****** *)
(* ****************************************************************************** *)

(* Default numerical values correspond to SET #1 of Tables 2 and 3 (PDG masses   *)
(* and widths, FSI phases included, chi^2/chi^2_PDG = 1).                        *)
(*                                                                                *)
(* The other five sets of the paper are collected at the end of this file for     *)
(* convenience -- see "Alternative parameter sets".                               *)

M$Parameters = {

(* ----------------------------- electromagnetic ------------------------------- *)

  aEWM1 == {
    ParameterType    -> External,
    BlockName        -> SMINPUTS,
    OrderBlock       -> 1,
    Value            -> 137.035999,
    InteractionOrder -> {QED, -2},
    Description      -> "Inverse of the fine structure constant at q^2 = 0"
  },
  aEW == {
    ParameterType    -> Internal,
    Value            -> 1/aEWM1,
    InteractionOrder -> {QED, 2},
    Description      -> "Fine structure constant"
  },
  ee == {
    ParameterType    -> Internal,
    Value            -> Sqrt[4 Pi aEW],
    InteractionOrder -> {QED, 1},
    TeX              -> e,
    Description      -> "Electric coupling constant (absolute value of e)"
  },

(* --------------------------- masses used as scales --------------------------- *)

  mpiScale == {
    ParameterType -> External,
    BlockName     -> ELAMASS,
    OrderBlock    -> 1,
    Value         -> 0.1395673,
    Description   -> "Pion mass appearing as a scale in f_piN/m_pi, Eq. (12)"
  },
  fpi == {
