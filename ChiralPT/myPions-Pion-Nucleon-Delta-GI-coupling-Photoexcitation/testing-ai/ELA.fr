(* mapping from the table keys onto the FeynRules parameter / mass / width symbols *)
ELA$SetTargets = {
  "Lambda" -> {LambdaFF}, "KRho" -> {KRho}, "FOmNN" -> {FOmNN}, "KOm" -> {KOm},
  "MDelta" -> {MDelta}, "WDelta" -> {WDeltaPP, WDeltaP, WDeltaZ, WDeltaM},
  "hDelta" -> {hDelta}, "g1Delta" -> {g1Delta}, "g2Delta" -> {g2Delta},
  "MN1440" -> {MN1440}, "WN1440" -> {WN1440p, WN1440n},
  "hN1440" -> {hN1440}, "gpN1440" -> {gpN1440}, "gnN1440" -> {gnN1440},
  "MN1520" -> {MN1520}, "WN1520" -> {WN1520p, WN1520n},
  "hN1520" -> {hN1520}, "g1pN1520" -> {g1pN1520}, "g1nN1520" -> {g1nN1520},
  "g2pN1520" -> {g2pN1520}, "g2nN1520" -> {g2nN1520},
  "MN1535" -> {MN1535}, "WN1535" -> {WN1535p, WN1535n},
  "hN1535" -> {hN1535}, "gpN1535" -> {gpN1535}, "gnN1535" -> {gnN1535},
  "MD1620" -> {MD1620}, "WD1620" -> {WD1620PP, WD1620P, WD1620Z, WD1620M},
  "hD1620" -> {hD1620}, "gD1620" -> {gD1620},
  "MN1650" -> {MN1650}, "WN1650" -> {WN1650p, WN1650n},
  "hN1650" -> {hN1650}, "gpN1650" -> {gpN1650}, "gnN1650" -> {gnN1650},
  "MD1700" -> {MD1700}, "WD1700" -> {WD1700PP, WD1700P, WD1700Z, WD1700M},
  "hD1700" -> {hD1700}, "g1D1700" -> {g1D1700}, "g2D1700" -> {g2D1700}
};

ELASet[n_Integer /; 1 <= n <= 6] := Module[{},
  Do[ With[{val = ELA$Sets[key][[n]]},
        Do[ NumericalValue[sym] = val; UpdateParameters[sym -> val], {sym, key /. ELA$SetTargets}]
      ], {key, Keys[ELA$Sets]}];
  Print["ELA parameter set #", n, " loaded."];];
