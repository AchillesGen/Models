(* ****************************************************************************** *)
(* *****             Conventions and short-hand structures                ****** *)
(* ****************************************************************************** *)

(* Metric  g^{mu nu} = diag(1,-1,-1,-1);  gamma5 = i g0 g1 g2 g3.                 *)
(*                                                                                *)
(* Levi-Civita: the paper uses eps^{0123} = +1.  Should your FeynRules build use   *)
(* the opposite sign convention for Eps[], flip epsSign below; every Levi-Civita   *)
(* structure in the model goes through LC4.  (This is a plain Mathematica number,  *)
(* not a model parameter, so it leaves no trace in the UFO output.)               *)

epsSign = 1;

LC4[a_, b_, c_, d_] := epsSign Eps[a, b, c, d];

(* gamma^{alpha beta} = (1/2)[gamma^alpha, gamma^beta] *)
GaAB[al_, be_, s1_, s2_] := Module[{sx},
  (1/2) (Ga[al, s1, sx] Ga[be, sx, s2] - Ga[be, s1, sx] Ga[al, sx, s2])];

(* F^{mu nu} and its dual  Ftilde^{mu nu} = (1/2) eps^{mu nu al be} F_{al be} *)
FA[mu_, nu_]      := FS[A, mu, nu];
FAdual[mu_, nu_]  := Module[{al, be}, (1/2) LC4[mu, nu, al, be] FS[A, al, be]];

(* Add the hermitian conjugate of an interaction term.

   NB: the indices MUST be expanded before HC is applied.  FeynRules' HC assigns
   a fresh dummy spinor index to every term it conjugates, so the individual
   iso-vector components of  Nbar N*_j pi_j  can no longer cancel against each
   other and spurious (charge-violating) vertices survive.  Expanding onto the
   physical charge basis first makes each term a plain product of physical
   fields, which HC handles correctly.  Verified: with the expansion,
   FeynmanRules[HC[...]] returns exactly the six charge-conserving conjugates of
   the direct pi-N-Delta vertices; without it, ten vertices come out, four of
   which violate charge conservation. *)

addHC[L_] := Module[{Lx}, Lx = Expand[ExpandIndices[L]]; Lx + HC[Lx]];

(* isospin helpers -- explicit numerical matrices, summed explicitly below *)
tau[j_Integer, r1_Integer, r2_Integer]  := PauliMatrix[j][[r1, r2]];
idIso[r1_Integer, r2_Integer]           := KroneckerDelta[r1, r2];
commTau[j_Integer, k_Integer, r1_Integer, r2_Integer] :=
  (PauliMatrix[j] . PauliMatrix[k] - PauliMatrix[k] . PauliMatrix[j])[[r1, r2]];
eps3[a_Integer, b_Integer, c_Integer]   := Signature[{a, b, c}];


(* ****************************************************************************** *)
(* *****                          Lagrangians                             ****** *)
(* ****************************************************************************** *)

(* ------------------------------------------------------------------------------ *)
(*  Born terms, Eq. (14)                                                           *)
(*                                                                                 *)
(*  L_Born = - i e F_pi Ahat^al eps_{jk3} pi_j (d_al pi_k)                          *)
(*           - e Ahat^al F1V Nbar ga_al (1/2)(F1^{S/V} + tau3) N                    *)
(*           - i e F1V (f_piN/m_pi) Ahat^al Nbar ga_al ga5 (1/2)[tau_j,tau3] pi_j N *)
(*           - (i e/4M) F2V Nbar (1/2)(F2^{S/V} + tau3) ga_{al be} N F^{al be}      *)
(*           + (f_piN/m_pi) Nbar ga_al ga5 tau_j N (d^al pi_j)                      *)
(* ------------------------------------------------------------------------------ *)

(* (a) gamma pi pi  (scalar QED piece; F_pi = F1V ensures gauge invariance) *)
(*                                                                                  *)
(*  NOTE: the factor of I that appears in Eq. (14) as printed has been REMOVED.     *)
(*  Minimal coupling gives a real coefficient: with                                  *)
(*      D_mu pi_b = d_mu pi_b + i e A_mu (T3)_bc pi_c,   (T3)_bc = -i eps_{3bc}      *)
(*  the kinetic term (1/2)(D_mu pi_b)^2 yields                                       *)
(*      L_int = -e A^al eps_{jk3} pi_j d_al pi_k     [no I].                         *)
(*  With the I present, FeynRules returns a REAL gamma-pi-pi vertex while the        *)
(*  gamma-N-N vertex is imaginary; scalar and spinor QED require both imaginary,     *)
(*  and the charged-pion Born amplitude then violates gauge invariance by 24-30%.    *)
(*  Dropping the I multiplies this vertex by -i and makes the Ward identity exact    *)
(*  (residual 3.6e-17 / 5.1e-17), with the Kroll-Ruderman coupling landing on the    *)
(*  required value with no adjustment.  See VALIDATION.md.                           *)
LBornApipi := Block[{al},
  -ee F1V A[al] Sum[eps3[iv, kv, 3] Pion[iv] del[Pion[kv], al], {iv, 3}, {kv, 3}]];

(* (b) gamma N N, Dirac part *)
LBornANNv := Block[{al, s1, s2},
  -ee F1V A[al] Sum[
      Nucleonbar[s1, ia] Ga[al, s1, s2] (1/2) (F1SV idIso[ia, ib] + tau[3, ia, ib]) Nucleon[s2, ib],
      {ia, 2}, {ib, 2}]];

(* (c) Kroll-Ruderman contact term *)
LBornKR := Block[{al, s1, s2, s3},
  -I ee F1V (fpiN/mpiScale) A[al] Sum[
      Nucleonbar[s1, ia] Ga[al, s1, s2] Ga[5, s2, s3] (1/2) commTau[iv, 3, ia, ib] Pion[iv] Nucleon[s3, ib],
      {ia, 2}, {ib, 2}, {iv, 3}]];

(* (d) gamma N N, anomalous magnetic moment, Eq. (13) *)
LBornANNt := Block[{al, be, s1, s2},
  -(I ee/(4 MN)) F2V Sum[
      Nucleonbar[s1, ia] (1/2) (F2SV idIso[ia, ib] + tau[3, ia, ib]) GaAB[al, be, s1, s2] Nucleon[s2, ib],
      {ia, 2}, {ib, 2}] FA[al, be]];

(* (e) pi N N pseudovector coupling, Eq. (12) *)
LBornPiNN := Block[{al, s1, s2, s3},
  (fpiN/mpiScale) Sum[
      Nucleonbar[s1, ia] Ga[al, s1, s2] Ga[5, s2, s3] tau[iv, ia, ib] Nucleon[s3, ib] del[Pion[iv], al],
      {ia, 2}, {ib, 2}, {iv, 3}]];

LBorn := LBornApipi + LBornANNv + LBornKR + LBornANNt + LBornPiNN;


(* ------------------------------------------------------------------------------ *)
(*  omega exchange, Eq. (15)                                                       *)
(*    L_omega = - F_omNN Nbar [ ga_al - i (K_om/2M) ga_{al be} d^be ] om^al N       *)
(*              + (e G_ompigam/m_pi) Ftilde_{mu nu} (d^mu pi_j) delta_{j3} om^nu    *)
(* ------------------------------------------------------------------------------ *)

LOmegaNN := Block[{al, be, s1, s2},
  -FOmNN Sum[
      Nucleonbar[s1, ia] idIso[ia, ib] (
          Ga[al, s1, s2] Om[al]
        - I (KOm/(2 MN)) GaAB[al, be, s1, s2] del[Om[al], be]
      ) Nucleon[s2, ib],
      {ia, 2}, {ib, 2}]];

LOmegaPiGam := Block[{mu, nu},
  (ee GOmPiGam/mpiScale) FAdual[mu, nu] del[Pi0, mu] Om[nu]];

LOmega := LOmegaNN + LOmegaPiGam;


(* ------------------------------------------------------------------------------ *)
(*  rho exchange, Eq. (16)                                                         *)
(*    L_rho = - F_rhoNN Nbar [ ga_al - i (K_rho/2M) ga_{al be} d^be ] tau_j rho^al_j N *)
(*            + (e G_rhopigam/m_pi) Ftilde_{mu nu} (d^mu pi_j) rho^nu_j             *)
(*                                                                                 *)
(*  G_rho0pigam and G_rho+-pigam differ, so the pi-gamma-rho term is written out    *)
(*  in the charge basis.                                                           *)
(* ------------------------------------------------------------------------------ *)

LRhoNN := Block[{al, be, s1, s2},
  -FRhoNN Sum[
      Nucleonbar[s1, ia] tau[iv, ia, ib] (
          Ga[al, s1, s2] RhoV[al, iv]
        - I (KRho/(2 MN)) GaAB[al, be, s1, s2] del[RhoV[al, iv], be]
      ) Nucleon[s2, ib],
      {ia, 2}, {ib, 2}, {iv, 3}]];

LRhoPiGam := Block[{mu, nu},
  (ee/mpiScale) FAdual[mu, nu] (
      GRho0PiGam del[Pi0, mu] Rho0[nu]
    + GRhoCPiGam (del[PiP, mu] RhoPbar[nu] + del[PiPbar, mu] RhoP[nu]) )];

LRho := LRhoNN + LRhoPiGam;

LVectorMesons := LOmega + LRho;


(* ------------------------------------------------------------------------------ *)
(*  Spin-1/2, isospin-1/2 resonances                                               *)
(*                                                                                 *)
(*  S11, Eq. (17):                                                                 *)
(*    L = - (h/f_pi) Nbar ga_al tau_j N* d^al pi_j                                  *)
(*        - (i e/4M) Nbar ga_{al be} ga5 (gS + gV tau3) N* F^{al be} + HC           *)
(*                                                                                 *)
(*  P11, Eq. (22):                                                                 *)
(*    L = - (h/f_pi) Nbar ga_al ga5 tau_j N* d^al pi_j                              *)
(*        + (i e/4M) Nbar ga_{al be} (gS + gV tau3) N* F^{al be} + HC               *)
(* ------------------------------------------------------------------------------ *)

LS11gen[Res_, h_, gS_, gV_] := Module[{tPi, tEM},
  tPi = Block[{al, s1, s2},
    -(h/fpi) Sum[
        Nucleonbar[s1, ia] Ga[al, s1, s2] tau[iv, ia, ib] Res[s2, ib] del[Pion[iv], al],
        {ia, 2}, {ib, 2}, {iv, 3}]];
  tEM = Block[{al, be, s1, s2, s3},
    -(I ee/(4 MN)) Sum[
        Nucleonbar[s1, ia] GaAB[al, be, s1, s2] Ga[5, s2, s3]
          (gS idIso[ia, ib] + gV tau[3, ia, ib]) Res[s3, ib],
        {ia, 2}, {ib, 2}] FA[al, be]];
  addHC[tPi + tEM]];

LP11gen[Res_, h_, gS_, gV_] := Module[{tPi, tEM},
  tPi = Block[{al, s1, s2, s3},
    -(h/fpi) Sum[
        Nucleonbar[s1, ia] Ga[al, s1, s2] Ga[5, s2, s3] tau[iv, ia, ib] Res[s3, ib] del[Pion[iv], al],
        {ia, 2}, {ib, 2}, {iv, 3}]];
  tEM = Block[{al, be, s1, s2},
    (I ee/(4 MN)) Sum[
        Nucleonbar[s1, ia] GaAB[al, be, s1, s2]
          (gS idIso[ia, ib] + gV tau[3, ia, ib]) Res[s2, ib],
        {ia, 2}, {ib, 2}] FA[al, be]];
  addHC[tPi + tEM]];

LS11a := LS11gen[N1535, hN1535, gSN1535, gVN1535];   (* N(1535) *)
LS11b := LS11gen[N1650, hN1650, gSN1650, gVN1650];   (* N(1650) *)
LP11  := LP11gen[N1440, hN1440, gSN1440, gVN1440];   (* N(1440) *)


(* ------------------------------------------------------------------------------ *)
(*  Spin-1/2, isospin-3/2 resonance -- Delta(1620) S31, Eq. (21)                    *)
(*    L = - (h/f_pi) Nbar ga_al N*_j d^al pi_j                                      *)
(*        - (i e g/2M) Nbar ga_{al be} ga5 N*_3 F^{al be} + HC                      *)
(* ------------------------------------------------------------------------------ *)

LS31gen[Res_, h_, g_] := Module[{tPi, tEM},
  tPi = Block[{al, s1, s2},
    -(h/fpi) Sum[
        Nucleonbar[s1, ia] Ga[al, s1, s2] Res[s2, ia, iv] del[Pion[iv], al],
        {ia, 2}, {iv, 3}]];
  tEM = Block[{al, be, s1, s2, s3},
    -(I ee g/(2 MN)) Sum[
        Nucleonbar[s1, ia] GaAB[al, be, s1, s2] Ga[5, s2, s3] Res[s3, ia, 3],
        {ia, 2}] FA[al, be]];
  addHC[tPi + tEM]];

LS31 := LS31gen[D1620, hD1620, gD1620];


(* ------------------------------------------------------------------------------ *)
(*  Spin-3/2, isospin-3/2 resonances (gauge-invariant Pascalutsa couplings)         *)
(*                                                                                 *)
(*  P33, Eq. (36):                                                                 *)
(*    L = - (h/(f_pi MR)) Nbar eps_{mu nu la be} ga^be ga5 (d^mu N*^nu_j)(d^la pi_j) *)
(*        + (3e/(2M(M+MR))) Nbar [ i g1 Ftilde_{mu nu} + g2 ga5 F_{mu nu} ] (d^mu N*^nu_3) *)
(*        + HC                                                                      *)
(*                                                                                  *)
(*  D33, Eq. (40): same with the overall ga5 moved (parity flip)                     *)
(*    L = - (h/(f_pi MR)) Nbar eps_{mu nu la be} ga^be (d^mu N*^nu_j)(d^la pi_j)     *)
(*        + (3e/(2M(M+MR))) Nbar [ i g1 Ftilde_{mu nu} ga5 + g2 F_{mu nu} ] (d^mu N*^nu_3) *)
(*        + HC                                                                      *)
(* ------------------------------------------------------------------------------ *)

LP33gen[Res_, MRes_, h_, g1_, g2_] := Module[{tPi, tEM},
  tPi = Block[{mu, nu, la, be, s1, s2, s3},
    -(h/(fpi MRes)) Sum[
        Nucleonbar[s1, ia] LC4[mu, nu, la, be] Ga[be, s1, s2] Ga[5, s2, s3]
          del[Res[s3, nu, ia, iv], mu] del[Pion[iv], la],
        {ia, 2}, {iv, 3}]];
  tEM = Block[{mu, nu, s1, s2},
    (3 ee/(2 MN (MN + MRes))) Sum[
        Nucleonbar[s1, ia] (
            I g1 FAdual[mu, nu] IndexDelta[s1, s2]
          + g2 Ga[5, s1, s2] FA[mu, nu]
        ) del[Res[s2, nu, ia, 3], mu],
        {ia, 2}]];
  addHC[tPi + tEM]];

LD33gen[Res_, MRes_, h_, g1_, g2_] := Module[{tPi, tEM},
  tPi = Block[{mu, nu, la, be, s1, s2},
    -(h/(fpi MRes)) Sum[
        Nucleonbar[s1, ia] LC4[mu, nu, la, be] Ga[be, s1, s2]
          del[Res[s2, nu, ia, iv], mu] del[Pion[iv], la],
        {ia, 2}, {iv, 3}]];
  tEM = Block[{mu, nu, s1, s2},
    (3 ee/(2 MN (MN + MRes))) Sum[
        Nucleonbar[s1, ia] (
            I g1 Ga[5, s1, s2] FAdual[mu, nu]
          + g2 IndexDelta[s1, s2] FA[mu, nu]
        ) del[Res[s2, nu, ia, 3], mu],
        {ia, 2}]];
  addHC[tPi + tEM]];

LP33 := LP33gen[Delta, MDelta, hDelta, g1Delta, g2Delta];   (* Delta(1232) *)
LD33 := LD33gen[D1700, MD1700, hD1700, g1D1700, g2D1700];   (* Delta(1700) *)


(* ------------------------------------------------------------------------------ *)
(*  Spin-3/2, isospin-1/2 resonance -- N(1520) D13, Eq. (41)                        *)
(*    L = - (h/(f_pi MR)) Nbar eps_{mu nu la be} ga^be tau_j (d^mu N*^nu)(d^la pi_j) *)
(*        + (3e/(4M(M+MR))) Nbar [ i (g1S+g1V tau3) Ftilde_{mu nu} ga5               *)
(*                                 + (g2S+g2V tau3) F_{mu nu} ] (d^mu N*^nu) + HC    *)
(* ------------------------------------------------------------------------------ *)

LD13gen[Res_, MRes_, h_, g1S_, g1V_, g2S_, g2V_] := Module[{tPi, tEM},
  tPi = Block[{mu, nu, la, be, s1, s2},
    -(h/(fpi MRes)) Sum[
        Nucleonbar[s1, ia] LC4[mu, nu, la, be] Ga[be, s1, s2] tau[iv, ia, ib]
          del[Res[s2, nu, ib], mu] del[Pion[iv], la],
        {ia, 2}, {ib, 2}, {iv, 3}]];
  tEM = Block[{mu, nu, s1, s2},
    (3 ee/(4 MN (MN + MRes))) Sum[
        Nucleonbar[s1, ia] (
            I (g1S idIso[ia, ib] + g1V tau[3, ia, ib]) Ga[5, s1, s2] FAdual[mu, nu]
          + (g2S idIso[ia, ib] + g2V tau[3, ia, ib]) IndexDelta[s1, s2] FA[mu, nu]
        ) del[Res[s2, nu, ib], mu],
        {ia, 2}, {ib, 2}]];
  addHC[tPi + tEM]];

LD13 := LD13gen[N1520, MN1520, hN1520, g1SN1520, g1VN1520, g2SN1520, g2VN1520];


(* ------------------------------------------------------------------------------ *)
(*  Assembled Lagrangians                                                          *)
(* ------------------------------------------------------------------------------ *)

LResonances := LP11 + LS11a + LS11b + LS31 + LP33 + LD13 + LD33;

(* full interaction Lagrangian of the model *)
LELA := LBorn + LVectorMesons + LResonances;

(* Delta(1232)-only piece: what the FeynCalc cross-section script needs *)
LDelta := LP33;


(* ****************************************************************************** *)
(* *****                  Alternative parameter sets                      ****** *)
(* ****************************************************************************** *)

