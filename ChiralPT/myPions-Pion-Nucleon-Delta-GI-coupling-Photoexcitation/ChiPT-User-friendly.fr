(* ****************************************************************************** *)
(*                                                                                *)
(*   ChiPT.fr  --  chiral pion / nucleon / Delta(1232) model with the             *)
(*                gauge-invariant (Pascalutsa) piN-Delta and gammaN-Delta          *)
(*                couplings.                                                       *)
(*                                                                                *)
(*   Successor to myPions.fr.  The Lagrangian now lives HERE rather than in        *)
(*   export_UFO_myPions.nb, so the model is self-contained: LoadModel["ChiPT.fr"]  *)
(*   followed by WriteUFO[LTotal, ...] reproduces the full model.                  *)
(*                                                                                *)
(* ------------------------------------------------------------------------------ *)
(*  CHANGES RELATIVE TO myPions.fr + export_UFO_myPions.nb                         *)
(* ------------------------------------------------------------------------------ *)
(*                                                                                 *)
(*  1. LAGRANGIAN MOVED IN.  myPions.fr defined particles and parameters only;     *)
(*     every interaction (LPionKin, LNucleonKin, LNNAxial, LNNVector, the four     *)
(*     Rarita-Schwinger blocks) was defined in the export notebook, and the file's *)
(*     last line referred to LPionKin, which it never defined.  All of it is now   *)
(*     in this file, in the "Lagrangian" section below.                            *)
(*                                                                                 *)
(*  2. DelU CONVENTION.  myPions.fr had two versions of DelU, the second          *)
(*     overwriting the first:                                                      *)
(*         d U - i l U + i U r     (active,   convention U -> L U R^+)             *)
(*         d U - i r U + i U l     (commented out, convention U -> R U L^+)        *)
(*     The second is the one that matches ChiConnect / ChiVielbein, which use      *)
(*     u^+(d - i r)u and u(d - i l)u^+, so the active one is now the second.       *)
(*     l = r for electromagnetism, so this is invisible in gamma p -> pi0 p; it    *)
(*     matters only for W couplings, which live in LMat alone.                     *)
(*                                                                                 *)
(*  3. ONE CHIRAL CONVENTION, ONE CONNECTION (v2.1, v2.2).                         *)
(*     Everything is U -> R U L^+, U = u^2, and both baryon sectors are built     *)
(*     from the same two objects:                                                  *)
(*         ChiConnect  = Gamma_mu = (i/2)[u^+(d - i r)u + u(d - i l)u^+]           *)
(*                     = v_mu + (l~ + r~)/2 ,         HERMITIAN                    *)
(*         ChiVielbein = u_mu     =  i  [u^+(d - i r)u - u(d - i l)u^+]           *)
(*                     = 2 a_mu + r~ - l~                                          *)
(*     with l~ = u l u^+, r~ = u^+ r u, and every covariant derivative written    *)
(*     D_mu = d_mu - i Gamma_mu.  The nucleon Lagrangian is                        *)
(*         Nbar ( i gamma^mu D_mu - M + ga/2 gamma^mu gamma5 u_mu ) N .            *)
(*                                                                                 *)
(*     v2.2: Gamma_mu is the HERMITIAN connection, i times the primer's            *)
(*     anti-hermitian one, so D_mu = d_mu - i Gamma_mu is the same operator as     *)
(*     the primer's d_mu + Gamma_mu.  Only DeltaConnection had to change (its     *)
(*     v2.0 bracket is now multiplied by -i); every vertex is unchanged.          *)
(*                                                                                 *)
(*     v2.1: through v2.0 the nucleon sector used l~ = u^+ l u, r~ = u r u^+ and   *)
(*     -ga.  Together that is exactly the correct nucleon Lagrangian with           *)
(*     pi -> -pi, i.e. the U -> L U R^+ theory the nucleon sector was first        *)
(*     written in, while the pion and Delta sectors were R U L^+.  Each sector was *)
(*     self-consistent, so no Ward identity or gauge test could see it; what it    *)
(*     broke was every relative sign BETWEEN sectors.  Two patches had absorbed   *)
(*     it and are removed:                                                         *)
(*       * ChiVielbeinVWeakSrc negated the Delta's weak axial source to match the  *)
(*         nucleon.  The Delta was the correct one; the patch went into the wrong  *)
(*         sector.  The Delta now uses ChiVielbeinVWeak as is.                     *)
(*       * The EMStrengthTensor sign was flipped back and forth to fix the         *)
(*         Born/Delta interference.  F_{mu nu} is standard and stays standard.     *)
(*         The sign being chased there is sign(hD G1), which chiral symmetry does  *)
(*         not fix; it is now the explicit parameter etaND (see the note at G1).   *)
(*                                                                                 *)
(*  4. LMat / RMat DEFINED ONCE.  myPions.fr defined each of them three times      *)
(*     (lines 909-911 and 913-915); only the last survived.  The two dead ones     *)
(*     were quark-hypercharge versions (g1/6).  The surviving, correct choice is   *)
(*     kept and is now the only one:  l_mu = r_mu = e Q A_mu with Q = (1+tau3)/2,  *)
(*     which gives the pion charges through the commutator and the proton/neutron  *)
(*     charges through Gamma_mu.                                                    *)
(*                                                                                 *)
(*  5. UNITS.  MEta, MK0, MKp were 547.86 / 497.61 / 493.68, i.e. MeV, while       *)
(*     everything else in the file is GeV.  Now in GeV.                            *)
(*                                                                                 *)
(*  6. PION MASSES SPLIT.  Pi0 and PiP both used MPi = 0.13498 (the pi0 mass).     *)
(*     They now carry the physical MPi0 and MPiP.  The chiral Lagrangian is        *)
(*     isospin symmetric by construction, so the mass matrix ChiMat still uses a   *)
(*     single MPi (internal, = MPi0 by default, which reproduces the previous      *)
(*     numbers).  The pi+ two-point term from LPionKin therefore carries MPi while *)
(*     the propagator carries MPiP; that is the usual phenomenological compromise,  *)
(*     not an inconsistency to be fixed here.  Set MPi -> MPiP if you prefer the    *)
(*     more common chiral convention.                                              *)
(*                                                                                 *)
(*  7. DEAD CODE REMOVED.  The commented-out spin-1/2-style F[4] Delta class       *)
(*     (superseded by R[1]-R[5], and flagged "Error" in its own PDG list) is gone. *)
(*     FeynmanGauge is set to False here, which is what the export notebook set    *)
(*     immediately after loading anyway.                                           *)
(*                                                                                 *)
(* ------------------------------------------------------------------------------ *)
(*  RESOLVED -- premature evaluation during LoadModel (see ChiPTClearCache below) *)
(* ------------------------------------------------------------------------------ *)
(*   Symptom: every pi-N-Delta vertex built from LPiNDeltaGI / LPiNDelta /         *)
(*   LDeltaSector carried spurious Derivative[1][HC][0], Derivative[2][HC][0] and  *)
(*   Derivative[1,0][del][0,...] factors, e.g.                                     *)
(*                                                                                 *)
(*     -I hD/(Sqrt[6] fPi MDelta) Eps[...] FV[1,b] FV[3,a] Ga[c].Ga[5]             *)
(*        * ( 1 + Derivative[1][HC][0] + ... )                                     *)
(*                                                                                 *)
(*   Cause: FeynRules' LoadModel evaluates some of the chiral helper functions      *)
(*   WHILE the model is still being set up, at a point where HC[umat] and           *)
(*   del[umat,mu] cannot yet resolve.  getRidOfhigherOrderTerm (= Series in 1/fPi)  *)
(*   then differentiates the surviving HC and del heads as ordinary functions of    *)
(*   fPi.  Because those helpers are memoised, that premature, contaminated result  *)
(*   was cached permanently, and no later evaluation could recover.  Rebuilding the *)
(*   character-identical expression at top level after loading was always clean --  *)
(*   which is what made this confusing to track down.                               *)
(*                                                                                 *)
(*   Fix: call ChiPTClearCache[] immediately after LoadModel (see below).  Verified *)
(*   afterwards: LPionKin, LNucleonKin, LNNVector, LNNAxial, LDeltaSector,          *)
(*   LPiNDelta, LPiNDeltaGI and LGammaNDelta all report zero Derivative-junk and    *)
(*   zero leftover HC, and the exported UFO contains none either.                   *)
(*                                                                                 *)
(*   NOTE: this was NEVER a problem for export_UFO_myPions.nb.  That notebook       *)
(*   defines the Lagrangians AFTER LoadModel has returned, so nothing is evaluated  *)
(*   prematurely.  The shipped                                                      *)
(*   myPions_Pion_Nucleon_Delta_GI_coupling_Photoexcitation_UFO was checked file by *)
(*   file and is completely free of this junk.  The bug is specific to moving the   *)
(*   Lagrangian into the .fr, i.e. it was introduced by THIS file.                  *)
(*                                                                                 *)
(* ------------------------------------------------------------------------------ *)
(*  VERIFY AFTER v2.2                                                              *)
(* ------------------------------------------------------------------------------ *)
(*   - The nucleon sector now uses ChiConnect / ChiVielbein directly.  v2.0        *)
(*     warned that this gave pi-N-N a factor 2 too small plus parity-violating     *)
(*     pi-N-N vertices; at the time those objects were Series-wrapped and the      *)
(*     load-time cache contamination had not been found.  Check, after             *)
(*     ChiPTClearCache[]:                                                          *)
(*       Block[{mu}, Expand[ChiPTOnePion[ChiConnect[mu]] - SrcTildaV1[mu]]]        *)
(*     is the zero matrix, and the pi-N-N vertex is ga/(2 fPi) gamma^mu gamma5     *)
(*     with NO pi-N-N vertex lacking gamma5.                                       *)
(*   - Vertex diff against the v2.1 UFO: the connection change is a pure           *)
(*     rewriting, so every vertex, Delta sector included, should be identical.     *)
(*   - Fig. 33 (gamma N -> pi N): cross sections should be bit-identical to v2.0.  *)
(*     Every photoproduction diagram changed by the same overall sign in v2.1 --  *)
(*     the Born terms through pi-N-N, the Delta terms through etaND on G1.  The    *)
(*     ELA ratio-of-ratios should stay +1.02; if it reads -1.02, flip etaND and    *)
(*     nothing else.                                                               *)
(*   - (p~ n W+)/(p~ n Pi+) should equal (p~ D++ W-)/(p~ D++ Pi-), both            *)
(*     -I g fPi Vud/2.  W/Z/gamma-N-N at u = 1, LNNWeakCCFF/NCFF, LNNPPFF, CCQE,   *)
(*     the Delta widths, C4A/C5A = -1/4 and the C6A suppression are unchanged      *)
(*     from v2.0; tools/adler_ndelta.py now reports C5A(0)/hD = +Sqrt[2/3].        *)
(*   - Weak single pion: relative to v2.0 every diagram changes by one overall     *)
(*     sign EXCEPT LPPoleFF, so the pion-pole diagram's relative sign flips.  Its  *)
(*     sign is the one derived from the pion sector, so PCAC should hold; rerun    *)
(*     tools/pcac_1pi.py.  If it fails, audit how the test builds its target       *)
(*     before touching the model -- the v2.0 pass predates the nucleon fix.        *)
(*   - Delta charges: checked by hand.  DeltaConnection gives the charge operator  *)
(*     (1+tau3)/2 + t3 with (t3)_ij = -I eps_3ij, and every R[5] component is an   *)
(*     eigenstate with Q = 2, 1, 0, -1, as declared.                               *)
(*   - LGauge refers to WMat and BMat, which are not defined anywhere in this      *)
(*     file, so the gauge-boson self-couplings it produces are not meaningful.     *)
(*                                                                                 *)
(* ****************************************************************************** *)

(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)
M$ModelName = "ChiPT";

M$Information = {
  Authors      -> {""},
  Version      -> "2.2",
  Date         -> "",
  Institutions -> {""},
  Emails       -> {""}
};

FeynmanGauge = False;

(* ****************************************************************************** *)
(*  FORM FACTOR FLAG -- set this BEFORE LoadModel["ChiPT.fr"].                     *)
(*                                                                                *)
(*    ChiPT$FormFactors = None        (default) point-like couplings, as before.   *)
(*                      = "Nucleon"   nucleon electromagnetic form factors on the  *)
(*                                    gamma-N-N vertex: Dirac F1 and Pauli F2 for  *)
(*                                    BOTH nucleons.  This is also what restores   *)
(*                                    the anomalous magnetic moment and gives the  *)
(*                                    neutron a photon vertex at all.              *)
(*                      = "ELA"       expose the Davidson-Workman cutoff LambdaFF  *)
(*                                    as an external parameter (see below).        *)
(*                      = "Delta"     form factors on the pi-N-Delta and the       *)
(*                                    gamma-N-Delta vertices; see the block at     *)
(*                                    LPiNDeltaGIFF for exactly what they are and  *)
(*                                    what of the Fig. 33 prescription they can    *)
(*                                    and cannot reproduce.                        *)
(*                      = "Weak"      form factors on the WEAK vertices: F1V/F2V/FA  *)
(*                                    on the W-N-N current (CVC + axial), the         *)
(*                                    neutral-current F1^Z/F2^Z/FA^Z on the Z-N-N     *)
(*                                    current, and a C5A(Q^2) dipole on the W/Z-N-    *)
(*                                    Delta transition.  See LNNWeakCCFF below.       *)
(*                      = "All"       all four.                                       *)
(*                                                                                 *)
(*  M$FormFactors is read while the file is being loaded, which is why the flag     *)
(*  has to be set first, e.g.                                                       *)
(*                                                                                  *)
(*      ChiPT$FormFactors = "Nucleon";                                              *)
(*      LoadModel["ChiPT.fr"];                                                      *)
(*      ChiPTClearCache[];                                                          *)
(*      WriteUFO[LTotal, AddDecays -> False, FlavorExpand -> True];                 *)
(*                                                                                  *)
(*  WHY THE ELA/DAVIDSON-WORKMAN FORM FACTORS ARE *NOT* PUT ON VERTICES.            *)
(*  Eq. (48) of nucl-th/0509020v2 is                                                *)
(*      Fhat_B(s,u,t) = 1 - (1-F1(s))(1-F2(u))(1-F3(t))                             *)
(*  a single factor on the WHOLE Born amplitude, mixing all three Mandelstams.  A   *)
(*  UFO form factor is a function of one vertex's own momenta, so Fhat_B is simply  *)
(*  not a vertex-level object; attaching F1/F2/F3 to individual vertices is the     *)
(*  per-diagram scheme the paper explicitly rejects, and it breaks the Ward         *)
(*  identity (measured at the 24-33% level in ELA-Pion-Photoproduction/Fig33v2.m).  *)
(*  ELA.fr reaches the same conclusion -- its LambdaFF is documented there as       *)
(*  "Not used inside the vertices; consumed by the FeynCalc script."                *)
(*                                                                                  *)
(*  So "ELA" only exports the cutoff; the generator applies, at amplitude level,    *)
(*      F1(s) = 1/(1 + (s - M^2)^2 / LambdaFF^4)      Eq. (49)                      *)
(*      F2(u) = 1/(1 + (u - M^2)^2 / LambdaFF^4)      Eq. (50)                      *)
(*      F3(t) = 1/(1 + (t - mpi^2)^2 / LambdaFF^4)    Eq. (51)                      *)
(*      Fhat_B = 1 - (1-F1)(1-F2)(1-F3)               Eq. (48)                      *)
(*      Fhat_V(t) = F3(t) with mpi -> mV              (vector mesons)               *)
(*  and sqrt(X_pi(s,u)) on the resonance-pion-nucleon vertex, Eqs. (44)-(47).       *)
(* ****************************************************************************** *)

If[!ValueQ[ChiPT$FormFactors], ChiPT$FormFactors = None];
ChiPT$NucleonFF = MemberQ[{"Nucleon", "All"}, ChiPT$FormFactors];
ChiPT$ELAFF     = MemberQ[{"ELA", "All"}, ChiPT$FormFactors];
ChiPT$DeltaFF   = MemberQ[{"Delta", "All"}, ChiPT$FormFactors];
ChiPT$WeakFF    = MemberQ[{"Weak",  "All"}, ChiPT$FormFactors];


(* ************************** *)
(* *****  Change  log   ***** *)
(* ************************** *)

(* v0.1: Initialize model (as myPions.fr).                                   *)
(* v2.0: Lagrangian moved into the model file; DelU convention, duplicate    *)
(*       LMat/RMat, meson mass units and pion masses corrected.  See the     *)
(*       header block above for what was checked and deliberately left       *)
(*       unchanged.                                                          *)
(* v2.1: Single U -> R U L^+ convention throughout: nucleon dressed sources  *)
(*       and axial sign fixed, ChiVielbeinVWeakSrc removed, sign(hD G1)      *)
(*       made the explicit parameter etaND.  See header note 3.              *)
(* v2.2: Hermitian chiral connection, D_mu = d_mu - i Gamma_mu.  Nucleon     *)
(*       sector built directly from ChiConnect / ChiVielbein; aVec, vVec and *)
(*       the intermediate source combinations removed.  See header note 3.   *)


(* ************************** *)
(* *****  Gauge groups  ***** *)
(* ************************** *)
M$GaugeGroups = {
  U1Y  == {
    Abelian          -> True,
    CouplingConstant -> g1,
    GaugeBoson       -> B,
    Charge           -> Y
  },
  SU2L == {
    Abelian           -> False,
    CouplingConstant  -> g2,
    GaugeBoson        -> Wi,
    StructureConstant -> Eps,
    Representations   -> {Ta,SU2D},
    Definitions       -> {Ta[a_,b_,c_]->PauliSigma[a,b,c]/2, FSU2L[i_,j_,k_]:> I Eps[i,j,k]}
  }
};


(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)

IndexRange[Index[SU2W      ]] = Unfold[Range[3]];
IndexRange[Index[SU2D      ]] = Unfold[Range[2]];
IndexRange[Index[Generation]] = Range[3];
IndexRange[Index[IsoSpin   ]] = Unfold[Range[2]];
IndexRange[Index[IsoVector ]] = Unfold[Range[3]];


IndexStyle[SU2W,       j];
IndexStyle[SU2D,       k];
IndexStyle[Generation, f];
IndexStyle[IsoSpin,    s];
IndexStyle[IsoVector,  v];

(* ************************** *)
(* *** Interaction orders *** *)
(* ***  (as used by mg5)  *** *)
(* ************************** *)

(* CHI counts inverse powers of fPi, i.e. the order in the chiral expansion.
   It is carried by fPi itself with InteractionOrder -> {CHI, -1}, so a
   coupling going as 1/fPi^k comes out at CHI = +k (same idiom as
   aEWM1 -> {QED,-2} below).

   This is not cosmetic.  Sherpa/Comix drops any current whose accumulated
   coupling order is (0,0) and whose t-channel count is 0, because that is
   indistinguishable from the freshly-allocated prototype current -- see
   COMIX/Amplitude/Amplitude.C:431 and :545.  Without a nonzero order on the
   purely hadronic vertices, every diagram in which a pion and a baryon fuse
   into an intermediate baryon is silently discarded: gamma p -> pi0 p keeps
   only its two u-channel graphs, loses both direct (s-channel) graphs
   including the Delta+ resonance, and fails Comix's gauge test by ~45%. *)

M$InteractionOrderHierarchy = {
  {QED, 1},
  {QCD, 1},
  {CHI, 1}
};

M$InteractionOrderLimit = {
  {QED, 99},
  {QCD, 0},
  {CHI, 99}
};


(* ************************** *)
(* **** Particle classes **** *)
(* ************************** *)
M$ClassesDescription = {

(* Gauge bosons: physical vector fields *)
  V[1] == {
    ClassName       -> A,
    SelfConjugate   -> True,
    Mass            -> 0,
    Width           -> 0,
    ParticleName    -> "A",
    PDG             -> 22,
    PropagatorLabel -> "a",
    PropagatorType  -> W,
    PropagatorArrow -> None,
    FullName        -> "Photon"
  },
  V[2] == {
    ClassName       -> Z,
    SelfConjugate   -> True,
    Mass            -> {MZ, 91.1876},
    Width           -> {WZ, 2.4952},
    ParticleName    -> "Z",
    PDG             -> 23,
    PropagatorLabel -> "Z",
    PropagatorType  -> Sine,
    PropagatorArrow -> None,
    FullName        -> "Z"
  },
  V[3] == {
    ClassName        -> W,
    SelfConjugate    -> False,
    Mass             -> {MW, Internal},
    Width            -> {WW, 2.085},
    ParticleName     -> "W+",
    AntiParticleName -> "W-",
    QuantumNumbers   -> {Q -> 1},
    PDG              -> 24,
    PropagatorLabel  -> "W",
    PropagatorType   -> Sine,
    PropagatorArrow  -> Forward,
    FullName         -> "W"
  },

(* Ghosts: related to physical gauge bosons *)
  U[1] == {
    ClassName       -> ghA,