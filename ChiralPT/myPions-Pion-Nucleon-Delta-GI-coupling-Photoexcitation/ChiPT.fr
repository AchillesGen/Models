  },
  R[4] == {
    ClassName        -> DeltaM,
    SelfConjugate    -> False,
    Mass             -> {MDelta, 1.209},
    Width            -> {WDeltaM, 0.102},
    QuantumNumbers   -> {Q -> -1, BaryonNumber -> 1, Y -> 1},
    PropagatorLabel  -> "D-",
    PropagatorType   -> S,
