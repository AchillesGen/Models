};

(* *************************** *)
(* *****   FormFactors   ***** *)
(* *************************** *)

(* Kept commented out, as in myPions.fr.  The export notebook's
   PhotonFormFactorRules / WFormFactorRules / ZFormFactorRules substitute these
   in by hand after the Lagrangian is built. *)

M$FormFactors = Join[If[ChiPT$NucleonFF,
  {
    (* Nucleon electromagnetic form factors, as functions of Q^2 = -q^2 where q is
       the photon momentum (external leg 3 of the gamma-N-N vertex).

       All four are the FULL form factors.  LNNVector already generates the
       POINT-LIKE proton coupling + ee A^mu pbar gamma_mu p (verified:
       Vertex(p~ p A) = +I ee Ga[mu]), so LNNEMFF below carries the combination
       (FF1PA - 1).  The -1 is an ordinary number, so FeynRules routes it to the
       COUPLING, where it cancels the point-like contribution exactly, leaving a
       single Lorentz structure F1p*Gamma rather than the unsimplifiable
       Gamma + (F1p - 1)*Gamma.  (FeynRules cannot collapse the latter: the form
       factor value is a raw Python string, so 1 + (F1p - 1) can never be
       simplified symbolically -- it had to be hand-edited before.)
       The neutron has no point-like coupling, so FF1NA is the full F1n.
       The downstream generator must supply F1p, F1n, F2p, F2n. *)
    FF1PA == {
        Particles        -> {Protonbar, Proton, A},
        ComplexParameter -> False,
        Value            -> "F1p(-P(-1,3)**2)",
        ParameterName    -> FF1PA
    },
    FF1NA == {
        Particles        -> {Neutronbar, Neutron, A},
        ComplexParameter -> False,
        Value            -> "F1n(-P(-1,3)**2)",
        ParameterName    -> FF1NA
    },
    FF2PA == {
        Particles        -> {Protonbar, Proton, A},
        ComplexParameter -> False,
        Value            -> "F2p(-P(-1,3)**2)",
        ParameterName    -> FF2PA
    },
    FF2NA == {
        Particles        -> {Neutronbar, Neutron, A},
        ComplexParameter -> False,
        Value            -> "F2n(-P(-1,3)**2)",
        ParameterName    -> FF2NA
    }
  }, {}],

  (* ---------------------------- Delta(1232) form factors ------------------- *)
  (*  Only included when ChiPT$FormFactors is "Delta" or "All".                 *)
  (*                                                                            *)
  (*  WHAT FIG. 33 ACTUALLY PUTS ON THE DELTA (Fig33v2.m, Eqs. (44)-(47)):      *)
  (*    (a) ONE factor sqrt(X_pi(s,u)) per Delta diagram, X_pi(s,u) =           *)
  (*        X(s) + X(u) - X(s)X(u),  X(l) = 2 r^3/(1+r^5),  r = k(l)/k(M_D^2),  *)
  (*        k the pi-N cm momentum at invariant mass^2 = l, and X(l) = 0 below  *)
  (*        the pi-N threshold.  It sits on the STRONG vertex.                  *)
  (*    (b) an energy-dependent width Gamma(s,u) = Gamma_Delta X_pi(s,u) in     *)
  (*        BOTH Delta propagators.                                             *)
  (*    (c) NOTHING on the gamma-N-Delta vertex -- Fig. 33 is real-photon       *)
  (*        photoproduction, so any Q^2 dependence there is invisible to it.    *)
  (*                                                                            *)
  (*  WHAT SURVIVES THE TRANSLATION TO A UFO FORM FACTOR.  A UFO form factor is *)
  (*  a function of ONE vertex's own momenta, so X_pi(s,u) -- which mixes the   *)
  (*  Mandelstams of two different diagrams -- is not a vertex-level object.    *)
  (*  The vertex-level object is X_pi(p_Delta^2), the Delta leg's own invariant *)
  (*  mass squared.  The two agree exactly on the s-channel diagram, because    *)
  (*  X_pi(u) = 0 identically over the whole physical region of gamma N -> pi N *)
  (*  (u <= (M_N - m_pi)^2 < (M_N + m_pi)^2, checked numerically on the Fig. 33 *)
  (*  grid), so X_pi(s,u) = X_pi(s) there.  They differ on the u-channel Delta, *)
  (*  which Fig. 33 damps by sqrt(X_pi(s)) but a vertex form factor kills       *)
  (*  outright.  Measured on sigma_tot(Born+Delta), that costs                  *)
  (*      pi0 p : +2% at the peak, +11% at 0.6 GeV, +1% at 1.0 GeV             *)
  (*      pi+ n : +2%,  +17%,  +15%      pi- p : +1%,  +9%,  +12%              *)
  (*  against the ~3.2x error at 1 GeV that comes from having no Delta form     *)
  (*  factor at all.  Item (b), the running width, is NOT a form factor and     *)
  (*  cannot be routed through this mechanism at all; on its own it is a ~3%    *)
  (*  effect at the peak.  See the "scheme" scan in the session notes.          *)
  (*                                                                            *)
  (*  The generator supplies FpiNDelta(s) and the four FgNDelta*(Q^2).  To      *)
  (*  match Fig. 33 set FpiNDelta(s) = sqrt(X_pi(s)) and leave every            *)
  (*  FgNDelta* = 1: the gamma-N-Delta form factors are a genuinely new object  *)
  (*  (the N -> Delta electromagnetic transition form factors) that real-photon *)
  (*  photoproduction cannot see.  They are split G1/G2 and proton/neutron      *)
  (*  because those are four independent functions -- G1 multiplies the         *)
  (*  magnetic (dual field strength) term and G2 the electric one.              *)
  (*                                                                            *)
  (*  NB these MULTIPLY the fitted couplings G1 = 6.061 and G2 = 2.414, so a    *)
  (*  form factor normalised to 1 at Q^2 = 0 leaves the Fig. 33 comparison      *)
  (*  untouched.  Achilles (branch sherpa3-0, src/plugins/Sherpa/FormFactors.cc)*)
  (*  already registers FDeltaPG1 = Gep + Gmp, FDeltaPG2 = 2 Gep (M+MD)/(M-MD), *)
  (*  FDeltaNG1, FDeltaNG2 -- but those are REPLACEMENTS for the coupling, not  *)
  (*  multipliers: FDeltaPG1(0) = 1 + mu_p = 3.79, not 1.  Wiring the names     *)
  (*  here to those IDs would silently rescale the vertex by that factor, so    *)
  (*  new IDs are used instead; if you do want the Sachs parameterisation,      *)
  (*  rescale G1 and G2 in the param card to compensate.                        *)
  (*                                                                            *)
  (*  TWO SYMBOLS PER VERTEX TYPE, because the value is a raw Python string     *)
  (*  that FeynRules splices into the Lorentz structure verbatim -- the leg     *)
  (*  index in it is NEVER relabelled (RelabelFormFactorExt applies replacement *)
  (*  rules, which do nothing to a String).  So the index has to be written for *)
  (*  the ordering the UFO ends up with, and the UFO is all-OUTGOING, which     *)
  (*  reverses the naive reading of the Lagrangian:                             *)
  (*     Deltabar ... N  term  ->  vertices  N~ Delta X   : Delta at leg 2      *)
  (*     its h.c.              ->  vertices  Delta~ N X   : Delta at leg 1      *)
  (*  (structures FRS1/FRV1/FRVS1 and RFS1/RFV1/RFVS1 respectively).  Getting   *)
  (*  this backwards is silent -- it evaluates the form factor on the NUCLEON   *)
  (*  leg, whose p^2 is a fixed M_N^2 for an external nucleon.  The photon sits *)
  (*  at leg 3 in both orderings, so FFGNDA and FFGNDB share one string.        *)
  (*  Dummy index -9 keeps it clear of the -1..-4 already contracted inside the *)
  (*  Lorentz structures.                                                       *)
  If[ChiPT$DeltaFF,
  {
    FFPNDA == {
        Particles        -> {DeltaPbar, Proton, Pi0},
        ComplexParameter -> False,
        Value            -> "FpiNDelta(P(-9,2)**2)",
        ParameterName    -> FFPNDA
    },
    FFPNDB == {
        Particles        -> {Protonbar, DeltaP, Pi0},
        ComplexParameter -> False,
        Value            -> "FpiNDelta(P(-9,1)**2)",
        ParameterName    -> FFPNDB
    },
    FFDPG1A == {
        Particles        -> {Protonbar, DeltaP, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaPG1(-P(-9,3)**2)",
        ParameterName    -> FFDPG1A
    },
    FFDPG2A == {
        Particles        -> {Protonbar, DeltaP, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaPG2(-P(-9,3)**2)",
        ParameterName    -> FFDPG2A
    },
    FFDNG1A == {
        Particles        -> {Neutronbar, Delta0, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaNG1(-P(-9,3)**2)",
        ParameterName    -> FFDNG1A
    },
    FFDNG2A == {
        Particles        -> {Neutronbar, Delta0, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaNG2(-P(-9,3)**2)",
        ParameterName    -> FFDNG2A
    },
    FFDPG1B == {
        Particles        -> {DeltaPbar, Proton, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaPG1(-P(-9,3)**2)",
        ParameterName    -> FFDPG1B
    },
    FFDPG2B == {
        Particles        -> {DeltaPbar, Proton, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaPG2(-P(-9,3)**2)",
        ParameterName    -> FFDPG2B
    },
    FFDNG1B == {
        Particles        -> {Delta0bar, Neutron, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaNG1(-P(-9,3)**2)",
        ParameterName    -> FFDNG1B
    },
    FFDNG2B == {
        Particles        -> {Delta0bar, Neutron, A},
        ComplexParameter -> False,
        Value            -> "FgNDeltaNG2(-P(-9,3)**2)",
        ParameterName    -> FFDNG2B
    }
  }, {}]];


