    Indices          -> {Index[Generation], Index[Generation]},
    Definitions      -> {yl[i_?NumericQ, j_?NumericQ] :> 0  /; (i =!= j)},
    Value            -> {yl[1,1] -> Sqrt[2] yme / vev, yl[2,2] -> Sqrt[2] ymm / vev, yl[3,3] -> Sqrt[2] ymtau / vev},
    InteractionOrder -> {QED, 1},
    ParameterName    -> {yl[1,1] -> ye, yl[2,2] -> ym, yl[3,3] -> ytau},
    TeX              -> Superscript[y, l],
    Description      -> "Lepton Yukawa couplings"
  },
(* N. B. : only Cabibbo mixing! *)
  CKM == {
    ParameterType -> Internal,
    Indices       -> {Index[Generation], Index[Generation]},
    Unitary       -> True,
    Value         -> {CKM[1,1] -> Cos[cabi],  CKM[1,2] -> Sin[cabi], CKM[1,3] -> 0,
                      CKM[2,1] -> -Sin[cabi], CKM[2,2] -> Cos[cabi], CKM[2,3] -> 0,
                      CKM[3,1] -> 0,          CKM[3,2] -> 0,         CKM[3,3] -> 1},
    TeX         -> Superscript[V,CKM],
    Description -> "CKM-Matrix"
  }
};


(* ****************************************************************************** *)
(* *****            Chiral building blocks  (single convention)             ***** *)
(* ****************************************************************************** *)
(*                                                                                *)
(*  Convention, used EVERYWHERE below:                                            *)
(*        U -> R U L^+ ,      u = U^(1/2) -> R u h^+ = h u L^+                    *)
(*        D_mu U   = d_mu U - i r_mu U + i U l_mu                                 *)
(*        Gamma_mu = 1/2 [ u^+(d_mu - i r_mu) u + u (d_mu - i l_mu) u^+ ]         *)
(*        u_mu     = i   [ u^+(d_mu - i r_mu) u - u (d_mu - i l_mu) u^+ ]         *)
(*  with l_mu = LMat[mu], r_mu = RMat[mu].                                        *)
(*                                                                                *)
(*  See header note 3: the previous version mixed three different pairings of     *)
(*  l and r, which agree only for purely electromagnetic sources.                 *)
(* ****************************************************************************** *)

(* Only include up to O(p^4) terms *)
fPiOrder = 2;

getRidOfhigherOrderTerm[expression_] := Normal[Series[expression, {fPi, Infinity, fPiOrder}]];

UU := MatrixExp[ExpandIndices[Sum[I (PauliSigma[ii] Pion[ii])/fPi, {ii, 1, 3}]]];
uu := MatrixPower[UU, 1/2];

UMat := Simplify[Normal[Series[UU, {fPi, Infinity, fPiOrder}]]];
umat := Simplify[Normal[Series[uu, {fPi, Infinity, fPiOrder}]]];

(* External left/right sources.  l_mu = r_mu = e Q A_mu with Q = (1 + tau3)/2:
   the isovector part gives the pion charges through the commutator, the full Q
   gives the proton/neutron charges through Gamma_mu.  Defined ONCE (header
   note 4). *)
LMat[mu_] := Module[{ii}, g2/2 ExpandIndices[Sum[PauliMatrix[ii] Wi[mu, ii], {ii, 1, 3}]] + g1/2 ExpandIndices[B[mu] * IdentityMatrix[2]]];
RMat[mu_] := Module[{ii}, g1/2 ExpandIndices[PauliMatrix[3]*B[mu]] + g1/2 ExpandIndices[IdentityMatrix[2] * B[mu]]];

(* D_mu U = d_mu U - i r_mu U + i U l_mu.  This is the form consistent with
   ChiConnect / ChiVielbein below; myPions.fr had the l <-> r swapped version
   active and this one commented out. *)
DelU[mu_] := ExpandIndices[del[UMat, mu] - I RMat[mu].UMat + I UMat.LMat[mu]];

ChiMat := {{MPi^2, 0}, {0, MPi^2}};
MassU := ExpandIndices[ChiMat.HC[UMat] + UMat.HC[ChiMat]];

ChiCommutator[mat_, mu_, nu_] := Module[{}, ExpandIndices[mat[mu].mat[nu] - mat[nu].mat[mu]]];
FSMat[mat_, mu_, nu_]      := Module[{}, ExpandIndices[del[mat[nu], mu] - del[mat[mu], nu] - I ChiCommutator[mat, mu, nu]]];

(* Chiral connection Gamma_mu and vielbein u_mu, used by the Delta sector. *)
(* NOTE: getRidOfhigherOrderTerm (= Series in 1/fPi) must NOT be applied to the
   MATRIX here.  At that stage the expression still contains unevaluated HC and
   del heads, and Series differentiates them as if they were ordinary functions
   of fPi, leaving Derivative[1][HC][0] and Derivative[1,0][del][0,...] factors
   all over the Delta sector -- they were present in every pi-N-Delta vertex of
   the myPions UFO.  Expanding first and truncating only after the isospin trace
   (in ChiConnectV / ChiVielbeinV / ChiVielbein2 below) is clean and gives the
   expected leading term u_mu ~ -d_mu pi / fPi. *)
ChiConnect[mu_]  := ChiConnect[mu] = ExpandIndices[(1/2)*(HC[umat] . (del[umat, mu] - I*RMat[mu] . umat) + umat . (del[HC[umat], mu] - I*LMat[mu] . HC[umat]))];
ChiVielbein[mu_] := ChiVielbein[mu] = ExpandIndices[I*(HC[umat] . (del[umat, mu] - I*RMat[mu] . umat) - umat . (del[HC[umat], mu] - I*LMat[mu] . HC[umat]))];

(* Building blocks for the nucleon currents.  These are kept SEPARATE from
   ChiConnect / ChiVielbein on purpose -- see the note above LNNVector. *)
aVec[mu_]      := aVec[mu] = (I/2)*(HC[umat] . del[umat, mu] - umat . del[HC[umat], mu]);
vVec[mu_]      := vVec[mu] = (I/2)*(HC[umat] . del[umat, mu] + umat . del[HC[umat], mu]);
LMatTilda[mu_] := LMatTilda[mu] = Expand[HC[umat] . LMat[mu] . umat];
RMatTilda[mu_] := RMatTilda[mu] = Expand[umat . RMat[mu] . HC[umat]];

ChiConnectV[mu_, l_]        := ChiConnectV[mu, l] = getRidOfhigherOrderTerm[(1/2)*Tr[ChiConnect[mu] . PauliMatrix[l]]];
ChiVielbein2[mu_, r1_, r2_] := ChiVielbein2[mu, r1, r2] = getRidOfhigherOrderTerm[ChiVielbein[mu][[r1, r2]]];
ChiVielbeinV[mu_, l_]       := ChiVielbeinV[mu, l] = getRidOfhigherOrderTerm[(1/2)*Tr[PauliSigma[l] . ChiVielbein[mu]]];

(* ****************************************************************************** *)
(*  CACHE CONTROL -- ChiPTClearCache[] MUST be called right after LoadModel.      *)
(*                                                                                *)
(*  The helper functions above are memoised (f[x_] := f[x] = body) because they    *)
(*  are re-evaluated hundreds of times while the Lagrangian is built, and without  *)
(*  caching a WriteUFO run takes tens of minutes.                                  *)
(*                                                                                 *)
(*  BUT: FeynRules' LoadModel evaluates some of them WHILE the model is still      *)
(*  being set up, at a point where HC[umat] and del[umat,mu] cannot yet resolve.   *)
(*  getRidOfhigherOrderTerm (= Series in 1/fPi) then differentiates the surviving  *)
(*  HC and del heads as ordinary functions of fPi and produces Derivative[1][HC][0]*)
(*  and Derivative[1,0][del][0,...] junk -- which the memoisation then freezes     *)
(*  FOREVER.  Measured straight after LoadModel: ChiVielbein2 already held 12      *)
(*  cached entries containing 834 such junk terms, and every pi-N-Delta vertex in  *)
(*  the resulting UFO was contaminated.                                           *)
(*                                                                                 *)
(*  ChiPTClearCache[] drops the specific memo entries and keeps the generic        *)
(*  pattern rules, so everything is recomputed correctly on first use after the    *)
(*  model is fully loaded -- and cached correctly from then on.                    *)
(*                                                                                 *)
(*      LoadModel["ChiPT.fr"];                                                     *)
(*      ChiPTClearCache[];              (* <-- do not skip *)                      *)
(*      WriteUFO[LTotal, AddDecays -> False, FlavorExpand -> True];                *)
(* ****************************************************************************** *)

SetAttributes[ChiPTPurge, HoldAll];
ChiPTPurge[s_Symbol] := DownValues[s] =
   Select[DownValues[s], !FreeQ[First[#], Pattern] &];

ChiPTClearCache[] := (
  ChiPTPurge[ChiConnect];   ChiPTPurge[ChiVielbein];  ChiPTPurge[ChiVielbein2];
  ChiPTPurge[ChiConnectV];  ChiPTPurge[ChiVielbeinV];
  ChiPTPurge[aVec];         ChiPTPurge[vVec];
  ChiPTPurge[LMatTilda];    ChiPTPurge[RMatTilda];
  "ChiPT: load-time caches purged");

(* Electromagnetic field strength.  F_{mu nu} = d_mu A_nu - d_nu A_mu.  In
   FeynRules del[A[mu],nu] means d_nu A_mu, hence the index order below; this
   agrees with FeynRules' own FS[A,mu,nu].

   myPions.fr had the two terms the other way round, i.e. -F_{mu nu}.  That was
   argued to compensate for this model's photon having the opposite sign to the
   standard one (LNNVector gives Vertex(p~ p A) = +I ee Ga[mu], against the
   standard -I ee Ga[mu]).  Comparing the exported UFO against ELA_UFO shows the
   compensation does NOT happen: relative to ELA the gamma-p-p, gamma-pi-pi and
   Kroll-Ruderman vertices all flip sign, while gamma-N-Delta does not.  The
   Delta therefore interfered with the Born terms the wrong way round -- the
   Born/Delta ratio-of-ratios came out -1.02, a genuine relative sign rather
   than an overall phase.  With the standard F below it is +1.02, matching the
   validated ELA model. *)
EMStrengthTensor[mu_, nu_]     := del[A[nu], mu] - del[A[mu], nu];
DualEMStrengthTensor[mu_, nu_] := Block[{ro, si}, (1/2)*Eps[mu, nu, ro, si]*EMStrengthTensor[ro, si]];

(* Nucleon isodoublet as a plain list, and the covariant derivative acting on the
   isospinor-isovector Delta field. *)
Nucleons[s_]    := {Proton[s], Neutron[s]};
Nucleonsbar[s_] := {Protonbar[s], Neutronbar[s]};

Sigma[mu_, nu_, s1_, s2_] := Block[{s3}, (I/2)*(Ga[mu, s1, s3] . Ga[nu, s3, s2] - Ga[nu, s1, s3] . Ga[mu, s3, s2])];

DeltaConnection[ro_, r1_, r2_, i1_, i2_] :=
  Block[{k}, Sum[-2*I*Eps[i1, i2, k]*ChiConnectV[ro, k]*IndexDelta[r1, r2], {k, 1, 3}]
             + IndexDelta[i1, i2]*ChiConnect[ro][[r1, r2]]];

DeltaCovariantDerivative[ro_, r1_, r2_, i1_, i2_, psi_] :=
  IndexDelta[i1, i2]*IndexDelta[r1, r2]*del[psi, ro] + DeltaConnection[ro, r1, r2, i1, i2]*psi;

$Assumptions = {cw^2 + sw^2 == 1, gD > 0, g1D > 0};


(* ****************************************************************************** *)
(* *****                          Lagrangian                                ***** *)
(* ****************************************************************************** *)

(* ---------------------------------------------------------------- SM sector -- *)

LGauge := Block[{mu,nu},
  -1/(2 g2^2) Tr[FSMat[WMat, mu, nu].FSMat[WMat, mu, nu]]
  -1/(2 g1^2) Tr[FSMat[BMat, mu, nu].FSMat[BMat, mu, nu]]];

LFermions := Block[{mu},
  ExpandIndices[I*(
    LLbar.Ga[mu].DC[LL, mu] + lRbar.Ga[mu].DC[lR, mu]),
  FlavorExpand->{SU2W,SU2D}]];

LHiggs := Block[{ii,mu, feynmangaugerules},
  feynmangaugerules = If[Not[FeynmanGauge], {G0|GP|GPbar ->0}, {}];

  ExpandIndices[DC[Phibar[ii],mu] DC[Phi[ii],mu] + muH^2 Phibar[ii] Phi[ii] - lam Phibar[ii] Phi[ii] Phibar[jj] Phi[jj], FlavorExpand->{SU2D,SU2W}]/.feynmangaugerules
 ];

LYukawa := Block[{sp,ii,jj,cc,ff1,ff2,ff3,yuk,feynmangaugerules},
  feynmangaugerules = If[Not[FeynmanGauge], {G0|GP|GPbar ->0}, {}];

  yuk = ExpandIndices[
    -yl[ff1, ff3] LLbar[sp, ii, ff1].lR [sp, ff3] Phi[ii], FlavorExpand -> SU2D];
  yuk+HC[yuk]/.feynmangaugerules
 ];

LGhost := Block[{LGh1,LGhw,LGhs,LGhphi,mu, generators,gh,ghbar,Vectorize,phi1,phi2,togoldstones,doublet,doublet0},
  (* Pure gauge piece *)
  LGh1 = -ghBbar.del[DC[ghB,mu],mu];
  LGhw = -ghWibar[ii].del[DC[ghWi[ii],mu],mu];

  (* Scalar pieces: see Peskin pages 739-742 *)
  gh    = {ghB, ghWi[1], ghWi[2], ghWi[3]};
  ghbar = {ghBbar, ghWibar[1], ghWibar[2], ghWibar[3]};
  generators = {-I/2 g1 IdentityMatrix[2], -I/2 g2 PauliSigma[1], -I/2 g2 PauliSigma[2], -I/2 g2 PauliSigma[3]};
  doublet = Expand[{(-I phi1 - phi2)/Sqrt[2], Phi[2]} /. MR$Definitions /. vev -> 0];
  doublet0 = {0, vev/Sqrt[2]};
  Vectorize[{a_, b_}]:= Simplify[{Sqrt[2] Re[Expand[a]], Sqrt[2] Im[Expand[a]], Sqrt[2] Re[Expand[b]], Sqrt[2] Im[Expand[b]]}/.{Im[_]->0, Re[num_]->num}];
  togoldstones := {phi1 -> (GP + GPbar)/Sqrt[2], phi2 -> (-GP + GPbar)/(I Sqrt[2])};
  LGhphi=Plus@@Flatten[Table[-ghbar[[kkk]].gh[[lll]] Vectorize[generators[[kkk]].doublet0].Vectorize[generators[[lll]].(doublet+doublet0)],{kkk,4},{lll,4}]] /.togoldstones;

ExpandIndices[ If[FeynmanGauge, LGh1 + LGhw + LGhphi,0], FlavorExpand->SU2W]];

LSM := LGauge + LFermions + LHiggs + LYukawa + LGhost;


(* ------------------------------------------------------------- pion sector -- *)
(*  L = (fPi^2/4) Tr[ D_mu U (D^mu U)^+ + chi U^+ + U chi^+ ]                     *)

LPionKin := Normal[Series[
   Block[{mu}, ExpandIndices[(1/4)*fPi^2*Tr[DelU[mu] . HC[DelU[mu]] + MassU]]],
   {fPi, Infinity, fPiOrder}]];


(* ---------------------------------------------------------- nucleon sector -- *)
(*  L = Nbar ( i gamma^mu d_mu - M ) N                           LNucleonKin     *)
(*    + Nbar gamma^mu ( vVec + (L~ + R~)/2 ) N                   LNNVector       *)
(*    - ga Nbar gamma^mu ( aVec + (L~ - R~)/2 ) gamma5 N         LNNAxial        *)
(*                                                                               *)
(*  DO NOT rewrite these in terms of ChiConnect / ChiVielbein.  Algebraically     *)
(*      I ChiConnect[mu]     == vVec[mu] + (u^+ r u + u l u^+)/2                  *)
(*      ChiVielbein[mu]/2    == aVec[mu] + (u^+ r u - u l u^+)/2                  *)
(*  but ChiConnect / ChiVielbein are wrapped in getRidOfhigherOrderTerm, i.e.     *)
(*  Series[..., {fPi, Infinity, 2}], and Series differentiates the still-         *)
(*  unevaluated HC and del heads as if they were ordinary functions of fPi.       *)
(*  The result is contaminated with Derivative[1][HC][0] and                      *)
(*  Derivative[1,0][del][0,...] terms.  Substituting them here was checked        *)
(*  against the forms below and gives pion-nucleon couplings a factor 2 too       *)
(*  small (ga/(4 fPi) instead of ga/(2 fPi)) plus spurious parity-violating       *)
(*  pi-N-N vertices with no gamma5.  aVec / vVec / LMatTilda / RMatTilda are      *)
(*  plain (unSeries'd) definitions and do not suffer from this.                   *)
(*                                                                                *)
(*  OPEN ISSUE (deliberately NOT changed -- see header).  LMatTilda = u^+ l u and *)
(*  RMatTilda = u r u^+ pair l with u^+ and r with u, whereas ChiConnect /        *)
(*  ChiVielbein (and hence the whole Delta sector) use the opposite pairing.      *)
(*  For electromagnetism l = r and the two agree exactly, so gamma p -> pi0 p is  *)
(*  unaffected; they differ for W couplings, which live in LMat only.  Making     *)
(*  them agree is the two-line change                                            *)
(*      LMatTilda[mu_] = Expand[HC[umat] . RMat[mu] . umat];                      *)
(*      RMatTilda[mu_] = Expand[umat . LMat[mu] . HC[umat]];                      *)
(*  which flips the sign of the W and Z axial couplings.  Which sign is correct   *)
(*  has not been established here, so the original pairing is retained.           *)

LNucleonKin := I*Block[{mu, s1, s2},
     Inner[Dot, Nucleonsbar[s1],
       Inner[Dot, Ga[mu, s1, s2]*IdentityMatrix[2], del[Nucleons[s2], mu]]]]
   - MNucleon*Block[{s1}, Inner[Dot, Nucleonsbar[s1], Nucleons[s1]]];

LNNVector := Block[{mu, s1, s2}, Normal[Series[
   Inner[Dot, Nucleonsbar[s1],
     Inner[Dot, Ga[mu, s1, s2]*IdentityMatrix[2],
       Inner[Dot, vVec[mu] + (1/2)*(LMatTilda[mu] + RMatTilda[mu]), Nucleons[s2]]]],
   {fPi, Infinity, fPiOrder}]]];

LNNAxial := Block[{mu, s1, s2, s3}, Normal[Series[
   (-ga)*Inner[Dot, Nucleonsbar[s1],
     Inner[Dot, Ga[mu, s1, s2]*IdentityMatrix[2],
       Inner[Dot, aVec[mu] + (1/2)*(LMatTilda[mu] - RMatTilda[mu]),
         Inner[Dot, Ga[5, s2, s3]*IdentityMatrix[2], Nucleons[s3]]]]],
   {fPi, Infinity, fPiOrder}]]];


(* ------------------------------ nucleon electromagnetic form factors --------- *)
(*  Only included when ChiPT$FormFactors is "Nucleon" or "All".                   *)
(*                                                                                *)
(*  Dirac part: LNNVector already gives the point-like proton coupling            *)
(*      + ee A^mu pbar gamma_mu p     ->   Vertex(p~ p A) = +I ee Ga[mu]          *)
(*  so the proton term below carries (FF1PA - 1): the -1 cancels that point-like  *)
(*  piece in the coupling, leaving the single structure F1p*Gamma in the UFO.     *)
(*  The neutron has no point-like coupling, so FF1NA enters directly.             *)
(*                                                                                *)
(*  Pauli part.  Eq. (14) of nucl-th/0509020v2, -(I e/4M) F2 Nbar gamma_{mu nu} N *)
(*  F^{mu nu}, gives the vertex  +I (e/4M) F2 (gamma^mu qslash - qslash gamma^mu) *)
(*  -- which is what Fig33v2.m uses (c2p), and Fig33v2.m is validated against     *)
(*  Appendix A to 1e-16.  This model's Dirac coupling is +I ee Ga[mu], i.e. minus *)
(*  the paper's, so the Pauli term must be minus the paper's too, hence the       *)
(*  leading - sign below.  Verified in the exported UFO: the gamma-N-N coupling    *)
(*  comes out -(ee FF2PA)/(2 MNucleon) on P(-1,3)*Sigma(3,-1,2,1).                *)
(*                                                                                *)
(*  NB ELA_UFO's own Pauli coupling has the OPPOSITE sign to Fig33v2.m (-0.14433i *)
(*  vs +0.14433i on the same structure) even though ELA.fr transcribes Eq. (14)   *)
(*  faithfully.  That discrepancy is unresolved and is NOT reproduced here: this   *)
(*  file follows the paper.                                                        *)
LNNEMFF := Block[{mu, nu, s1, s2},
    ee*((FF1PA - 1)*A[mu]*Protonbar[s1] . Ga[mu, s1, s2] . Proton[s2]
      + FF1NA*A[mu]*Neutronbar[s1] . Ga[mu, s1, s2] . Neutron[s2])
  + (ee/(4*MNucleon))*FS[A, mu, nu]*
      (FF2PA*Protonbar[s1] . Sig[mu, nu, s1, s2] . Proton[s2]
     + FF2NA*Neutronbar[s1] . Sig[mu, nu, s1, s2] . Neutron[s2])];


(* ------------------------------------------------- Delta(1232) self sector -- *)
(*  Rarita-Schwinger kinetic and mass terms with the off-shell parameter AD,     *)
(*  chirally covariantised (DeltaCovariantDerivative), plus the three            *)
(*  pi-Delta-Delta couplings g1D, g2D, g3D.                                      *)

LDeltaKin1 := -Block[{mu1, mu2, s1, s2, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*ME[mu1, mu2]*
        (I*Ga[ro, s1, s2]*DeltaCovariantDerivative[ro, r1, r2, i1, i2, #1]
         - IndexDelta[s1, s2]*IndexDelta[r1, r2]*IndexDelta[i1, i2]*MDelta*#1) &)[
      Delta[s2, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaKin2 := -Block[{mu1, mu2, s1, s2, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*I*AD*
        (Ga[mu1, s1, s2]*DeltaCovariantDerivative[mu2, r1, r2, i1, i2, #1]
         + Ga[mu2, s1, s2]*DeltaCovariantDerivative[mu1, r1, r2, i1, i2, #1]) &)[
      Delta[s2, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaKin3 := -Block[{mu1, mu2, s1, s2, s3, s4, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*(I/2)*(3*AD^2 + 2*AD + 1)*
        (Ga[mu1, s1, s2]*Ga[ro, s2, s3]*Ga[mu2, s3, s4]*
          DeltaCovariantDerivative[ro, r1, r2, i1, i2, #1]) &)[
      Delta[s4, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaKin4 := -Block[{mu1, mu2, s1, s2, s3, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*MDelta*(3*AD^2 + 3*AD + 1)*
        (Ga[mu1, s1, s2]*Ga[mu2, s2, s3]*#1) &)[
      Delta[s3, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaPi1 := (-(g1D/2))*Block[{mu1, mu2, s1, s2, s3, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*
        (Ga[ro, s1, s2]*IndexDelta[i1, i2]*ChiVielbein2[ro, r1, r2]*
          Ga[5, s2, s3]*ME[mu1, mu2]*#1) &)[
      Delta[s3, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaPi2 := (-(g2D/2))*Block[{mu1, mu2, s1, s2, s3, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*
        (Ga[mu1, s1, s2]*Ga[5, s2, s3]*IndexDelta[i1, i2]*ChiVielbein2[mu2, r1, r2]*#1
         + Ga[mu2, s1, s2]*Ga[5, s2, s3]*IndexDelta[i1, i2]*ChiVielbein2[mu1, r1, r2]*#1) &)[
      Delta[s3, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaPi3 := (-(g3D/2))*Block[{mu1, mu2, s1, s2, s3, s4, s5, i1, i2, ro},
  Sum[(Deltabar[s1, mu1, r1, i1]*
        (Ga[mu1, s1, s2]*Ga[ro, s2, s3]*Ga[5, s3, s4]*Ga[mu2, s4, s5]*
          IndexDelta[i1, i2]*ChiVielbein2[ro, r1, r2]*#1) &)[
      Delta[s5, mu2, r2, i2]], {r1, 1, 2}, {r2, 1, 2}]];

LDeltaSector := LDeltaKin1 + LDeltaKin2 + LDeltaKin3 + LDeltaKin4
             + LDeltaPi1 + LDeltaPi2 + LDeltaPi3;


(* ------------------------------------------- pi N Delta, conventional form -- *)

LPiNDelta := gD*Block[{mu1, mu2, s1, s2, s3, i1, ro},
  Sum[Deltabar[s1, mu1, r1, i1]*
      (ME[mu1, mu2]*IndexDelta[s1, s3] + ztilde*Ga[mu1, s1, s2]*Ga[mu2, s2, s3])*
      ChiVielbeinV[mu2, i1]*Nucleons[s3][[r1]], {r1, 1, 2}, {i1, 1, 3}]
  + HC[Sum[Deltabar[s1, mu1, r1, i1]*
      (ME[mu1, mu2]*IndexDelta[s1, s3] + ztilde*Ga[mu1, s1, s2]*Ga[mu2, s2, s3])*
      ChiVielbeinV[mu2, i1]*Nucleons[s3][[r1]], {r1, 1, 2}, {i1, 1, 3}]]];


(* ------------------------------ pi N Delta, gauge-invariant (Pascalutsa) ----- *)
(*  Corresponds to the strong term of Fernandez-Ramirez et al. Eq. (36),         *)
(*     -(h / (fPi Mstar)) Nbar eps_{mu nu lam beta} gamma^beta gamma5            *)
(*                          (d^mu Delta^nu_j)(d^lam pi_j)                        *)
(*  with ChiVielbeinV[lam, j] = -(1/fPi) d^lam pi_j at leading order.            *)
(*  SIGN NOT YET CROSS-CHECKED against that paper -- see header.                 *)

LPiNDeltaGI := (-(hD/MDelta))*Block[{mu, nu, lam, si, s1, s2, s3},
  Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinV[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]
  + HC[Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinV[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]]];


(* ---------------------------------- gamma N Delta, gauge-invariant coupling -- *)
(*  Kappa Nbar [ i G1 Ftilde_{mu nu} + G2 gamma5 F_{mu nu} ] d^mu Delta^nu_3     *)
(*  + HC,  Kappa = 3e / (2 M (M + Mstar)) -- Eq. (36) of nucl-th/0509020v2.      *)
(*  Delta[..., 3] carries the sqrt(2/3) isospin factor automatically through the *)
(*  R[5] definitions, so no explicit Clebsch-Gordan factor belongs here.  (The   *)
(*  hand-written notebook Delta-Analytic-Calculations/"gamma+p into pi0 p        *)
(*  photoproduction.nb" DROPS that sqrt(2/3) on this vertex while keeping it on  *)
(*  the strong one, which is why it overshoots by a factor 3/2 in the cross      *)
(*  section.)                                                                    *)

LGammaNDelta := Kappa*Block[{s1, s2, mu, nu},
  Sum[Nucleonsbar[s1][[r1]]*
      (I*G1*IndexDelta[s1, s2]*DualEMStrengthTensor[mu, nu]
       + G2*Ga[5, s1, s2]*EMStrengthTensor[mu, nu])*del[Delta[s2, nu, r1, 3], mu],
    {r1, 1, 2}]
  + HC[Sum[Nucleonsbar[s1][[r1]]*
      (I*HC[G1]*IndexDelta[s1, s2]*DualEMStrengthTensor[mu, nu]
       + HC[G2]*Ga[5, s1, s2]*EMStrengthTensor[mu, nu])*del[Delta[s2, nu, r1, 3], mu],
    {r1, 1, 2}]]];


(* ------------------------------- Delta vertices with form factors ----------- *)
(*  Same Lagrangians as LPiNDeltaGI / LGammaNDelta, with one form factor symbol *)
(*  multiplying each of the two hermitian-conjugate halves.  They REPLACE the   *)
(*  point-like versions in LChiPT when ChiPT$DeltaFF is True -- they are not    *)
(*  additive corrections like LNNEMFF.                                          *)
(*                                                                              *)
(*  FFPNDA/FFPNDB land on every vertex the gauged strong term produces, i.e. on *)
(*  the three-point pi-N-Delta vertices AND on the contact vertices that share  *)
(*  its coupling: Delta~ N A pi (the Delta-sector Kroll-Ruderman term) and the  *)
(*  W/Z ones, including the three-point weak N -> Delta transition currents     *)
(*  that come from the gauge part of ChiVielbeinV.  That is deliberate: they    *)
(*  all carry the same strong vertex and the same Delta leg, whose momentum     *)
(*  squared is what FpiNDelta is a function of, and splitting the pion piece    *)
(*  off the gauge pieces of the vielbein would break gauge invariance.  If the  *)
(*  weak transition current is meant to carry its own (axial) form factor       *)
(*  instead, it needs its own Lagrangian term, not this one.                    *)
(*                                                                              *)
(*  FeynRules will warn "Form factor FFPNDA appears in more than one vertex"    *)
(*  and print the list.  That is expected and harmless HERE: the warning        *)
(*  guards a momentum-relabelling step that only acts on symbolic values, and   *)
(*  these values are strings, which the relabeller cannot touch.  What it does  *)
(*  mean is that the leg index in the string has to be right in EVERY vertex    *)
(*  the symbol reaches -- verified in the exported UFO, see the checks in       *)
(*  export_ChiPT_UFO.m.                                                         *)

LPiNDeltaGIFF := (-(hD/MDelta))*Block[{mu, nu, lam, si, s1, s2, s3},
  FFPNDA*Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinV[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]
  + FFPNDB*HC[Sum[Eps[mu, nu, lam, si]*del[Deltabar[s1, nu, r1, i1], mu]*
      Ga[si, s1, s2]*Ga[5, s2, s3]*ChiVielbeinV[lam, i1]*Nucleons[s3][[r1]],
    {r1, 1, 2}, {i1, 1, 3}]]];

(*  The r1 sum runs over {Proton, Neutron}, so {FFDPxxA, FFDNxxA}[[r1]] hands   *)
(*  each charge state its own symbol; G1 and G2 are separated the same way.     *)
(*  The B symbols stay OUTSIDE HC[] so that no Conjugate[] can ever be wrapped  *)
(*  round a form factor -- HC[G1]/HC[G2] inside are kept exactly as in          *)
(*  LGammaNDelta so the two Lagrangians differ by nothing but the symbols.      *)
LGammaNDeltaFF := Kappa*Block[{s1, s2, mu, nu},
  Sum[{FFDPG1A, FFDNG1A}[[r1]]*Nucleonsbar[s1][[r1]]*
      I*G1*IndexDelta[s1, s2]*DualEMStrengthTensor[mu, nu]*
      del[Delta[s2, nu, r1, 3], mu], {r1, 1, 2}]
  + Sum[{FFDPG2A, FFDNG2A}[[r1]]*Nucleonsbar[s1][[r1]]*
      G2*Ga[5, s1, s2]*EMStrengthTensor[mu, nu]*
      del[Delta[s2, nu, r1, 3], mu], {r1, 1, 2}]
  + Sum[{FFDPG1B, FFDNG1B}[[r1]]*HC[Nucleonsbar[s1][[r1]]*
      I*HC[G1]*IndexDelta[s1, s2]*DualEMStrengthTensor[mu, nu]*
      del[Delta[s2, nu, r1, 3], mu]], {r1, 1, 2}]
  + Sum[{FFDPG2B, FFDNG2B}[[r1]]*HC[Nucleonsbar[s1][[r1]]*
      HC[G2]*Ga[5, s1, s2]*EMStrengthTensor[mu, nu]*
      del[Delta[s2, nu, r1, 3], mu]], {r1, 1, 2}]];


(* ------------------------------------------------------------ totals -------- *)

(*  IMPORTANT -- each piece is forced to an explicit expression BEFORE summing.    *)
(*  Writing this as the bare sum of the eight delayed symbols,                     *)
(*      LChiPT := LPionKin + LNucleonKin + ... + LGammaNDelta;                     *)
(*  silently destroys the whole Delta sector: FeynmanRules then returns 17         *)
(*  vertices, NONE of them containing a Delta, where the sequential form below     *)
(*  gives 58 vertices of which 41 contain a Delta.  Every partial sum (any pair,   *)
(*  any subset tried) behaves correctly, so this only bites on the full sum.       *)
(*  export_UFO_myPions.nb never hit it because it assigned each Lagrangian to a    *)
(*  variable first and summed the variables -- which is what is reproduced here.   *)
LChiPT := Module[{lpk, lnk, lnv, lna, lds, lpg, lgd, lff},
  lpk = LPionKin;     lnk = LNucleonKin;  lnv = LNNVector;   lna = LNNAxial;
  lds = LDeltaSector;
  lpg = If[ChiPT$DeltaFF, LPiNDeltaGIFF,  LPiNDeltaGI];
  lgd = If[ChiPT$DeltaFF, LGammaNDeltaFF, LGammaNDelta];
  lff = If[ChiPT$NucleonFF, LNNEMFF, 0];
  (* LPiNDelta (the conventional gD coupling) is deliberately EXCLUDED: it is
     not gauge invariant, and the Pascalutsa coupling LPiNDeltaGI replaces it.
     Its definition is kept above for reference only. *)
  lpk + lnk + lnv + lna + lds + lpg + lgd + lff];

LTotal := Module[{lchi, lsm}, lchi = LChiPT; lsm = LSM; lchi + lsm];

(* Kept for backwards compatibility with export_UFO_myPions.nb *)
LSMnu := LSM + LPionKin;

Rarita\[CapitalDelta]\[Pi]     := LDeltaSector;
Rarita\[Pi]N\[CapitalDelta]    := LPiNDelta;
Rarita\[Pi]N\[CapitalDelta]GI  := LPiNDeltaGI;
Rarita\[Gamma]N\[CapitalDelta] := LGammaNDelta;

(* Export with:
     LoadModel["ChiPT.fr"];
     WriteUFO[LTotal, AddDecays -> False, FlavorExpand -> True];
*)
